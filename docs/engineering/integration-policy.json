  "commands": [
    {
      "id": "runner-dependencies",
      "argv": ["pnpm", "--dir", "{runner}", "install", "--frozen-lockfile", "--ignore-scripts"],
      "cwd": "runner"
    },
    {
      "id": "runner-python",
      "argv": ["uv", "sync", "--project", "{runner}", "--locked"],
      "cwd": "runner"
    },
    {
      "id": "runner-build",
      "argv": [
        "pnpm",
        "--dir",
        "{runner}",
        "--filter",
        "@omne-harness/repo-toolchain...",
        "run",
        "build"
      ],
      "cwd": "runner"
    },
    {
      "id": "subject-dependencies",
      "argv": ["pnpm", "--dir", "{subject}", "install", "--frozen-lockfile", "--ignore-scripts"],
      "cwd": "subject"
    },
    {
      "id": "check",
      "argv": ["bash", "{runner}/scripts/check.sh"],
      "cwd": "runner"
    },
    {
      "id": "runner-agents",
      "argv": [
        "uv",
        "run",
        "--project",
        "{runner}",
        "--locked",
        "python",
        "{runner}/.meta_harness/tooling/src/compile_agents.py",
        "--source",
        "{runner}/.meta_harness/agents",
        "--output",
        "{runner}/.meta_harness"
      ],
      "cwd": "runner"
    },
    {
      "id": "runner-agent-links",
      "argv": [
        "uv",
        "run",
        "--project",
        "{runner}",
        "--locked",
        "python",
        "{runner}/.meta_harness/tooling/src/link_agents.py",
        "--project-root",
        "{runner}"
      ],
      "cwd": "runner"
    },
    {
      "id": "subject-agents",
      "argv": [
        "uv",
        "run",
        "--project",
        "{runner}",
        "--locked",
        "python",
        "{runner}/.meta_harness/tooling/src/compile_agents.py",
        "--source",
        "{subject}/.meta_harness/agents",
        "--output",
        "{subject}/.meta_harness"
      ],
      "cwd": "subject"
    },
    {
      "id": "subject-agent-links",
      "argv": [
        "uv",
        "run",
        "--project",
        "{runner}",
        "--locked",
        "python",
        "{runner}/.meta_harness/tooling/src/link_agents.py",
        "--project-root",
        "{subject}"
      ],
      "cwd": "subject"
    },
    {
      "id": "startup",
      "argv": [
        "node",
        "--experimental-strip-types",
        "{runner}/tools/repo-toolchain/src/integration/cli.ts",
        "baselines",
        "--root",
        "{subject}"
      ],
      "cwd": "runner"
    },
    {
      "id": "migration-tests",
      "argv": [
        "env",
        "-u",
        "OMNE_INTEGRATION_BOOTSTRAP_CHECK",
        "-u",
        "OMNE_SUBJECT_ROOT",
        "-u",
        "OMNE_RUNNER_ROOT",
        "pnpm",
        "--dir",
        "{runner}/tools/repo-toolchain",
        "exec",
        "vitest",
        "run",
        "tests/integration-context.spec.ts",
        "tests/integration-engine.spec.ts",
        "tests/integration-transport.spec.ts",
        "tests/integration-boundaries.spec.ts",
        "tests/package-domain-template.spec.ts",
        "tests/package-template-cli.spec.ts"
      ],
      "cwd": "runner"
    },
    {
      "id": "context-main-path",
      "argv": [
        "uv",
        "run",
        "--project",
        "{runner}",
        "--locked",
        "omne-documentation",
        "context",
        "--root",
        "{subject}",
        "--role",
        "developer"
      ],
      "cwd": "runner"
    }
  ],
  "profiles": {
    "integration": [
      "runner-dependencies",
