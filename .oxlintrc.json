{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "**/tmp/",
    "**/.worktrees/",
    "**/generated/",
    "**/upstream/",
    "**/*.legacy/"
  ]
}
