{
  "name": "omne-harness-lite-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 TURBO_NO_UPDATE_NOTIFIER=1 turbo run build --output-logs=errors-only",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 TURBO_NO_UPDATE_NOTIFIER=1 turbo run typecheck --output-logs=errors-only",
    "test": "./scripts/with-test-slot.sh node --experimental-strip-types tools/test-runner/src/testing/cli.ts run --all --build",
    "test:gate": "./scripts/with-test-slot.sh node --experimental-strip-types tools/test-runner/src/testing/cli.ts step test",
    "test:affected": "./scripts/slot-unless-plan-only.sh node --experimental-strip-types tools/test-runner/src/testing/cli.ts run",
    "test:tier": "./scripts/test-tier.sh",
    "test:triage": "./scripts/with-test-slot.sh node --experimental-strip-types tools/test-runner/src/testing/cli.ts triage",
    "test:python": "mkdir -p tmp && PYTHONDONTWRITEBYTECODE=1 PYTEST_XDIST_AUTO_NUM_WORKERS=0 ./scripts/with-test-slot.sh uv run --locked pytest --ignore-glob='*.legacy' --basetemp=tmp/test-runs -n auto --dist worksteal",
    "format:write": "./scripts/format.sh write",
    "format:check": "./scripts/format.sh check",
    "format:staged": "./scripts/format.sh staged",
    "format:hook:install": "./scripts/install-format-hook.sh",
    "test:format": "./scripts/test-formatting.sh",
    "check": "./scripts/check.sh",
    "admission": "./scripts/check.sh --admission",
    "preflight": "./scripts/check.sh --preflight",
    "check:plan": "node --experimental-strip-types tools/test-runner/src/testing/cli.ts plan",
    "check:agents": "PYTHONDONTWRITEBYTECODE=1 uv run --locked python .meta_harness/tooling/src/compile_agents.py --source .meta_harness/agents --output .meta_harness --check && PYTHONDONTWRITEBYTECODE=1 uv run --locked python .meta_harness/tooling/src/link_agents.py --project-root . --check",
    "check:docs": "uv run --locked omne-docs-check",
    "check:design": "./scripts/check-design.sh",
    "release-run": "node --experimental-strip-types tools/dev-flow/src/integration/release-run-cli.ts",
    "check:journal-facts": "node scripts/check-journal-facts.mjs",
    "check:formal-tools": "uv run --locked omne-spec-tools-check",
    "check:declarations": "omne-declarations",
    "contract:api": "omne-contract-api",
    "lint:rules": "pnpm --filter @omne-harness/product-checks run scan",
    "lint:oxlint": "oxlint -c .oxlintrc.json --report-unused-disable-directives tools scripts packages apps",
    "lint:deps": "omne-deps",
    "lint:report": "oxlint -c .oxlintrc.json -W correctness --vitest-plugin tools scripts packages apps && knip --no-exit-code",
    "acceptance": "./scripts/with-test-slot.sh node --experimental-strip-types tools/test-runner/src/testing/cli.ts run --all --script acceptance",
    "acceptance:lock": "omne-acceptance-lock",
    "acceptance:scenarios": "node --conditions=source --experimental-strip-types tools/product-checks/src/acceptance/scenario-status-cli.ts",
    "metrics": "./scripts/metrics.sh",
    "closeout:metrics": "./scripts/with-test-slot.sh node --experimental-strip-types tools/pqw-adapter/src/cli.ts metrics",
    "closeout:mutation": "./scripts/slot-unless-plan-only.sh node --experimental-strip-types tools/pqw-adapter/src/cli.ts mutation",
    "risk": "node --experimental-strip-types tools/pqw-adapter/src/cli.ts risk",
    "loop:status": "omne-loop-status",
    "loop:health": "omne-loop-health",
    "docs:inventory": "uv run --locked omne-documentation inventory --summary --out tmp/documentation-inventory",
    "package:template": "node --experimental-strip-types tools/dev-flow/src/package-template/cli.ts"
  },
  "devDependencies": {
    "@omne-harness/repo-config": "catalog:",
    "@omne-harness/repo-toolchain": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  }
}
