{
  "name": "@omne-harness/canvas-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Canvas tool: an agent looks at and arranges the canvas of its tenant, through the operations people call",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/canvas-contract": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/tool-contract": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@omne-harness/access-cordis-contract": "workspace:*",
    "@omne-harness/canvas": "workspace:*",
    "@omne-harness/canvas-access": "workspace:*",
    "@omne-harness/canvas-protocol": "workspace:*",
    "@omne-harness/tool": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "5.0.0",
      "variant": "module"
    }
  }
}
