{
  "name": "@omne-harness/canvas-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local provider of the canvas: SQL store, its policy and the Cordis binding",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/canvas": "workspace:*",
    "@omne-harness/canvas-contract": "workspace:*",
    "@omne-harness/canvas-cordis-contract": "workspace:*",
    "@omne-harness/dynamis-cordis": "workspace:*",
    "@omne-harness/sql-contract": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@omne-harness/dynamis": "workspace:*",
    "@omne-harness/sqlite-provider": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "5.0.0",
      "variant": "service-provider"
    }
  }
}
