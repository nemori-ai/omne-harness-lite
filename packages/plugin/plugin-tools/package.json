{
  "name": "@omne-harness/plugin-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The OmneExtensionPoints tool: an agent reads where this system can be extended, what each point accepts and what is placed there now",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/dynamis": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/plugin-protocol": "workspace:*",
    "@omne-harness/public-contract": "workspace:*",
    "@omne-harness/tool-contract": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@omne-harness/tool": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
