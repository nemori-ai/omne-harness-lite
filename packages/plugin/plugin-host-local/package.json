{
  "name": "@omne-harness/plugin-host-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plugin as an asset category on the server: its body contract, its point, and the binding that registers it",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/assets": "workspace:*",
    "@omne-harness/assets-cordis-contract": "workspace:*",
    "@omne-harness/dynamis": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/plugin-protocol": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/dynamis-cordis": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
