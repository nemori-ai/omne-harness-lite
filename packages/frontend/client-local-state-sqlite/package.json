{
  "name": "@omne-harness-lite/client-local-state-sqlite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "私有本地治理记录与原子比较替换（CLS1 / D046）",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "generated",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "kysely": "catalog:",
    "@omne-harness-lite/storage-sql": "workspace:*"
  },
  "dependencies": {
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "ajv": "catalog:",
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "zod": "catalog:",
    "@omne-harness-lite/client-local-state": "workspace:*",
    "@omne-harness-lite/governance-center-entry": "workspace:*",
    "@omne-harness-lite/assembly-lifecycle": "workspace:*"
  }
}
