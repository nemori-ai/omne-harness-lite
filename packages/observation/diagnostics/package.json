{
  "name": "@omne-harness-lite/diagnostics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Bounded structured diagnostics and trace context for local providers",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "provenance.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/records": "workspace:*",
    "@omne-harness-lite/work-data": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "fs-ext": "2.1.1",
    "pino": "10.3.1",
    "sonic-boom": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
