{
  "name": "@omne-harness/interface-access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The access plugin of interface/v1 and the ledger of the inspections on their way: a request goes to a client of the tenant, its image or reason back to the caller",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/access-cordis-contract": "workspace:*",
    "@omne-harness/interface-protocol": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/time-source": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
