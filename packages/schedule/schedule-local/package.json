{
  "name": "@omne-harness/schedule-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local service backend for schedule; initialized draft without business exports",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/schedule": "workspace:*",
    "@omne-harness/schedule-contract": "workspace:*",
    "@omne-harness/schedule-cordis-contract": "workspace:*",
    "@omne-harness/sql-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
