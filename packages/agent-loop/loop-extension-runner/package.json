{
  "name": "@omne-harness-lite/loop-extension-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure runner conclusion keys, codec, retry history and effect composition",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/asset-model": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/loop-extension": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/model-request-runtime": "workspace:*",
    "@omne-harness-lite/session-log-jsonl": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
