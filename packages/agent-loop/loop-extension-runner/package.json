{
  "name": "@omne-harness-lite/loop-extension-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public runner pass execution and durable conclusion building blocks",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness-lite/assembly-manifest-store": "workspace:*",
    "@omne-harness-lite/asset-evaluation": "workspace:*",
    "@omne-harness-lite/asset-model": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/evaluation-input-store": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@omne-harness-lite/loop-extension": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/model-request-runtime": "workspace:*",
    "@omne-harness-lite/session-log-jsonl": "workspace:*",
    "@omne-harness-lite/session-tenancy-table": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@omne-harness-lite/account-identity": "workspace:*",
    "@omne-harness-lite/account-registration": "workspace:*",
    "@omne-harness-lite/asset-registry": "workspace:*",
    "@omne-harness-lite/clock": "workspace:*",
    "@omne-harness-lite/credential-verification": "workspace:*",
    "@omne-harness-lite/organization-governance": "workspace:*",
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/storage-sql": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
