{
  "name": "@omne-harness/assets-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The settings interface module: see every setting of this layer, change it, clear it",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets-ui.css": "./src/view/assets-ui.css"
  },
  "files": [
    "dist",
    "src/view/assets-ui.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/assets-protocol": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/public-contract": "workspace:*",
    "@omne-harness/sdk": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
