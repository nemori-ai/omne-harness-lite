{
  "name": "@omne-harness-lite/evaluation-input-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Current evaluation inputs from immutable local publication and real session/governance facts",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry-inputs": {
      "types": "./dist/registry-inputs.d.ts",
      "import": "./dist/registry-inputs.js"
    },
    "./publication": {
      "types": "./dist/publication.d.ts",
      "import": "./dist/publication.js"
    },
    "./registry-history": {
      "types": "./dist/registry-history.d.ts",
      "import": "./dist/registry-history.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "zod": "catalog:",
    "kysely": "catalog:",
    "@omne-harness-lite/asset-model": "workspace:*",
    "@omne-harness-lite/asset-evaluation": "workspace:*",
    "@omne-harness-lite/agent-definition": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "@omne-harness-lite/organization-governance": "workspace:*",
    "@omne-harness-lite/session-tenancy": "workspace:*",
    "@omne-harness-lite/assembly-manifest": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness-lite/account-identity": "workspace:*",
    "@omne-harness-lite/account-registration": "workspace:*",
    "@omne-harness-lite/clock-lease": "workspace:*",
    "@omne-harness-lite/storage-sql": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@omne-harness-lite/organization-governance-sql": "workspace:*",
    "@omne-harness-lite/assembly-manifest-store": "workspace:*",
    "@omne-harness-lite/session-tenancy-table": "workspace:*",
    "@omne-harness-lite/credential-verification-scrypt": "workspace:*",
    "@omne-harness-lite/account-identity-sql": "workspace:*",
    "@omne-harness-lite/account-registration-sequential": "workspace:*"
  }
}
