{
  "name": "@omne-harness/settings-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Settings SQL persistence and authorized storage reads",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identity": {
      "source": "./src/identity.ts",
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./preparation": {
      "source": "./src/preparation.ts",
      "types": "./dist/preparation.d.ts",
      "import": "./dist/preparation.js"
    },
    "./secrets": {
      "source": "./src/secrets/index.ts",
      "types": "./dist/secrets/index.d.ts",
      "import": "./dist/secrets/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/settings": "workspace:*",
    "@omne-harness/sql-contract": "workspace:*",
    "canonicalize": "5.1.0",
    "zod": "catalog:",
    "@omne-harness/identity": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/utc-instant": "workspace:*",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@omne-harness/sqlite-provider": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@omne-harness/identity-sql": "workspace:*",
    "@omne-harness/scrypt": "workspace:*"
  }
}
