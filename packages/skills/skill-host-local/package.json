{
  "name": "@omne-harness/skill-host-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Skill host: the DirectorySource local directory source and the Skill Cordis plugin",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/kernel-basis": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/skill": "workspace:*",
    "@omne-harness/skill-contract": "workspace:*",
    "@omne-harness/skill-cordis-contract": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/assets": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
