{
  "name": "@omne-harness-lite/organization-governance-sql",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SQL organization governance provider with independent factories and four shared Cordis service faces",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "adr"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness-lite/account-identity": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "@omne-harness-lite/storage": "workspace:*",
    "kysely": "catalog:",
    "zod": "catalog:",
    "@omne-harness-lite/organization-governance": "workspace:*",
    "@omne-harness-lite/assembly-lifecycle": "workspace:*",
    "@omne-harness-lite/cordis-plugin-tree": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness-lite/clock-lease": "workspace:*",
    "@omne-harness-lite/storage-sql": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
