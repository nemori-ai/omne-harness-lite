{
  "name": "@omne-harness-lite/credential-verification-scrypt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "凭据校验提供者（capability.account-identity S-8/S-26 的实现选择）：credentials 服务，密码方案（scrypt）的解析、派生材料、比对与政策判定",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@omne-harness-lite/storage": "workspace:*",
    "kysely": "catalog:",
    "zod": "catalog:",
    "@omne-harness-lite/account-identity": "workspace:*",
    "@omne-harness-lite/assembly-lifecycle": "workspace:*",
    "@omne-harness-lite/cordis-plugin-tree": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness-lite/clock-lease": "workspace:*",
    "@omne-harness-lite/storage-sql": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
