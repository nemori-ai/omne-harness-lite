{
  "name": "@omne-harness/model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Model domain implementation: standalone execution and credential judgments; admission, original-stream preservation and instance observation",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm run build && vitest run",
    "install-closure": "node --experimental-strip-types ../model-contract/tests/install/cli.ts --member . --policy tests/fixtures/install-policy.json --scenario tests/install/scenario.mjs"
  },
  "dependencies": {
    "@omne-harness/call-account": "workspace:*",
    "@omne-harness/content-block": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/message": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/stream-arrival": "workspace:*",
    "@omne-harness/utc-instant": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
