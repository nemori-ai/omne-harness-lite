{
  "profile": "pure-domain",
  "forbidden": [
    {
      "category": "cordis",
      "names": ["@deepseek-ai/cordis", "@deepseek-ai/cosmokit", "cordis", "@cordisjs/*"]
    },
    {
      "category": "model-runtime-provider",
      "names": ["@omne-harness/model-host-local", "@omne-harness/model-cordis-contract"]
    },
    {
      "category": "pi",
      "names": ["@earendil-works/pi-*", "@mariozechner/pi-*"]
    },
    {
      "category": "model-family",
      "names": ["@omne-harness/pi-ai-*"]
    },
    {
      "category": "vendor-sdk",
      "names": [
        "openai",
        "@anthropic-ai/sdk",
        "@google/genai",
        "@google/generative-ai",
        "@ai-sdk/*",
        "ai",
        "ollama",
        "@mistralai/*",
        "cohere-ai",
        "groq-sdk",
        "@azure/openai",
        "@aws-sdk/client-bedrock*"
      ]
    },
    {
      "category": "tokenizer-engine",
      "names": [
        "js-tiktoken",
        "tiktoken",
        "@dqbd/tiktoken",
        "@huggingface/tokenizers",
        "gpt-tokenizer",
        "@anthropic-ai/tokenizer",
        "sentencepiece*"
      ]
    },
    {
      "category": "vocabulary",
      "names": ["*-vocab", "*-vocabulary", "tiktoken-ranks"]
    },
    {
      "category": "storage-engine",
      "names": ["kysely", "pg", "better-sqlite3", "sqlite3", "redis", "ioredis", "proper-lockfile"]
    }
  ]
}
