{
  "name": "@omne-harness/pi-ai-transport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared pi transport for the Model group: createPiTransport, a three-phase ModelTransport over package-internal connection capacity, one-shot HTTPS exchange and SSE framing, and the accepted pi family contribution types",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false",
    "test:live": "vitest run --mode slow --typecheck.enabled=false tests/live"
  },
  "dependencies": {
    "@omne-harness/content-block": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
