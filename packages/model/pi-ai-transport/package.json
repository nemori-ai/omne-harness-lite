{
  "name": "@omne-harness-lite/pi-ai-transport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenRouter \u5355\u6b21\u8bf7\u6c42\u4e0e\u65e0\u635f\u6d41\u8bfb\u53d6\uff0cpi 1.0.0 \u5b9a\u5411 fork",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "resources/tokenizers/deepseek-v4",
    "resources/tokenizers/deepseek-v41-flash",
    "resources/tokenizers/anthropic-legacy",
    "resources/tokenizers/google-gemma4",
    "resources/tokenizers/qwen-38-24t",
    "resources/tokenizers/qwen-38-27b",
    "resources/tokenizers/zai-glm5",
    "resources/tokenizers/moonshot",
    "LICENSE.pi",
    "UPSTREAM.md",
    "provenance.json",
    "README.md",
    "README_ZH.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/tokenizers": "catalog:",
    "js-tiktoken": "catalog:",
    "image-size": "catalog:",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/arrival-events": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/model-profile": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/tool-definition": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/model-response": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "zod": "catalog:",
    "sharp": "catalog:",
    "@omne-harness-lite/model-request-runtime": "workspace:*",
    "@omne-harness-lite/image-codec": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness-lite/stream-assembly": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@omne-harness-lite/model-request-runtime-local": "workspace:*",
    "@omne-harness-lite/session-runtime-local": "workspace:*"
  }
}
