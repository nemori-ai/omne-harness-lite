{
  "name": "@omne-harness-lite/pi-ai-transport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenRouter 单次请求与无损流读取，pi 0.86.1 定向 fork",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "tokenizers/deepseek-v4",
    "tokenizers/deepseek-v41-flash",
    "tokenizers/anthropic-legacy",
    "tokenizers/qwen-38-24t",
    "tokenizers/qwen-38-27b",
    "tokenizers/zai-glm5",
    "tokenizers/moonshot",
    "LICENSE.pi",
    "UPSTREAM.md",
    "provenance.json",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/tokenizers": "catalog:",
    "js-tiktoken": "catalog:",
    "image-size": "catalog:",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/arrival-events": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/model-profile": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/tool-definition": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/model-request-runtime": "workspace:*",
    "@omne-harness-lite/model-response": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness-lite/stream-assembly": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
