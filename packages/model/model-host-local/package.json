{
  "name": "@omne-harness/model-host-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Single-machine host provider of Model: file-backed credential custody with its Cordis plugin, and the local send path over the pi transport",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/model": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/model-cordis-contract": "workspace:*",
    "@omne-harness/pi-ai-transport": "workspace:*",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@omne-harness/call-account": "workspace:*",
    "@omne-harness/pi-ai-anthropic": "workspace:*",
    "@omne-harness/pi-ai-openai": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
