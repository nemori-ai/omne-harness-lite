{
  "name": "@omne-harness/pi-ai-qwen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Qwen family of the pi transport: the OpenRouter record of qwen/qwen3.8-omni-flash on the chat-completions engine, its revisioned rules, the o200k proxy meter, its official profile and createQwenFamily",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false",
    "fingerprints": "node --conditions=source --experimental-strip-types tests/support/append-fingerprints.ts",
    "fixtures": "node --conditions=source --experimental-strip-types tests/live/capture-records.ts --replay"
  },
  "dependencies": {
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/pi-ai-transport": "workspace:*",
    "@omne-harness/tokenizer-tiktoken": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/pi-ai-openai": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "5.0.0",
      "variant": "module"
    }
  }
}
