{
  "name": "@omne-harness/pi-ai-anthropic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Anthropic family of the pi transport: OpenRouter model records, revisioned rules, the legacy Claude BPE estimate meter, official profiles and createAnthropicFamily",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "resources/tokenizers"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false",
    "fingerprints": "node --experimental-strip-types tests/support/append-fingerprints.ts",
    "fixtures": "node --experimental-strip-types tests/support/write-fixtures.ts",
    "examples": "node --experimental-strip-types examples/anthropic-request.ts && node --experimental-strip-types examples/cross-family-history.ts"
  },
  "dependencies": {
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/pi-ai-transport": "workspace:*",
    "@omne-harness/tokenizer-tiktoken": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/message": "workspace:*",
    "@omne-harness/model": "workspace:*",
    "@omne-harness/pi-ai-openai": "workspace:*",
    "@omne-harness/stream-arrival": "workspace:*",
    "@types/node": "catalog:",
    "js-tiktoken": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
