{
  "name": "@omne-harness/sql-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SQL storage contract: identity, receipts, materials, manifest digest, close control, Cordis service definitions and a conformance suite with an in-memory double",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
