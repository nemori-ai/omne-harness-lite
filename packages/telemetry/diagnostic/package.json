{
  "name": "@omne-harness/diagnostic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded failure-chain diagnostic port for storage and model callers",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "pino": "10.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
