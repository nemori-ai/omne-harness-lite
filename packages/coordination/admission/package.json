{
  "name": "@omne-harness-lite/admission",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Synchronous admission coordination, ordered publication, and exact-use ownership",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "provenance.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/diagnostics": "workspace:*",
    "@omne-harness-lite/records": "workspace:*",
    "@omne-harness-lite/work-data": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness-lite/jsonl": "workspace:*",
    "@types/node": "24.13.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
