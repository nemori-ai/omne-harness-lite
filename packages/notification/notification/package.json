{
  "name": "@omne-harness/notification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Notification rules: accepting sends, inboxes, subscriptions and delivery, independent of Cordis and storage",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false",
    "verify:formal": "python3 verification/check.py",
    "walkthrough": "node --conditions=source --experimental-strip-types tests/walkthrough/run.ts"
  },
  "dependencies": {
    "@omne-harness/notification-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
