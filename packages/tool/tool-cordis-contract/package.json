{
  "name": "@omne-harness/tool-cordis-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cordis service definitions of Tool: abstract Services, keys, events and the instance directory",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/content-block": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/stream-arrival": "workspace:*",
    "@omne-harness/tool-contract": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/kernel-basis": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
