{
  "name": "@omne-harness/tool-host-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Single-machine Tool host: the local start coordinator (G5) over the ledger store's host domain",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./author": {
      "source": "./src/author.ts",
      "types": "./dist/author.d.ts",
      "import": "./dist/author.js"
    },
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    },
    "./web": {
      "source": "./src/web.ts",
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/call-account": "workspace:*",
    "@omne-harness/content-block": "workspace:*",
    "@omne-harness/execution-environment-contract": "workspace:*",
    "@omne-harness/execution-environment-cordis-contract": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/runtime-context-contract": "workspace:*",
    "@omne-harness/schema-provider": "workspace:*",
    "@omne-harness/stream-arrival": "workspace:*",
    "@omne-harness/tool": "workspace:*",
    "@omne-harness/tool-contract": "workspace:*",
    "@omne-harness/tool-cordis-contract": "workspace:*",
    "@omne-harness/execution-environment-cordis-contract": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/tool-definitions": "workspace:*",
    "turndown": "7.2.5",
    "undici": "8.11.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/turndown": "5.0.6",
    "@typescript/typescript6": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
