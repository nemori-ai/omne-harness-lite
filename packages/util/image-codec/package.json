{
  "name": "@omne-harness-lite/image-codec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generic loaded image codec contracts, guarded bytes and explicit Sharp adapter",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "sharp": "catalog:"
  },
  "peerDependencies": {
    "sharp": "catalog:"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
