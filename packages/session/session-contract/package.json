{
  "name": "@omne-harness/session-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Session contract: public types, pure judgments, decide and reduce, and the testing doubles of the first tenant path",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/exchange-refs": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/message": "workspace:*",
    "@omne-harness/operation-result": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
