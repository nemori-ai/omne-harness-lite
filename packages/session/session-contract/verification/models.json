{
  "member": "session-contract",
  "model": "models/background-calls/BackgroundCalls.tla",
  "scope": "finite model BackgroundCalls: one session, one or two backgrounded tool calls, at most two user stops and two outcome deliveries for each call, one human input, one archive. Each action is one session commit; the order of pending inputs, freezing, unarchiving, the Tool side of a stop and the physical end of the execution are not modelled. Safety only. No refinement proof to the implementation. Finite model InputDelivery: one session, three inputs of which one is a quiet stop reminder, at most three Runs and three model replies. It follows which inputs a model request shows and whether the brackets agree with it; a taking and its delivery are one action, the order of submits is free, cancellation, archive and compaction are not modelled. Safety only. No refinement proof to the implementation. Finite model SearchCoverage: two sessions with at most three log positions each, at most two index generations, one query at a time read in three steps, one process kill. Every log position stands for a matching message. The tailer, a rebuild with a swap at any time and the query steps interleave freely. Safety only; that the tailer catches up, a damaged index file and the verification of a candidate against the log are not modelled. No refinement proof to the implementation.",
  "workers": 2,
  "timeoutSeconds": 600,
  "cases": [
    {
      "name": "one-call",
      "config": "models/background-calls/one-call.cfg",
      "expected": "complete"
    },
    {
      "name": "two-calls",
      "config": "models/background-calls/two-calls.cfg",
      "expected": "complete"
    },
    {
      "name": "delivery-design",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/design.cfg",
      "expected": "complete"
    },
    {
      "name": "delivery-guard-alone",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/guard-alone.cfg",
      "expected": "complete"
    },
    {
      "name": "search-design",
      "model": "models/search-coverage/SearchCoverage.tla",
      "config": "models/search-coverage/design.cfg",
      "expected": "complete"
    },
    {
      "name": "search-design-deeper",
      "model": "models/search-coverage/SearchCoverage.tla",
      "config": "models/search-coverage/design-deeper.cfg",
      "expected": "complete"
    }
  ],
  "mutations": [
    {
      "name": "stop-twice",
      "base": "one-call",
      "old": "FirstStop(c) == stopBy[c] = \"none\"",
      "new": "FirstStop(c) == TRUE",
      "invariant": "AtMostOneStopReminder"
    },
    {
      "name": "outcome-twice",
      "base": "one-call",
      "old": "FirstOutcome(c) == call[c] = \"bg\"",
      "new": "FirstOutcome(c) == TRUE",
      "invariant": "AtMostOneOutcomeReminder"
    },
    {
      "name": "stop-reminder-wakes",
      "base": "one-call",
      "old": "StopReminderWakes == FALSE",
      "new": "StopReminderWakes == TRUE",
      "invariant": "NoPassiveStart"
    },
    {
      "name": "stopped-outcome-wakes",
      "base": "one-call",
      "old": "StoppedOutcomeWakes == FALSE",
      "new": "StoppedOutcomeWakes == TRUE",
      "invariant": "NoPassiveStart"
    },
    {
      "name": "start-on-any-input",
      "base": "one-call",
      "old": "MayStart(i) == i.wakes",
      "new": "MayStart(i) == TRUE",
      "invariant": "NoPassiveStart"
    },
    {
      "name": "stop-swallows-outcome",
      "base": "one-call",
      "old": "OutcomeKept(c) == lifecycle = \"archived\"",
      "new": "OutcomeKept(c) == lifecycle = \"archived\" \\/ stopBy[c] # \"none\"",
      "invariant": "SettledHasDestination"
    },
    {
      "name": "outcome-after-archive",
      "base": "one-call",
      "old": "OutcomeKept(c) == lifecycle = \"archived\"",
      "new": "OutcomeKept(c) == FALSE",
      "invariant": "NoReminderAfterArchive"
    },
    {
      "name": "stop-after-archive",
      "base": "one-call",
      "old": "StopAllowed == lifecycle = \"open\"",
      "new": "StopAllowed == TRUE",
      "invariant": "NoReminderAfterArchive"
    },
    {
      "name": "agent-stop-reminds",
      "base": "one-call",
      "old": "AgentStopReminds == FALSE",
      "new": "AgentStopReminds == TRUE",
      "invariant": "AgentStopSilent"
    },
    {
      "name": "archive-keeps-pending",
      "base": "one-call",
      "old": "ArchiveClearsPending == TRUE",
      "new": "ArchiveClearsPending == FALSE",
      "invariant": "ArchivedHasNoPending"
    },
    {
      "name": "stop-leaks-to-other-call",
      "base": "two-calls",
      "old": "Stopped(c) == stopBy[c] # \"none\"",
      "new": "Stopped(c) == \\E d \\in Calls : stopBy[d] # \"none\"",
      "invariant": "UnstoppedOutcomeWakes"
    },
    {
      "name": "passive-input-dropped",
      "base": "one-call",
      "old": "delivered' = delivered \\cup pending",
      "new": "delivered' = delivered \\cup {i \\in pending : i.wakes}",
      "invariant": "NoLostReminder"
    }
  ],
  "controls": [
    {
      "name": "delivery-before-shown",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/before-shown.cfg",
      "expected": "ShownTaken"
    },
    {
      "name": "delivery-before-news",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/before-news.cfg",
      "expected": "AskHasNews"
    },
    {
      "name": "delivery-before-quiet",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/before-quiet.cfg",
      "expected": "QuietStable"
    },
    {
      "name": "delivery-before-stuck",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/before-stuck.cfg",
      "expected": "StartEnabled"
    },
    {
      "name": "delivery-before-passive",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/before-passive.cfg",
      "expected": "NoPassiveStart"
    },
    {
      "name": "delivery-late-rows",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/late-rows.cfg",
      "expected": "TakenShown"
    },
    {
      "name": "delivery-first-take-only",
      "model": "models/input-delivery/InputDelivery.tla",
      "config": "models/input-delivery/first-take-only.cfg",
      "expected": "AskHasNews"
    },
    {
      "name": "search-non-atomic-cover",
      "model": "models/search-coverage/SearchCoverage.tla",
      "config": "models/search-coverage/bad-non-atomic-cover.cfg",
      "expected": "S1_Complete"
    },
    {
      "name": "search-rows-before-covered",
      "model": "models/search-coverage/SearchCoverage.tla",
      "config": "models/search-coverage/bad-rows-before-covered.cfg",
      "expected": "S1_Complete"
    },
    {
      "name": "search-mix-generations",
      "model": "models/search-coverage/SearchCoverage.tla",
      "config": "models/search-coverage/bad-mix-generations.cfg",
      "expected": "S1_Complete"
    },
    {
      "name": "search-silent-budget",
      "model": "models/search-coverage/SearchCoverage.tla",
      "config": "models/search-coverage/bad-silent-budget.cfg",
      "expected": "S1_Complete"
    }
  ]
}
