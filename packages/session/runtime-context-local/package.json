{
  "name": "@omne-harness-lite/runtime-context-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    },
    "./schema": "./schema/journal.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "schema",
    "generated",
    "README_ZH.md",
    "verification"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "catalog:",
    "zod": "catalog:",
    "@omne-harness-lite/runtime-context": "workspace:*",
    "@omne-harness-lite/session-log": "workspace:*",
    "@omne-harness-lite/session-tenancy": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/assembly-lifecycle": "workspace:*",
    "@omne-harness-lite/cordis-plugin-tree": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness-lite/storage-sql": "workspace:*",
    "kysely": "catalog:",
    "@omne-harness-lite/session-log-sql": "workspace:*",
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/session-log": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "service-provider"
    }
  }
}
