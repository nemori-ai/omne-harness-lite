{
  "name": "@omne-harness-lite/session-tenancy-table",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ST2 persistent session holding identity; explicitly restricted acceptance seed",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "import": "./dist/maintenance.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md",
    "generated",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "zod": "catalog:",
    "kysely": "catalog:",
    "ajv": "catalog:",
    "@omne-harness-lite/session-tenancy": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness-lite/storage-sql": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "service-provider"
    }
  }
}
