{
  "name": "@omne-harness/session-diagnostics-access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The access plugin of session-diagnostics/v1: the handler of read-session-diagnostics over the session history and the Agent, Model and Tool read ports",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/access-cordis-contract": "workspace:*",
    "@omne-harness/agent-contract": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/session-contract": "workspace:*",
    "@omne-harness/session-diagnostics-protocol": "workspace:*",
    "@omne-harness/tool-contract": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/identity": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "4.0.0",
      "variant": "cordis-module"
    }
  }
}
