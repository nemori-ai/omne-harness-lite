{
  "name": "@omne-harness/authorization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authorization: the admission decision over an access basis, an operation and a target; permit references and consumption facts; the in-process reference check and the in-memory permit ledger",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/identity": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/operation-result": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/agent-contract": "workspace:*",
    "@omne-harness/execution-environment-contract": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/request-context-contract": "workspace:*",
    "@omne-harness/tool": "workspace:*",
    "@omne-harness/tool-contract": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
