{
  "name": "@omne-harness/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Identity: the two system-side principals, their in-process issuer and verifier, named qualifications with role mappings, the tenant standing read port, and the register, login issue and login recognition operations with a ./testing reference double",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/utc-instant": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
