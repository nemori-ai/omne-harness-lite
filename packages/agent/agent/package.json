{
  "name": "@omne-harness/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent implementation without Cordis: construction types, a factory that checks the assembly and returns an idle provider with guarded faces, and the ./testing assembly",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/agent-contract": "workspace:*",
    "@omne-harness/content-block": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/tool-contract": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/message": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
