{
  "name": "@omne-harness/retry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Retry policy parsing, a pure retry decision with injected jitter, and a thin executor over injected time and waiting",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "4.0.0",
      "variant": "module"
    }
  }
}
