{
  "name": "@omne-harness-lite/storage-sql",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Storage 协议的 Kysely 提供者：方言由配置切 sqlite（node:sqlite，自写 Driver）/ postgres（pg，本程只接线），迁移运行器，四型错误映射",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/cordis-plugin-tree": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@omne-harness-lite/storage": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:",
    "@omne-harness-lite/assembly-lifecycle": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "service-provider"
    }
  }
}
