{
  "name": "@omne-harness-lite/session-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Session public operations, typed facts and coordination participant contracts",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/session-log": "workspace:*",
    "@omne-harness-lite/session-tenancy": "workspace:*",
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "service-contract"
    }
  }
}
