{
  "name": "@omne-harness-lite/tool-execution-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    },
    "./journal-schema": "./schema/tool-journal.schema.json"
  },
  "files": [
    "dist",
    "SPEC.md",
    "schema",
    "generated",
    "README.md",
    "README_ZH.md",
    "models"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/assembly-lifecycle": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/arrival-events": "workspace:*",
    "@omne-harness-lite/tool-definition": "workspace:*",
    "@omne-harness-lite/stream-assembly": "workspace:*",
    "@omne-harness-lite/session-tenancy": "workspace:*",
    "@omne-harness-lite/runtime-context": "workspace:*",
    "@omne-harness-lite/execution-environments": "workspace:*",
    "@omne-harness-lite/tool-admission": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/session-log": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "@omne-harness-lite/loop-extension-runner": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/cordis": "catalog:",
    "ajv": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "service-contract"
    }
  }
}
