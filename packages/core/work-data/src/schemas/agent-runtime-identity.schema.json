{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/spec/data/agent-runtime-identity/v1/schema.json",
  "title": "Agent runtime identity v1",
  "oneOf": [
    {"$ref": "#/$defs/SessionRef"},
    {"$ref": "#/$defs/AgentRef"}
  ],
  "$defs": {
    "OpaqueId": {"type": "string", "minLength": 1},
    "SessionRef": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "sessionId"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/OpaqueId"},
        "sessionId": {"$ref": "#/$defs/OpaqueId"}
      }
    },
    "AgentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "sessionId", "incarnationId"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/OpaqueId"},
        "sessionId": {"$ref": "#/$defs/OpaqueId"},
        "incarnationId": {"$ref": "#/$defs/OpaqueId"}
      }
    }
  }
}
