{
  "name": "@omne-harness-lite/model-response",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.model-response v4 默认、显式 v5 与保留 v3 的纯值采用面",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/model-response.schema.json",
    "./schema/v2": "./schema/model-response.v2.schema.json",
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "import": "./dist/v3/index.js"
    },
    "./schema/v3": "./schema/v3/model-response.schema.json",
    "./v5": {
      "types": "./dist/v5/index.d.ts",
      "import": "./dist/v5/index.js"
    },
    "./schema/v5": "./schema/v5/model-response.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/loop-extension": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/model-profile": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
