{
  "name": "@omne-harness-lite/tool-definition",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.tool-definition v3 pure values and caller-owned parameter judgments",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/tool-definition.schema.json",
    "./schema/v2": "./schema/tool-definition.v2.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "generated",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/asset-model": "workspace:*",
    "@eslint-community/regexpp": "catalog:",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@omne-harness-lite/identity-values": "workspace:*"
  }
}
