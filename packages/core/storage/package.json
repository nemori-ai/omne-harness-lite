{
  "name": "@omne-harness-lite/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "存储协议：一次读/写事务、显式行锁与哨兵锁、四型失败；以及任何提供者都必须通过的一致性套件（./conformance）",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "kysely": "catalog:",
    "@deepseek-ai/cordis": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
