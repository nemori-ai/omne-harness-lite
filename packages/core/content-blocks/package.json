{
  "name": "@omne-harness-lite/content-blocks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.content-blocks v2 \u7684\u7eaf\u6a21\u5757\uff1a\u5185\u5bb9\u5757\u3001\u8868\u793a\u6821\u9a8c\u4e0e\u4e25\u683c\u65e0\u635f JSON",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
