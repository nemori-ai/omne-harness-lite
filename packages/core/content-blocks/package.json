{
  "name": "@omne-harness-lite/content-blocks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.content-blocks v3 \u7684\u7eaf\u6a21\u5757\uff1a\u5185\u5bb9\u5757\u3001\u8868\u793a\u6821\u9a8c\u4e0e\u4e25\u683c\u65e0\u635f JSON",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/content-blocks.schema.json",
    "./schema-runtime": {
      "types": "./dist/schema-runtime.d.ts",
      "import": "./dist/schema-runtime.js"
    },
    "./schema/v2": "./schema/content-blocks.v2.schema.json",
    "./code-runtime": {
      "types": "./dist/code-runtime.d.ts",
      "import": "./dist/code-runtime.js",
      "require": "./dist/code-runtime.js"
    },
    "./schema-codegen": {
      "types": "./dist/schema-codegen.d.ts",
      "import": "./dist/schema-codegen.js",
      "require": "./dist/schema-codegen.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "generated",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/identity-values": "workspace:*",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
