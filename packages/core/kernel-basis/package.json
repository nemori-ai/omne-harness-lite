{
  "name": "@omne-harness-lite/kernel-basis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed outcomes, Cordis plugin helpers, adopted kernel probes and test assembly",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md",
    "SPEC.md",
    "verification"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "cordis-module"
    }
  }
}
