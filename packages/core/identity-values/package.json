{
  "name": "@omne-harness-lite/identity-values",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.identity-values v1 的纯模块：身份值类型、解析、相等与规范序列化、派生谓词、Schema 校验、交接凭证签发与核实",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/identity-values.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "generated"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
