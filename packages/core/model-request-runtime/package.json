{
  "name": "@omne-harness-lite/model-request-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public model operations, original-issue participant, owned log codec and pure retry policy",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "README_ZH.md",
    "adr",
    "verification"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/tool-definition": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/session-log": "workspace:*",
    "@omne-harness-lite/model-response": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "@omne-harness-lite/arrival-events": "workspace:*",
    "@omne-harness-lite/model-profile": "workspace:*",
    "@omne-harness-lite/stream-assembly": "workspace:*",
    "@omne-harness-lite/asset-evaluation": "workspace:*",
    "@omne-harness-lite/loop-extension": "workspace:*",
    "@omne-harness-lite/model-profile-directory": "workspace:*",
    "@omne-harness-lite/asset-registry": "workspace:*",
    "@omne-harness-lite/storage": "workspace:*",
    "@omne-harness-lite/session-tenancy": "workspace:*",
    "@omne-harness-lite/session-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "service-contract"
    }
  }
}
