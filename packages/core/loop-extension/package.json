{
  "name": "@omne-harness-lite/loop-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.loop-extension v4 pure values and explicit retained v3 adoption",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/loop-extension.schema.json",
    "./schema/v2": "./schema/loop-extension.v2.schema.json",
    "./schema/v3": "./schema/loop-extension.v3.schema.json",
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "import": "./dist/v3/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "@omne-harness-lite/asset-model": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/model-profile": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/tool-definition": "workspace:*",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
