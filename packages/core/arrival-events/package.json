{
  "name": "@omne-harness-lite/arrival-events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.arrival-events v2 的纯信封判定与块填充归约",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/arrival-events.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "README_ZH.md",
    "generated",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/loop-extension": "workspace:*",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@omne-harness-lite/identity-values": "workspace:*"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "module"
    }
  }
}
