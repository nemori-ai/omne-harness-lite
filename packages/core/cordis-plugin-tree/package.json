{
  "name": "@omne-harness-lite/cordis-plugin-tree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Serializable plugin trees and owned Cordis assembly loading",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness-lite/assembly-lifecycle": "workspace:*",
    "@standard-schema/spec": "catalog:",
    "@babel/helper-validator-identifier": "catalog:",
    "validate-npm-package-name": "catalog:",
    "@omne-harness-lite/kernel-basis": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/validate-npm-package-name": "catalog:"
  }
}
