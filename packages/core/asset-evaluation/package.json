{
  "name": "@omne-harness-lite/asset-evaluation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "capability.asset-evaluation v4 pure evaluation, root selection and result reading; explicit v3 adoption",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "import": "./dist/v3/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/asset-model": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/tool-definition": "workspace:*",
    "@omne-harness-lite/loop-extension": "workspace:*",
    "@omne-harness-lite/mcp-endpoint": "workspace:*",
    "@omne-harness-lite/skill-package": "workspace:*",
    "@omne-harness-lite/slash-command": "workspace:*",
    "@omne-harness-lite/agent-definition": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/model-profile": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
