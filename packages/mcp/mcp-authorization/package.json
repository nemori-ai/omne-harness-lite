{
  "name": "@omne-harness/mcp-authorization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The OAuth grant of an MCP endpoint: discovery, registration, the callback, use and refresh, over ports",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false",
    "verify:formal": "python3 verification/check.py"
  },
  "dependencies": {
    "@omne-harness/mcp-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/legal-identity": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
