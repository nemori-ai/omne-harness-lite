                                  "value": "string"
                                }
                              },
                              {
                                "key": "description",
                                "value": {
                                  "kind": "string",
                                  "value": "Exact Context7-compatible library ID (e.g., '/mongodb/docs', '/vercel/next.js', '/supabase/supabase', '/vercel/next.js/v16.2.9') retrieved from 'resolve-library-id' or directly from user query in the format '/org/project' or '/org/project/version'."
                                }
                              }
                            ]
