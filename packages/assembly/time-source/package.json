{
  "name": "@omne-harness/time-source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One timeline for an assembled system: wall and monotonic readings, waits on both, and a simulated source that a driver advances",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./simulated": {
      "source": "./src/simulated.ts",
      "types": "./dist/simulated.d.ts",
      "import": "./dist/simulated.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
