{
  "name": "@omne-harness/loop-extension-host-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local host of Loop Extension: the cached view of the enabled extensions, its Runtime Context producer, the registry of builtin implementations, and the provider of extension implementations",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/agent-contract": "workspace:*",
    "@omne-harness/agent-cordis-contract": "workspace:*",
    "@omne-harness/assets": "workspace:*",
    "@omne-harness/execution-environment-contract": "workspace:*",
    "@omne-harness/kernel-basis": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/loop-extension": "workspace:*",
    "@omne-harness/loop-extension-contract": "workspace:*",
    "@omne-harness/loop-extension-cordis-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/runtime-context-contract": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/assets-local": "workspace:*",
    "@omne-harness/execution-environment-cordis-contract": "workspace:*",
    "@omne-harness/execution-environment-host-local": "workspace:*",
    "@omne-harness/runtime-context": "workspace:*",
    "@omne-harness/settings-local": "workspace:*",
    "@omne-harness/sql-contract": "workspace:*",
    "@omne-harness/sqlite-provider": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
