{
  "name": "@omne-harness/loop-extension-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure Loop Extension contract: the package and its declaration, the asset category, the enabled-extensions block, and the command protocol",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/agent-contract": "workspace:*",
    "@omne-harness/assets": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/settings": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
