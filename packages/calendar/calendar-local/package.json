{
  "name": "@omne-harness/calendar-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local calendar SQL persistence, source acquisition, offline seeds and managed providers",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/calendar": "workspace:*",
    "@omne-harness/calendar-contract": "workspace:*",
    "@omne-harness/calendar-cordis-contract": "workspace:*",
    "@omne-harness/sql-contract": "workspace:*",
    "canonicalize": "5.1.0",
    "zod": "catalog:",
    "@omne-harness/settings": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@omne-harness/sqlite-provider": "workspace:*",
    "@omne-harness/settings-local": "workspace:*",
    "@omne-harness/identity": "workspace:*",
    "@omne-harness/identity-sql": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/scrypt": "workspace:*",
    "@omne-harness/utc-instant": "workspace:*"
  }
}
