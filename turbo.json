{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "cache": false
    },
    "test:fast": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": [
        "TMPDIR",
        "TMP",
        "TEMP",
        "VITEST_MAX_WORKERS",
        "OMNE_TEST_REPORT_DIR",
        "OMNE_RUNNER_ROOT"
      ]
    },
    "test:slow": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": [
        "TMPDIR",
        "TMP",
        "TEMP",
        "VITEST_MAX_WORKERS",
        "OMNE_TEST_REPORT_DIR",
        "OMNE_RUNNER_ROOT"
      ]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": [
        "TMPDIR",
        "TMP",
        "TEMP",
        "VITEST_MAX_WORKERS",
        "OMNE_TEST_REPORT_DIR",
        "OMNE_RUNNER_ROOT"
      ]
    }
  }
}
