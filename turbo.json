{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "vitest.tiers.mts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:fast": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["VITEST_MAX_WORKERS", "OMNE_TEST_REPORT_DIR"],
      "env": ["TMPDIR", "TMP", "TEMP", "OMNE_RUNNER_ROOT"]
    },
    "test:slow": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["VITEST_MAX_WORKERS", "OMNE_TEST_REPORT_DIR"],
      "env": ["TMPDIR", "TMP", "TEMP", "OMNE_RUNNER_ROOT"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["VITEST_MAX_WORKERS", "OMNE_TEST_REPORT_DIR"],
      "env": ["TMPDIR", "TMP", "TEMP", "OMNE_RUNNER_ROOT"]
    }
  }
}
