# Rebuildable host projections; authored inputs live under agents/.
/.claude/
/.agents/
/.codex/


# TLC execution output is not a specification resource. Keep actual runs in
# record/evidence; scratch and generated traces belong in the task tmp/.
/design/spec/**/formal/*_TTrace_*
/design/spec/**/formal/*_TE.*
/design/spec/**/formal/states/
/design/spec/**/formal/MC.out

# One-off construction, registry patches and merge scheduling belong in tmp/.
# Historical address aliases required by frozen contracts remain tracked.
/design/record/proposals/**/spec-construction-brief.md
/design/record/proposals/**/ack-spec-construction-brief.md
/design/record/proposals/**/handoff-manifest.json
