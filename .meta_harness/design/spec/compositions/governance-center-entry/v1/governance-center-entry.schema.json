        "capability.organization-governance/v1#S-58",
        "capability.organization-governance/v1#S-59",
        "capability.organization-governance/v1#S-60"
      ]
    },
    "Envelope": {
      "title": "请求信封（contract.md S-4）",
      "description": "恰含这四个成员，没有别的成员。不合这个形状时答哪一种由 S-10 按不合的是哪个成员决定：不可解析或 protocolVersion 缺席／不被接受 ⇒ version-mismatch；operation 表外或有表外成员 ⇒ invalid-input；出示物不合形状或不止一个 ⇒ login-state-rejected（免认人路由不看它）；payload 不合它那条路由的 Payload_<路由> ⇒ invalid-input（经第 ② 步的路由在认出人之后）。信封里没有任何时刻字段。",
      "type": "object",
      "required": ["protocolVersion", "operation", "payload"],
      "additionalProperties": false,
      "properties": {
