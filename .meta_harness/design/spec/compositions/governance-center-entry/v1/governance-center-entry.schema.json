        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-25" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S25" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-26" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S26" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-27" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S27" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-28" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S28" } } } },
