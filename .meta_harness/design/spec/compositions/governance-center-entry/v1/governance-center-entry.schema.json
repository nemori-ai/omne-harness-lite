        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-56" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S56" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-57" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S57" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-58" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S58" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-59" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S59" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-60" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S60" } } } }
