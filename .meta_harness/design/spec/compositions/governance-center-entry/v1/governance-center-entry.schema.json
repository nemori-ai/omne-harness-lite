    "Result_AI_S16": { "title": "撤销成功的返回（S-16 ⑤）", "const": "ok" },
    "Result_AI_S37": {
      "title": "列出登录状态的返回（S-37 ⑤：每项的 LoginStateId 与签发时间）",
      "description": "至少一项：成功调用必含调用方自己那一个；空列表是缺陷，入口答 unavailable，不会作为成功返回出现（contract.md S-20）。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/LoginStateListItem" }
    },
    "Result_OG_S21": { "title": "创建团队组织的返回（S-21 ⑤）", "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/OrganizationId" },
    "Result_OG_S22": { "title": "读组织的返回（S-22 ⑤）", "$ref": "#/$defs/OrganizationView" },
    "Result_OG_S23": { "title": "发出邀请的返回（S-23 ⑤）", "$ref": "#/$defs/InvitationId" },
    "Result_OG_S24": { "title": "撤回邀请的返回（S-24 ⑤）", "const": "ok" },
    "Result_OG_S25": { "title": "接受邀请的返回（S-25 ⑤）", "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/TenantId" },
    "Result_OG_S26": { "title": "成员资格判定的返回（S-26 ⑤；判不出来是入口答复 unavailable，不在这里）", "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/MembershipStanding" },
    "Result_OG_S27": {
      "title": "我的租户的返回（S-27 ⑤）",
      "description": "至少一项：认得出的来者是已激活的账号，空列表是缺陷（contract.md S-22）。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/TenantId" }
    },
    "Result_OG_S28": { "title": "调整角色的返回（S-28 ⑤）", "const": "ok" },
    "Result_OG_S29": { "title": "解除成员的返回（S-29 ⑤）", "const": "ok" },
    "Result_OG_S30": { "title": "发出隶属请求的返回（S-30 ⑤）", "$ref": "#/$defs/AffiliationRequestId" },
    "Result_OG_S31": { "title": "撤回隶属请求的返回（S-31 ⑤）", "const": "ok" },
    "Result_OG_S32": { "title": "接受隶属请求的返回（S-32 ⑤）", "const": "ok" },
    "Result_OG_S33": { "title": "解除隶属的返回（S-33 ⑤）", "const": "ok" },
    "Result_OG_S34": {
      "title": "上级链／有共同上级的返回（S-34 ⑤）",
      "description": "载荷一个组织 ⇒ 上级链：组织序列，不含自己，个人组织为空序列；两个组织 ⇒ 有共同上级：布尔。",
      "oneOf": [
        { "type": "array", "items": { "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/OrganizationId" } },
        { "type": "boolean" }
      ]
    },
