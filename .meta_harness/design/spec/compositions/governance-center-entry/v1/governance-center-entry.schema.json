        "organizationLayer": {
          "allOf": [
            { "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/ScopeLayerIdentity" },
            { "properties": { "layer": { "const": "organization" } } }
          ]
        },
        "tenantLayer": {
          "allOf": [
            { "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/ScopeLayerIdentity" },
            { "properties": { "layer": { "const": "tenant" } } }
          ]
        }
      }
    },
    "Result_OG_S36": { "title": "当前租户身份查询的返回（S-36 ⑤）", "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/TenantId" },
    "Result_OG_S37": { "title": "切换当前租户身份的返回（S-37 ⑤）", "const": "ok" },
    "Result_OG_S55": { "title": "读邀请的返回（S-55 ⑤）", "$ref": "#/$defs/InvitationView" },
    "Result_OG_S56": { "title": "读隶属请求的返回（S-56 ⑤）", "$ref": "#/$defs/AffiliationRequestView" },
    "Result_OG_S57": { "title": "列出账号收到的待接受邀请的返回（S-57 ⑤）", "type": "array", "items": { "$ref": "#/$defs/InvitationView" } },
