        "affiliationRequests": { "type": "array", "items": { "$ref": "#/$defs/AffiliationRequestView" } }
      }
    },
    "Result_OG_S59": { "title": "列出组织成员的返回（S-59 ⑤）", "type": "array", "items": { "$ref": "#/$defs/MemberView" } },
    "Result_OG_S60": { "title": "列出组织收到的隶属请求的返回（S-60 ⑤）", "type": "array", "items": { "$ref": "#/$defs/IncomingAffiliationRequestView" } },
    "ClientFaceReply": {
      "title": "客户端一面对一个信封的答复（contract.md S-7）",
      "description": "恰为三类之一，没有第四类。",
      "oneOf": [
        { "$ref": "#/$defs/EntryAnswer" },
        { "$ref": "#/$defs/RouteSuccess" },
        { "$ref": "#/$defs/RouteFailure" }
      ]
    },
    "PublicHealthReply": {
      "title": "公开体检答复（contract.md S-18）",
      "description": "恰此三样；失败集合为空。reachable 只说中心在应答，数据所在够不着、钟倒退、中心自身故障时照样为 true。不含任何治理事实与秘密。形状跨协议版本不变（S-8）。",
      "type": "object",
      "required": ["reachable", "centerId", "version"],
      "additionalProperties": false,
      "properties": {
        "reachable": { "const": true },
        "centerId": { "$ref": "#/$defs/GovernanceCenterId" },
        "version": {
          "description": "中心所装版本的标识；与 accepted_protocol_versions 的对应关系归技术设计。",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DeploymentParameterDuration": {
      "title": "一项部署参数的值",
      "description": "一个时长，以正整数毫秒表示。没有出厂默认。",
      "type": "integer",
      "minimum": 1
    },
    "DeploymentParameters": {
      "title": "五项部署参数此刻生效的值（contract.md S-26）",
      "description": "启动时读入；五项缺一不可。copyNoticeTtlDefault 与 sharingInvitationTtlDefault 本版没有消费它们的契约（G-4），照样要值、照样可见。",
      "type": "object",
      "required": [
        "unactivatedRetention",
        "invitationTtlDefault",
        "affiliationRequestTtlDefault",
        "copyNoticeTtlDefault",
        "sharingInvitationTtlDefault"
      ],
      "additionalProperties": false,
      "properties": {
        "unactivatedRetention": { "$ref": "#/$defs/DeploymentParameterDuration" },
        "invitationTtlDefault": { "$ref": "#/$defs/DeploymentParameterDuration" },
        "affiliationRequestTtlDefault": { "$ref": "#/$defs/DeploymentParameterDuration" },
        "copyNoticeTtlDefault": { "$ref": "#/$defs/DeploymentParameterDuration" },
        "sharingInvitationTtlDefault": { "$ref": "#/$defs/DeploymentParameterDuration" }
      }
    },
    "FullHealthReply": {
      "title": "完整体检答复（contract.md S-26）",
      "description": "只在运维面上可读。恰此十项，没有别的成员。失败集合为空：读不到的项是 false，不是失败。不含部署密钥或任何凭据的值，不含任何治理事实。",
      "type": "object",
      "required": [
        "reachable",
        "centerId",
        "version",
        "startedAt",
        "storageReachable",
        "deploymentKeyPresent",
        "deploymentKeyComplete",
        "clockSane",
        "defectCount",
        "deploymentParameters"
      ],
      "additionalProperties": false,
      "properties": {
        "reachable": { "const": true },
        "centerId": { "$ref": "#/$defs/GovernanceCenterId" },
        "version": { "type": "string", "minLength": 1 },
        "startedAt": {
          "description": "这一次启动成功的时刻（中心的钟）；启动成功以钟可读为条件（contract.md S-34），所以总有定义。形状取 data.offer-expiry v1 的 Instant（S-22）。",
          "$ref": "../../../data/offer-expiry/v1/offer-expiry.schema.json#/$defs/Instant"
        },
        "storageReachable": {
          "description": "本次读取时现探数据所在；探不通为 false。",
          "type": "boolean"
        },
        "deploymentKeyPresent": {
          "description": "启动时载入的结果；中心在应答时恒为 true。",
          "const": true
        },
        "deploymentKeyComplete": {
          "description": "启动时载入的结果；中心在应答时恒为 true。",
          "const": true
        },
        "clockSane": {
          "description": "本次读取时现读钟；读不到或比中心用过的最晚时刻早为 false。",
          "type": "boolean"
        },
        "defectCount": {
          "description": "自本次启动以来记过的缺陷数（S-14）；启动时为 0，重启归零。「记过缺陷」即 defectCount > 0。",
          "type": "integer",
          "minimum": 0
        },
        "deploymentParameters": { "$ref": "#/$defs/DeploymentParameters" }
      }
    }
  }
}
