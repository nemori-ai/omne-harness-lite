    "LoginResult": {
      "title": "登录成功的返回（contract.md S-19）",
      "description": "loginState 是 capability.account-identity v2 S-15 交出的出示物（只此一次）；loginStateHandle 是同一个登录状态的 LoginStateId（列表句柄，S-9），客户端据它在列表里认出自己、用它退出。",
      "type": "object",
