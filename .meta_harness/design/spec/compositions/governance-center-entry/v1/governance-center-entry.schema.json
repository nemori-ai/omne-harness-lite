        "loginStateHandle": { "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/LoginStateId" }
      }
    },
    "LoginStateListItem": {
      "title": "登录状态列表的一项（contract.md S-20）",
      "description": "恰此两样：列表句柄（即那个登录状态的 LoginStateId）与签发时间。不含出示物——LoginStateId 过不了 capability.account-identity v2 S-44，列一次拿不走其余设备能用的东西（S-9）。",
      "type": "object",
      "required": ["loginStateHandle", "issuedAt"],
      "additionalProperties": false,
      "properties": {
        "loginStateHandle": { "$ref": "../../../data/identity-values/v1/identity-values.schema.json#/$defs/LoginStateId" },
        "issuedAt": {
          "description": "这个登录状态被签发的时刻（中心的钟）；形状取 data.offer-expiry v1 的 Instant（S-22：带时区偏移的 RFC 3339 时间点）。",
          "$ref": "../../../data/offer-expiry/v1/offer-expiry.schema.json#/$defs/Instant"
        }
      }
    },
    "InvitationId": {
      "title": "InvitationId（capability.organization-governance v1 S-10；值定义归本契约，contract.md S-17 注 3）",
      "description": "不透明、部署内唯一、由存储生成。交换表示按 data.identity-values v1 S-31 的散文：非空字符串；首字符与末字符都不属于该条列出的空白码点集合；逐码点相等，不做任何规范化。末尾用 (?![\\s\\S]) 判绝对结尾，不用 $。消费者不得解析其内容。",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])"
    },
    "AffiliationRequestId": {
      "title": "AffiliationRequestId（capability.organization-governance v1 S-11；值定义归本契约，contract.md S-17 注 3）",
      "description": "隶属请求的标识，与 InvitationId 同类。交换表示按 data.identity-values v1 S-31 的散文：非空字符串；首字符与末字符都不属于该条列出的空白码点集合；逐码点相等，不做任何规范化。消费者不得解析其内容。",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])"
    },
    "CreationKey": {
      "title": "创建键（creationKey，capability.organization-governance v1 S-21 ①；值定义归本契约，contract.md S-17 注 3）",
      "description": "调用方给出的不透明去重标识。交换表示按 data.identity-values v1 S-31 的散文：非空字符串；首字符与末字符都不属于该条列出的空白码点集合；逐码点相等，不做任何规范化。",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])"
    },
    "CredentialMaterial": {
      "title": "凭据材料（credential，capability.account-identity v2 S-8）",
      "description": "线上是一个非空字符串。内部格式归凭据方案的 owner（与 capability.account-identity v2 S-26 credential_policy 同一个 owner）；入口层的表示层校验用该 owner 给出的同一条解析规则，解析不过 ⇒ invalid-input（contract.md S-19）。Schema 只断言「非空字符串」这一层，解析规则不在这里。",
      "type": "string",
      "minLength": 1
    },
    "OfferTtl": {
      "title": "这一份邀约的有效时长（offerTtl）",
      "description": "data.offer-expiry v1 S-14 的 offer_ttl 的指定值，与部署参数 invitationTtlDefault／affiliationRequestTtlDefault 同一概念、同一表示：整数毫秒。线上只约束「是整数，且不大于 2^53−1」：不合 ⇒ invalid-input（入口表示层）；合这一条但非正，或大到越过领域或 data.offer-expiry 能表示的时刻 ⇒ 交给领域，按 capability.organization-governance v1 S-23／S-30 的「非正或不合形状」一支给 invalidOfferDuration（contract.md S-17 注 3）。",
      "type": "integer",
      "maximum": 9007199254740991
    },
    "AffiliationDirection": {
      "title": "隶属请求的方向（direction，capability.organization-governance v1 S-11、S-30 ①）",
      "description": "请对方作自己的上级 ⇒ recipientAsParent；请对方作自己的下级 ⇒ recipientAsChild。参与条款只有散文，两个取值名由本契约首次命名（S-17 命名表）。",
      "type": "string",
      "enum": ["recipientAsParent", "recipientAsChild"]
    },
    "CallerIdentityKind": {
