        },
        "operation": { "$ref": "#/$defs/EnvelopeRouteId" },
        "payload": {
          "description": "这条路由的载荷；没有载荷项时是空对象。形状按 operation 判别到 Payload_<路由>（下面的 allOf），成员封闭；成员名见 contract.md S-17 的命名表。载荷里没有「以谁的身份」这一格：发起者、调用方、接受者的身份一律推导（S-12）。",
          "type": "object"
        }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "const": "composition.account-registration/v1#S-8" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_AR_S8" } } } },
        { "if": { "properties": { "operation": { "const": "capability.account-identity/v2#S-15" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_AI_S15" } } } },
        { "if": { "properties": { "operation": { "const": "capability.account-identity/v2#S-16" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_AI_S16" } } } },
        { "if": { "properties": { "operation": { "const": "capability.account-identity/v2#S-37" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_AI_S37" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-21" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S21" } } } },
        { "if": { "properties": { "operation": { "const": "capability.organization-governance/v1#S-22" } }, "required": ["operation"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/Payload_OG_S22" } } } },
