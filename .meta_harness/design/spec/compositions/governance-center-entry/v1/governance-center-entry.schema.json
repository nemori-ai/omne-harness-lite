{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/compositions/governance-center-entry/v1/governance-center-entry.schema.json",
  "title": "composition.governance-center-entry v1 · 治理中心入口的线上形状",
  "description": "候选（candidate）。本文件只给信封、四种入口答复、路由结果外形、公开与完整体检、GovernanceCenterId 与出示物的形状；判定次序、映射与每条路由的语义以 contract.md 为准。身份值不在此复述，一律引用 data.identity-values v1；邀约的时刻与派生状态、以及时间点（issuedAt、startedAt）引用 data.offer-expiry v1。InvitationId、AffiliationRequestId、CreationKey 三个不透明标识的值定义归本文件，形状按 data.identity-values v1 S-31 的散文，不引用那份 Schema 的内部基定义。三份参与契约（capability.account-identity v2、capability.organization-governance v1、composition.account-registration v1）不发布 Schema，27 条路由的载荷与成功返回的线上形状由本文件定义（Payload_<路由>、Result_<路由>），成员名从各条款 ①／⑤ 的散文推出，见 contract.md S-17 的命名表（2026-09-23 主线认可）。",
  "$defs": {
    "GovernanceCenterId": {
      "title": "治理中心标识 · Governance Center Identifier（contract.md S-27）",
      "description": "128 位随机值；规范形式恰一种：32 个小写十六进制字符。相等即逐字符相等，不做任何规范化。不是地址、不是秘密，不从部署密钥或地址派生。",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "examples": ["3f9c1e0a7b2d4c6e8f0a1b2c3d4e5f60"],
      "x-counterexamples": [
        { "value": "3F9C1E0A7B2D4C6E8F0A1B2C3D4E5F60", "rejectedBy": "大写不是规范形式；比较不做大小写折叠" },
        { "value": "3f9c1e0a-7b2d-4c6e-8f0a-1b2c3d4e5f60", "rejectedBy": "带分隔符不是规范形式" },
        { "value": "3f9c1e0a7b2d4c6e", "rejectedBy": "长度不足 128 位" }
      ]
    },
    "LoginStatePresentation": {
      "title": "出示物（登录状态出示物，无词条）· presentedLoginState、loginState（contract.md S-5；capability.account-identity v2 S-45）",
      "description": "持有即被认的不透明字符串，由账号能力签发、只在登录成功的那一次答复里交出。不是 LoginStateId；字母表不定，消费者不得解析。交换表示按 capability.account-identity v2 S-45，本定义只是它的投影：Unicode 标量值序列（不含孤立的代理码点，由 not/pattern 断言，须在按码点匹配的正则方言下求值，如 ECMA-262 的 u 标志）；非空；至多 1024 个标量值（候选值，随 S-45 定）；首字符与末字符都不属于 data.identity-values v1 S-31 列出的空白码点集合；逐码点相等，不做任何规范化。末尾用 (?![\\s\\S]) 判绝对结尾，不用 $。",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": { "pattern": "[\\uD800-\\uDFFF]" },
      "pattern":"^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])"
    },
    "ProtocolVersion": {
      "title": "协议版本（contract.md S-8）",
      "description": "客户端声明的线上协议版本。哪些值算对得上由具名参数 accepted_protocol_versions 决定（本契约不填值）。交换表示：非空字符串。",
      "type": "string",
      "minLength": 1
    },
    "PublicHealthRouteId": {
      "title": "公开体检的路由标识（contract.md S-18）",
      "const": "composition.governance-center-entry/v1#S-18"
    },
    "EnvelopeRouteId": {
      "title": "信封路由标识（contract.md S-17）",
      "description": "路由表封闭：恰这 27 条，没有泛化分派。每个值是被投影条款的坐标。表外的值 ⇒ invalid-input（S-10 ①′）。",
      "type": "string",
