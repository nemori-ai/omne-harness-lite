{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/capabilities/durable-records/v1/schema.json",
  "title": "Durable Records v1 generic commit, writer epoch and personal creation shapes",
  "oneOf": [
    {"$ref": "#/$defs/JournalLine"},
    {"$ref": "#/$defs/CommitEnvelope"},
    {"$ref": "#/$defs/PersonalCreationConflictOutcome"},
    {"$ref": "#/$defs/OperationConflictFactData"}
  ],
  "$defs": {
    "JournalLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteLength", "formatVersion", "payload", "sha256"],
      "properties": {
        "byteLength": {"type": "integer", "minimum": 1},
        "formatVersion": {"const": "core-journal/3"},
        "payload": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "StreamRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "owner", "scope", "streamId"],
      "properties": {
        "namespace": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
        "owner": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {"kind": {"const": "system"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "tenantId"],
              "properties": {
                "kind": {"const": "tenant"},
                "tenantId": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"}
              }
            }
          ]
        },
        "streamId": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"}
      }
    },
    "RevisionConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "currents"],
      "properties": {
        "kind": {"const": "revision"},
        "currents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stream", "revision"],
            "properties": {
              "stream": {"$ref": "#/$defs/StreamRef"},
              "revision": {"$ref": "#/$defs/Counter"}
            }
          }
        }
      }
    },
    "PersonalCreationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict", "personalTargetTenantId", "source", "operationRef", "inputDigest", "userRef"],
      "properties": {
        "conflict": {"$ref": "#/$defs/RevisionConflict"},
        "personalTargetTenantId": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
        "source": {"enum": ["deployment_init", "account_registration"]},
        "operationRef": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/core-work/v1/schema.json#/$defs/OperationRef"},
        "inputDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "userRef": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/core-work/v1/schema.json#/$defs/UserRef"}
      }
    },
    "PersonalCreationConflictOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "conflict", "personalTargetTenantId", "source", "operationRef", "inputDigest", "userRef"],
      "properties": {
        "status": {"const": "conflict"},
        "conflict": {"$ref": "#/$defs/RevisionConflict"},
        "personalTargetTenantId": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
        "source": {"enum": ["deployment_init", "account_registration"]},
        "operationRef": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/core-work/v1/schema.json#/$defs/OperationRef"},
        "inputDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "userRef": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/core-work/v1/schema.json#/$defs/UserRef"}
      }
    },
    "GenericConflictOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "conflict"],
      "properties": {
        "status": {"const": "conflict"},
        "conflict": {"$ref": "#/$defs/RevisionConflict"}
      }
    },
    "OperationConflictFactData": {
      "oneOf": [
        {"$ref": "#/$defs/RevisionConflict"},
        {"$ref": "#/$defs/PersonalCreationBinding"}
      ]
    },
    "CommitEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "position", "operation", "inputEncoding", "canonicalInput", "inputDigest", "appends", "outcome", "requiredUses"],
      "properties": {
        "formatVersion": {"const": "core-journal/3"},
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coordinationDomain", "writerEpoch", "commitId", "seq"],
          "properties": {
            "coordinationDomain": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
            "writerEpoch": {"$ref": "#/$defs/Counter"},
            "commitId": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
            "seq": {"$ref": "#/$defs/Counter"}
          }
        },
        "operation": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/core-work/v1/schema.json#/$defs/OperationRef"},
        "inputEncoding": {"const": "core-json/1"},
        "canonicalInput": {"type": "string"},
        "inputDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "appends": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stream", "expectedRevision", "records"],
            "properties": {
              "stream": {"$ref": "#/$defs/StreamRef"},
              "expectedRevision": {"$ref": "#/$defs/Counter"},
              "records": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "version", "data"],
                  "properties": {
                    "kind": {"type": "string", "minLength": 1},
                    "version": {"type": "string", "minLength": 1},
                    "data": {}
                  }
                }
              }
            }
          }
        },
        "outcome": {
          "oneOf": [
            {"$ref": "#/$defs/GenericConflictOutcome"},
            {"$ref": "#/$defs/PersonalCreationConflictOutcome"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "result"],
              "properties": {"status": {"const": "committed"}, "result": {}}
            }
          ]
        },
        "requiredUses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recordOwner", "binding"],
            "properties": {
              "recordOwner": {"type": "string", "minLength": 1},
              "binding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["owner", "resourceId", "generation", "epoch"],
                "properties": {
                  "owner": {"type": "string", "minLength": 1},
                  "resourceId": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
                  "generation": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
                  "epoch": {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"}
                }
              }
            }
          }
        }
      }
    },
    "PersonalCreationEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/CommitEnvelope"},
        {
          "if": {"properties": {"outcome": {"properties": {"status": {"const": "conflict"}}}}},
          "then": {
            "properties": {
              "outcome": {"$ref": "#/$defs/PersonalCreationConflictOutcome"},
              "appends": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "stream": {
                      "properties": {
                        "namespace": {"const": "core.records"},
                        "owner": {"const": "durable-records"},
                        "scope": {"properties": {"kind": {"const": "system"}}},
                        "streamId": {"const": "operation-outcomes"}
                      }
                    },
                    "records": {
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "properties": {
                          "kind": {"const": "operation.conflict"},
                          "version": {"const": "3"},
                          "data": {"$ref": "#/$defs/PersonalCreationBinding"}
                        }
                      }
                    }
                  }
                }
              },
              "requiredUses": {"maxItems": 0}
            }
          },
          "else": {"properties": {"appends": {"minItems": 2, "maxItems": 3}}}
        }
      ]
    },
    "WriterEpochEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/CommitEnvelope"},
        {
          "properties": {
            "operation": {
              "properties": {
                "namespace": {"const": "core.writer"},
                "operationId": {"type": "string", "pattern": "^epoch:[1-9][0-9]*$"}
              }
            },
            "appends": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "stream": {
                    "properties": {
                      "namespace": {"const": "core.writer"},
                      "owner": {"const": "durable-records"},
                      "scope": {"properties": {"kind": {"const": "system"}}},
                      "streamId": {"const": "writer-epochs"}
                    }
                  },
                  "records": {
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "properties": {
                        "kind": {"const": "writer.epoch"},
                        "version": {"const": "3"},
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["epoch"],
                          "properties": {"epoch": {"$ref": "#/$defs/Counter"}}
                        }
                      }
                    }
                  }
                }
              }
            },
            "outcome": {
              "type": "object",
              "properties": {
                "status": {"const": "committed"},
                "result": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["epoch"],
                  "properties": {"epoch": {"$ref": "#/$defs/Counter"}}
                }
              }
            },
            "requiredUses": {"maxItems": 0}
          }
        }
      ]
    },
    "GenericConflictEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/CommitEnvelope"},
        {
          "properties": {
            "appends": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "stream": {
                    "properties": {
                      "namespace": {"const": "core.records"},
                      "owner": {"const": "durable-records"},
                      "streamId": {"const": "operation-outcomes"}
                    }
                  },
                  "records": {
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "properties": {
                        "kind": {"const": "operation.conflict"},
                        "version": {"const": "3"},
                        "data": {"$ref": "#/$defs/RevisionConflict"}
                      }
                    }
                  }
                }
              }
            },
            "outcome": {"$ref": "#/$defs/GenericConflictOutcome"},
            "requiredUses": {"maxItems": 0}
          }
        }
      ]
    }
  }
}
