        },
        "stopReason": {
          "type": "string",
          "minLength": 1,
          "description": "上游原样的 finish / stop reason，不翻译；上游没给时缺席。消费者不得据它推断收场，收场只看 outcome（S-12）。"
        },
        "reply": {
          "$ref": "../../messages/v6/messages.schema.json#/$defs/AssistantMessage",
          "description": "这一次拿回来的那份回复（S-14）。它成没成为消息看 replyDisposition。它的 response 成员必须等于本响应体的 id（跨字段，Schema 不管）。"
        },
        "delivered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../../content-blocks/v3/content-blocks.schema.json#/$defs/ContentBlock"
          },
          "description": "开了口却没有回复的那一次，已交付、不成为消息的那部分：首 token 之后的故障，或开了口之后被中断而没有交出回复（S-14）。缺席即没有；空数组不是合法写法。"
        },
        "failure": {
          "$ref": "#/$defs/Failure"
        },
        "timing": {
          "allOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "properties": {
                "sentAt": {
                  "$ref": "../../offer-expiry/v1/offer-expiry.schema.json#/$defs/Instant"
                }
              }
            }
          ]
        },
        "usage": {
          "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/Usage"
        },
        "cost": {
          "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/Cost"
        },
        "trims": {
          "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/TrimSummary",
          "description": "这一次发出的流上合并与截掉的汇总（S-19）。缺席即一次也没砍；全零的汇总不是合法写法。",
          "$comment": "全零即没砍，只有缺席这一种写法：四个计数里至少一个大于零（截短单个增量只计在 byReason.frame_too_long 与 omittedBytes 里，不计 merged、cut）。",
          "anyOf": [
            {
              "properties": {
                "merged": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "cut": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "omittedBytes": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "byReason": {
                  "properties": {
                    "frame_too_long": {
                      "minimum": 1
                    }
                  }
                }
              }
            }
          ]
        },
        "raw": {
          "$ref": "#/$defs/RawResponse"
        },
        "inputCalibration": {
          "$ref": "#/$defs/InputCalibration"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/ResponseFactsConstraints"
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "complete",
                "truncated",
                "interrupted"
              ]
            }
          }
        }
      ],
      "description": "完整待提交回复事实，唯一不含 replyDisposition 和 late；不是可保存的 ModelResponse。"
    },
    "CountingBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "model",
        "provider",
        "tokenizerRevision",
        "meterRevision",
        "projectionRevision",
        "replayRevision",
        "transformRevision"
      ],
      "properties": {
        "binding": {
          "$ref": "../../model-profile/v5/model-profile.schema.json#/$defs/ModelAdaptationBinding"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "tokenizerRevision": {
          "type": "string",
          "minLength": 1
        },
        "meterRevision": {
          "type": "string",
          "minLength": 1
        },
        "projectionRevision": {
          "type": "string",
          "minLength": 1
        },
        "replayRevision": {
          "type": "string",
          "minLength": 1
        },
        "transformRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RequestInputEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "projectionRevision",
            "prefixBoundary",
            "prefixDigest",
            "inputEnvelopeDigest",
            "countingBasis"
          ],
          "properties": {
            "kind": {
              "const": "known"
            },
            "projectionRevision": {
              "type": "string",
              "minLength": 1
            },
            "prefixBoundary": {
              "type": "integer",
              "minimum": 0
            },
            "prefixDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "inputEnvelopeDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "countingBasis": {
              "$ref": "#/$defs/CountingBasis"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "not_retained",
                "not_sent",
                "send_unknown"
              ]
            }
          }
        }
      ]
    },
    "ObservationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterRevision",
        "fieldPaths"
      ],
      "properties": {
        "adapterRevision": {
          "type": "string",
          "minLength": 1
        },
        "fieldPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "upstreamRequestId": {
          "type": "string",
          "minLength": 1
        },
        "upstreamModel": {
          "type": "string",
          "minLength": 1
        },
        "servingProvider": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ObservedInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "provenance"
          ],
          "properties": {
            "kind": {
              "const": "from_usage"
            },
            "provenance": {
              "$ref": "#/$defs/ObservationProvenance"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tokens",
            "provenance"
          ],
          "properties": {
            "kind": {
              "const": "upstream_total"
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            },
            "provenance": {
              "$ref": "#/$defs/ObservationProvenance"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "missing_usage",
                "response_cache",
                "inconsistent_usage",
                "scope_unknown",
                "not_sent",
                "send_unknown"
              ]
            }
          }
        }
      ]
    },
    "OutputGroupEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "blockDigests",
            "completeness",
            "usageRef"
          ],
          "properties": {
            "kind": {
              "const": "known"
            },
            "source": {
              "enum": [
                "reply",
                "delivered",
                "none"
              ]
            },
            "blockDigests": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "completeness": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "usageRef": {
              "const": "usage"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "not_retained",
                "not_sent",
                "send_unknown"
              ]
            }
          }
        }
      ]
    },
    "InputCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestInput",
        "observedInput",
        "outputGroup"
      ],
      "properties": {
        "requestInput": {
          "$ref": "#/$defs/RequestInputEvidence"
        },
        "observedInput": {
          "$ref": "#/$defs/ObservedInput"
        },
        "outputGroup": {
          "$ref": "#/$defs/OutputGroupEvidence"
        }
      }
    }
  }
}
