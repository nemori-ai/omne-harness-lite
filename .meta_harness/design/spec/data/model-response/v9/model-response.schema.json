{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/model-response/v9/model-response.schema.json",
  "title": "data.model-response v9",
  "description": "已确认请求责任的完整响应记录：回复（若有）、已交付部分、用量与费用、路由留痕、收场、故障成因与原样状态码、时序及上游原始响应的引用。每份已确认责任恰好留一条，含锚点后发送前取消；记录存在不证明实际发送。根模式约束一条 ModelResponse。条款编号 S-n 指同目录的 contract.md，仅在 data.model-response/v9 内有效。",
  "$comment": "MR8 candidate：interrupted 持久响应可显式 sentAt:null；真实锚点与事实来源由写入者证明。PendingModelResponse 必须实际 sentAt。其余约束与精确依赖沿 MR7。",
  "$ref": "#/$defs/ModelResponse",
  "$defs": {
    "ResponseId": {
      "title": "响应体标识（contract.md S-6）",
      "description": "一条模型响应体的标识，家在本契约。不透明、部署内唯一，不回收、不复用；由模型请求运行时在写这一次发出的「已出门」记录时铸，此后写这条响应体的任何一方（运行时、调用方、停机之后的对账）都沿用它（S-6）。交换表示按 data.identity-values/v1#S-31 的散文自定义：非空字符串，首字符与末字符都不属于 S-31 列出的那个显式空白码点集合，相等是逐码点精确相等。它不是上游的请求 id（那是 Route.upstreamRequestId），也不从上游 id 推出。data.messages 的 AssistantMessage.response 与 data.call-accounts 的 CostCorrection 指的都是它。",
      "$comment": "不 $ref identity-values 的 OpaqueIdentifier：那一项的说明限它自己的文件复用。pattern 照 S-31 的码点表写出，与那边逐字相同的理由也相同——不用 \\s 与 $（两种引擎集合不同、Python 的 $ 匹配到末尾换行之前），改用显式否定字符类与 (?![\\s\\S]) 绝对结尾。",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])",
      "examples": [
        "resp_4c1e9a"
      ]
    },
    "RunId": {
      "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/RunId",
      "title": "运行标识（contract.md S-7）",
      "description": "这次调用所属的那次运行（UL-run）。定义的家在 data.call-accounts/v2（它按尝试记明细、按 Run 汇总本就需要）；本契约只引用。"
    },
    "AttemptId": {
      "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/AttemptId",
      "title": "执行尝试序号（contract.md S-7）",
      "description": "这一次发出在它那次运行的第几次执行尝试里出门，整数、从 1 起；与 call.runId 合起来才是一次尝试的身份（UL-run-attempt：身份是 (哪次运行, 第几次)，不另存一份）。它属于每一次发出，不属于调用——一次调用可以跨尝试（S-8）。它是出门所在尝试的事实，不是这笔账的归属：归属的权威是承载本条的记录条目（data.call-accounts/v2#S-25）。定义的家在 data.call-accounts/v2；本契约只引用。"
    },
    "ModelCallId": {
      "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/ModelCallId",
      "title": "模型调用标识（contract.md S-7）",
      "description": "这条响应体属于哪一次模型调用（UL-model-call）。定义的家在 data.call-accounts/v2；本契约只引用。它不是工具调用的 CallId。"
    },
    "ReplyDisposition": {
      "title": "回复有没有成为消息（contract.md S-14）",
      "description": "凡 reply 存在即必带，reply 缺席即不带（S-14）。persisted：这份回复落盘成了会话日志里的一条消息；{vetoed}：它在「消息落盘之前」被否决、没有成为消息——by 是否决它的那件拓展件（含转换件）的名字，reason 是它给出的理由（有就带）；{consumed}：它被系统拿去用了、本来就不成为消息——by 是拿去用的那件事（compaction 压缩摘要、side_query 旁路提问），账照记。三者都不改变收场，这次调用照样结束；要再试，是 loop 另起的一次新的模型调用（新的 callId）——首 token 之后不许重发这条规则没有例外（S-14、S-17、S-23）。",
      "oneOf": [
        {
          "title": "落盘成了消息",
          "const": "persisted"
        },
        {
          "title": "落盘之前被否决",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vetoed"
          ],
          "properties": {
            "vetoed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "by"
              ],
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "title": "被系统拿去用了",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumed"
          ],
          "properties": {
            "consumed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "by"
              ],
              "properties": {
                "by": {
                  "enum": [
                    "compaction",
                    "side_query"
                  ]
                }
              }
            }
          }
        }
      ],
      "examples": [
        "persisted",
        {
          "vetoed": {
            "by": "image-transcriber",
            "reason": "no transcript produced"
          }
        },
        {
          "consumed": {
            "by": "compaction"
          }
        }
      ]
    },
    "ModelCallRef": {
      "title": "所属的那次模型调用（contract.md S-7）",
      "description": "callId 必有，没有默认值，不从环境补齐；它在一份会话日志内指认恰一次模型调用。runId 在这次调用属于某个运行时必有、在它不属于任何运行（归会话）时必无——缺席是一条断言，不是「不知道」（S-7）。这一次发出落在哪次尝试不在这里，在 ModelResponse.attemptId（S-8）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callId"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/RunId"
        },
        "callId": {
          "$ref": "#/$defs/ModelCallId"
        }
      },
      "examples": [
        {
          "runId": "run_7a02",
          "callId": "mc_19f3"
        },
        {
          "callId": "mc_19f4"
        }
      ]
    },
    "SelectedBy": {
      "title": "有效模型怎么来的（contract.md S-10）",
      "description": "有效模型那个路由名从哪来（S-10）。session：取自会话的选中模型，会话格之上没有带不可覆盖标记的一格压过它（含从没切换过、取自设置沿层级求值的那个名字）；layer_lock：会话格之上有一格带不可覆盖标记，名字取自那一格；{extension}：调模型之前的拓展件以 select_model 定了这一次，extension 是那件拓展件的名字。取「最后一个定下这一次那个名字的那一步」；名字落到哪一行由按层覆盖定，落到的那一行是 route.profile。",
      "oneOf": [
        {
          "title": "会话选中的那条",
          "const": "session"
        },
        {
          "title": "层级求值被上层锁死成的那条",
          "const": "layer_lock"
        },
        {
          "title": "调模型之前的拓展件定的",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extension"
          ],
          "properties": {
            "extension": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "examples": [
        "session",
        "layer_lock",
        {
          "extension": "cheap-first-router"
        }
      ]
    },
    "CredentialScope": {
      "title": "这一次发出用的凭据在哪一格（contract.md S-9）",
      "description": "factory：出厂格那一把，由部署装配配置，只供官方档案（S-9）；否则是租户格，取 data.identity-values 的 ScopeLayerIdentity 的租户那一支。模型凭据只在租户层与出厂格（PF-013 rev 10 裁决 33），没有组织那一支。用量记在这一格头上（data.call-accounts/v2#S-38）。它不是凭据本身，也不是凭据的引用。",
      "$comment": "ScopeLayerIdentity 刻意不含出厂那一格（identity-values S-11），所以本契约在它之外加一支 {layer: factory}，不带身份值；token factory 与 data.asset-model HoldingScope.layer 同词。租户那一支 $ref ScopeLayerIdentity 再把 layer 限为 tenant，形状仍归 identity-values，不另写一份。",
      "oneOf": [
        {
          "title": "出厂格",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layer"
          ],
          "properties": {
            "layer": {
              "const": "factory"
            }
          }
        },
        {
          "title": "租户格",
          "allOf": [
            {
              "$ref": "../../identity-values/v1/identity-values.schema.json#/$defs/ScopeLayerIdentity"
            },
            {
              "properties": {
                "layer": {
                  "const": "tenant"
                }
              }
            }
          ]
        }
      ],
      "examples": [
        {
          "layer": "factory"
        },
        {
          "layer": "tenant",
          "tenant": {
            "organization": "org_7fd2c1",
            "account": "acc_91ab40"
          }
        }
      ]
    },
    "Route": {
      "title": "路由留痕（contract.md S-9～S-11）",
      "description": "这一次发出实际用了谁：有效模型、它在调用打开那一刻的快照、它怎么来的、走的那一家、用的凭据在哪一格、上游回报的模型名与请求 id、实际发出的参数、改了值再发出的那些项与没发出去的那些项。 完整模型适配绑定与上游报告的实际执行方分别留存。",
      "$comment": "跨成员而 Schema 管不到的（S-26）：provider 在 profileSnapshot.providers 里、第一次发出是第一家、不许回退时恒是第一家；droppedParameters 的名字不在 parameters 里、parameterAdjustments 的名字在 parameters 里且 sent 等于那一项、一个项名只出现一次。出厂格凭据只配官方档案这一条 Schema 管得到，写在 ModelResponse.allOf。 S-36 的两个跨字段相等关系不由 Schema 保证；S-37 servingProvider 的来源不由字符串形状保证。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profileSnapshot",
        "selectedBy",
        "provider",
        "credentialScope",
        "parameters",
        "adaptation"
      ],
      "properties": {
        "profile": {
          "$ref": "../../model-profile/v5/model-profile.schema.json#/$defs/ModelProfileRef",
          "description": "这一次的有效模型（UL-effective-model）。"
        },
        "profileSnapshot": {
          "$ref": "../../model-profile/v5/model-profile.schema.json#/$defs/ModelProfileSnapshot",
          "description": "这次调用打开时绑定的那条档案在那一刻的副本：发出与重试消费的那些属性与 updatedAt（S-9）。档案后来改了，这里不变。"
        },
        "selectedBy": {
          "$ref": "#/$defs/SelectedBy"
        },
        "provider": {
          "$ref": "../../model-profile/v5/model-profile.schema.json#/$defs/ProviderName",
          "description": "本层为这一次发出指定的那一家；每一次发出只走一家（S-24）。它在 profileSnapshot.providers 里；dispatch = 1 时是第一家；profileSnapshot.allowFallback = false 时恒是第一家（S-9，data.model-profile/v5#S-5、#S-6）——跨成员，Schema 不管。"
        },
        "credentialScope": {
          "$ref": "#/$defs/CredentialScope"
        },
        "upstreamModel": {
          "type": "string",
          "minLength": 1,
          "description": "上游回报的模型名，原样。上游没有回报时缺席；不得以路由名或档案里的任何名字填充（S-9）。"
        },
        "upstreamRequestId": {
          "type": "string",
          "minLength": 1,
          "description": "上游给这次请求的 id（OpenRouter 的 generation id），原样，用于事后对账。上游没给时缺席。"
        },
        "parameters": {
          "$ref": "../../model-profile/v5/model-profile.schema.json#/$defs/ModelRequestParameters",
          "description": "这一次实际发给上游的那一组请求参数，以统一词表表示：按原值发出的项记原值，改了值再发出的项记实际发出的值，没发出的项不在这里（S-11）。译成上游的字段名不是改值。一项都没发出时是 {}。"
        },
        "parameterAdjustments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ParameterAdjustment"
          },
          "description": "传输适配改了值再发出的那些项（S-11）。缺席即一项值也没改；空数组不是合法写法。每项的 name 都在 parameters 里、sent 等于 parameters 里那一项的值、一个项名只出现一次——跨成员，Schema 不管。"
        },
        "droppedParameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "要求的那一组里没有发给上游的那些项的名字（S-11）：统一项以成员名为名，extra 项以它的键为名（data.model-profile/v5#S-20），两者一视同仁。缺席即一项也没丢；空数组不是合法写法。这些名字都不在 parameters 里——跨成员，Schema 不管。"
        },
        "adaptation": {
          "$ref": "../../model-profile/v5/model-profile.schema.json#/$defs/ModelAdaptationBinding",
          "description": "S-36：调用绑定的完整值，与 profileSnapshot.adaptation 精确相等，definition.modelId 与 profile.routeName 逐码点相等；Schema 之后执行纯判定。"
        },
        "servingProvider": {
          "type": "string",
          "minLength": 1,
          "description": "S-37：上游报告的实际执行方，非空原串。未报告时缺席，不以请求的 provider 或模型档案填充；不一致时两者分别保留。"
        }
      }
    },
    "ParameterAdjustment": {
      "title": "改了值再发出的一项（contract.md S-11）",
      "description": "name 是项名（data.model-profile/v5#S-20：统一项以成员名为名，extra 项以它的键为名）；requested 是它在要求的那一组（档案参数经本次覆盖合并之后）里的值；sent 是实际发出的值，等于 Route.parameters 里这一项的值，且与 requested 不同。统一项的 sent 必须在那一项的取值域里（它也出现在 parameters 里）；extra 项的两个值是任意 JSON。",
      "$comment": "requested 与 sent 不按项名分别收窄取值域：那要按 name 逐项写条件，而 sent 的取值域已由 Route.parameters 管住；requested 的取值域在它进入要求的那一组之前已由 data.model-profile/v5#S-24 校验过。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "requested",
        "sent"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requested": {},
        "sent": {}
      },
      "examples": [
        {
          "name": "reasoningEffort",
          "requested": "max",
          "sent": "high"
        },
        {
          "name": "maxOutputTokens",
          "requested": 8192,
          "sent": 4096
        }
      ]
    },
    "ResponseOutcome": {
      "title": "这一次发出的收场（contract.md S-12）",
      "description": "complete 正常收尾；truncated 写到输出上限（主路径走完了，不是非常态）；interrupted 用户中断（控制动作，不是故障，不带成因）；failed 这一次发出出了故障。闭合枚举，未知取值一律拒绝（outcome_unknown）。",
      "type": "string",
      "enum": [
        "complete",
        "truncated",
        "interrupted",
        "failed"
      ]
    },
    "UpstreamError": {
      "title": "上游错误原文（contract.md S-15）",
      "description": "上游在错误里给出的东西，脱敏之后原样（S-21）。code 与 message 不翻译；raw 是上游错误体的原样 JSON。三项都没有就不写这个成员。",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "raw": {}
      }
    },
    "Failure": {
      "title": "故障（contract.md S-15）",
      "description": "cause 取八个成因之一，定义与名字归 data.loop-extension 的 FailureCause，本契约只引用；statusCode 是上游返回的状态码，原样、不翻译，没有就缺席（缺席不是 0）：HTTP 层失败时是 HTTP 状态，流已开始之后的带内错误是带内错误的 code、此时带 inBand: true（inBand 只取 true、只能与 statusCode 同在，缺席即 statusCode 是 HTTP 状态）；upstreamError 见其定义；localError 是本层自己出的错（传输适配报错、解不开上游的回应），脱敏之后原样，没有就缺席。cause 为 unrecognized 时，statusCode、upstreamError、localError 与响应体的 raw 至少有其一（S-15）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause"
      ],
      "properties": {
        "cause": {
          "$ref": "../../loop-extension/v6/loop-extension.schema.json#/$defs/FailureCause",
          "$comment": "取值不在八个之内：cause_unknown（S-27）。withdrawn / scope_disallowed / modality_mismatch 三个值形状上放过，但按 S-16 不出现在任何一条响应体上——那是判定层的约束，Schema 不管。"
        },
        "statusCode": {
          "type": "integer"
        },
        "inBand": {
          "const": true
        },
        "upstreamError": {
          "$ref": "#/$defs/UpstreamError"
        },
        "localError": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "inBand": [
          "statusCode"
        ]
      }
    },
    "Timing": {
      "title": "时序（contract.md S-17）",
      "description": "sentAt 必有，实际交给传输的时刻或 null（实际时刻不可用，不断言未发出）；首 token 缺席仍须确知，所有实际时刻须满足 S-17 顺序。Schema 不证明锚点/来源/时序比较。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentAt",
        "endedAt"
      ],
      "properties": {
        "sentAt": {
          "oneOf": [
            {
              "$ref": "../../offer-expiry/v1/offer-expiry.schema.json#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "firstTokenAt": {
          "$ref": "../../offer-expiry/v1/offer-expiry.schema.json#/$defs/Instant"
        },
        "endedAt": {
          "$ref": "../../offer-expiry/v1/offer-expiry.schema.json#/$defs/Instant"
        }
      }
    },
    "RawHeaders": {
      "title": "上游响应头的 JSON 表示（contract.md S-20）",
      "description": "采得且脱敏后的头对象；值保持字符串或有序字符串数组原形，数组的次序、重复和空字符串均保留。允许空字符串、空数组与空对象，各自区别于缺席；不规定头名规范化或同名合并。Schema 只约束值域，不证明实际采集、脱敏或留存原样。",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "RawResponse": {
      "title": "上游原始响应留存（contract.md S-20）",
      "description": "排查用，不进给模型的上下文，也不进任何面向人的呈现。headers 是上游响应头，脱敏之后原样，不得含凭据（S-21）；body 是上游原始响应的字节存进附件存储之后的引用，保留期是设置项，过期清理之后引用可能取不到（S-20）。两项都没有就不写这个成员。它是模型响应体身上的一项属性，不另立词条。",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "headers": {
          "$ref": "#/$defs/RawHeaders"
        },
        "body": {
          "$ref": "../../content-blocks/v3/content-blocks.schema.json#/$defs/AttachmentRef"
        }
      }
    },
    "ModelResponse": {
      "title": "一次发出的完整响应体（contract.md S-1、S-4）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "call",
        "dispatch",
        "route",
        "outcome",
        "timing",
        "usage",
        "cost",
        "inputCalibration"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ResponseId"
        },
        "call": {
          "$ref": "#/$defs/ModelCallRef"
        },
        "dispatch": {
          "type": "integer",
          "minimum": 1,
          "description": "这是该次调用的第几次发出，从 1 起、逐次加一、跨尝试连续（S-8）。小于 1：dispatch_zero。",
          "$comment": "整数但小于 1：dispatch_zero；不是整数：malformed（S-27）。"
        },
        "attemptId": {
          "$ref": "#/$defs/AttemptId",
          "description": "这一次发出在那次运行的第几次执行尝试里出门（S-8）。call.runId 在则必有、不在则必无。它不是归属：这笔账归哪次尝试以承载本条的条目为准。"
        },
        "late": {
          "const": true,
          "description": "这一条写下时，这一次发出所在的那次尝试已被栅栏关掉——被新的一次尝试取代，或它所在的运行已经终结（S-35，data.call-accounts/v2#S-39）。只取 true；缺席即不晚。只在带 call.runId 的那一条上出现。",
          "$comment": "不是 true（含 false）：malformed。出现在不带 call.runId 的那一条上：malformed（allOf 里标 malformed 的一支）。"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "outcome": {
          "$ref": "#/$defs/ResponseOutcome"
        },
        "initiator": {
          "enum": [
            "user",
            "run_cancelled",
            "runtime_lost"
          ],
          "description": "谁中断了这一次发出，只在 outcome 为 interrupted 时出现、且在那里必有（S-12）：user 用户中断了这次调用；run_cancelled 这次调用所在的运行被取消或它的宿主停下、被撤下——系统发起的这几种在途的流被放弃、不带 reply，只有用户取消运行时才可能带 reply（S-13，Schema 管不到）；runtime_lost 失去了连续性、由恢复时的对账补写。"
        },
        "stopReason": {
          "type": "string",
          "minLength": 1,
          "description": "上游原样的 finish / stop reason，不翻译；上游没给时缺席。消费者不得据它推断收场，收场只看 outcome（S-12）。"
        },
        "reply": {
          "$ref": "../../messages/v6/messages.schema.json#/$defs/AssistantMessage",
          "description": "这一次拿回来的那份回复（S-14）。它成没成为消息看 replyDisposition。它的 response 成员必须等于本响应体的 id（跨字段，Schema 不管）。"
        },
        "replyDisposition": {
          "$ref": "#/$defs/ReplyDisposition"
        },
        "delivered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../../content-blocks/v3/content-blocks.schema.json#/$defs/ContentBlock"
          },
          "description": "开了口却没有回复的那一次，已交付、不成为消息的那部分：首 token 之后的故障，或开了口之后被中断而没有交出回复（S-14）。缺席即没有；空数组不是合法写法。"
        },
        "failure": {
          "$ref": "#/$defs/Failure"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "usage": {
          "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/Usage"
        },
        "cost": {
          "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/Cost"
        },
        "trims": {
          "$ref": "../../call-accounts/v2/call-accounts.schema.json#/$defs/TrimSummary",
          "description": "这一次发出的流上合并与截掉的汇总（S-19）。缺席即一次也没砍；全零的汇总不是合法写法。",
          "$comment": "全零即没砍，只有缺席这一种写法：四个计数里至少一个大于零（截短单个增量只计在 byReason.frame_too_long 与 omittedBytes 里，不计 merged、cut）。",
          "anyOf": [
            {
              "properties": {
                "merged": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "cut": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "omittedBytes": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "byReason": {
                  "properties": {
                    "frame_too_long": {
                      "minimum": 1
                    }
                  }
                }
              }
            }
          ]
        },
        "raw": {
          "$ref": "#/$defs/RawResponse"
        },
        "inputCalibration": {
          "$ref": "#/$defs/InputCalibration"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/ResponseFactsConstraints"
        },
        {
          "$comment": "malformed（跨成员，无专名，contract.md S-27）：凡 reply 存在即必带 replyDisposition。",
          "if": {
            "required": [
              "reply"
            ]
          },
          "then": {
            "required": [
              "replyDisposition"
            ]
          }
        },
        {
          "$comment": "malformed（跨成员，无专名）：没有 reply 就不带 replyDisposition。",
          "if": {
            "not": {
              "required": [
                "reply"
              ]
            }
          },
          "then": {
            "not": {
              "required": [
                "replyDisposition"
              ]
            }
          }
        },
        {
          "$comment": "malformed（跨成员，无专名）：late 只在带 call.runId 的那一条上——不属于任何运行的调用没有尝试可被栅栏关掉（S-35）。",
          "if": {
            "required": [
              "late"
            ]
          },
          "then": {
            "properties": {
              "call": {
                "required": [
                  "runId"
                ]
              }
            },
            "required": [
              "call"
            ]
          }
        }
      ]
    },
    "ResponseFactsConstraints": {
      "$comment": "同 owner 共用约束；不单独作为公开输入形状，S-13/S-17/S-27。",
      "allOf": [
        {
          "$comment": "reply_missing：complete / truncated 必带 reply（S-13 第一、二行）。",
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "complete",
                  "truncated"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "reply"
            ]
          }
        },
        {
          "$comment": "reply_on_failure：failed 不带 reply（S-13 最后两行）。",
          "if": {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
                "reply"
              ]
            }
          }
        },
        {
          "$comment": "reply_and_delivered：reply 与 delivered 互斥（S-14）。",
          "not": {
            "required": [
              "reply",
              "delivered"
            ]
          }
        },
        {
          "$comment": "failure_missing：failed 必带 failure（S-13）。",
          "if": {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "failure"
            ]
          }
        },
        {
          "$comment": "failure_on_interrupted：interrupted 不带 failure——用户中断不是故障，不带成因（S-12、S-13）。",
          "if": {
            "properties": {
              "outcome": {
                "const": "interrupted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
                "failure"
              ]
            }
          }
        },
        {
          "$comment": "failure_on_success：complete / truncated 不带 failure——主路径走完了，回复在落盘之前被否决也不例外（那记在 replyDisposition 上，S-13、S-14）。",
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "complete",
                  "truncated"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
                "failure"
              ]
            }
          }
        },
        {
          "$comment": "reply_ending_mismatch：reply.ending 与收场一一对应（S-13）。三支，任一支不成立即此值。",
          "allOf": [
            {
              "$comment": "complete ↔ complete。",
              "if": {
                "properties": {
                  "outcome": {
                    "const": "complete"
                  }
                },
                "required": [
                  "outcome",
                  "reply"
                ]
              },
              "then": {
                "properties": {
                  "reply": {
                    "properties": {
                      "ending": {
                        "const": "complete"
                      }
                    }
                  }
                }
              }
            },
            {
              "$comment": "truncated ↔ truncated_at_limit。",
              "if": {
                "properties": {
                  "outcome": {
                    "const": "truncated"
                  }
                },
                "required": [
                  "outcome",
                  "reply"
                ]
              },
              "then": {
                "properties": {
                  "reply": {
                    "properties": {
                      "ending": {
                        "const": "truncated_at_limit"
                      }
                    }
                  }
                }
              }
            },
            {
              "$comment": "interrupted ↔ interrupted_by_user。",
              "if": {
                "properties": {
                  "outcome": {
                    "const": "interrupted"
                  }
                },
                "required": [
                  "outcome",
                  "reply"
                ]
              },
              "then": {
                "properties": {
                  "reply": {
                    "properties": {
                      "ending": {
                        "const": "interrupted_by_user"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "$comment": "first_token_inconsistent：firstTokenAt 的有无与收场、回复、已交付部分或成因对不上（S-13、S-17）。五支，任一支不成立即此值。被中断而没有回复的那一次可以有首 token（开了口之后被中断、或失去连续性），原来的第六支因此删去。",
          "allOf": [
            {
              "$comment": "① 成因是 interrupted_mid_reply ⇒ 有 firstTokenAt。",
              "if": {
                "properties": {
                  "failure": {
                    "properties": {
                      "cause": {
                        "const": "interrupted_mid_reply"
                      }
                    },
                    "required": [
                      "cause"
                    ]
                  }
                },
                "required": [
                  "failure"
                ]
              },
              "then": {
                "properties": {
                  "timing": {
                    "required": [
                      "firstTokenAt"
                    ]
                  }
                }
              }
            },
            {
              "$comment": "② failed 且有 firstTokenAt ⇒ 成因是 interrupted_mid_reply（「已经开口说话了」优先于其余各类）。",
              "if": {
                "properties": {
                  "outcome": {
                    "const": "failed"
                  },
                  "timing": {
                    "required": [
                      "firstTokenAt"
                    ]
                  }
                },
                "required": [
                  "outcome",
                  "timing"
                ]
              },
              "then": {
                "properties": {
                  "failure": {
                    "properties": {
                      "cause": {
                        "const": "interrupted_mid_reply"
                      }
                    }
                  }
                }
              }
            },
            {
              "$comment": "③ failed 且有 firstTokenAt ⇒ 有 delivered（开了口就有已交付的东西，必须留在账里）。",
              "if": {
                "properties": {
                  "outcome": {
                    "const": "failed"
                  },
                  "timing": {
                    "required": [
                      "firstTokenAt"
                    ]
                  }
                },
                "required": [
                  "outcome",
                  "timing"
                ]
              },
              "then": {
                "required": [
                  "delivered"
                ]
              }
            },
            {
              "$comment": "④ 有 reply ⇒ 有 firstTokenAt。",
              "if": {
                "required": [
                  "reply"
                ]
              },
              "then": {
                "properties": {
                  "timing": {
                    "required": [
                      "firstTokenAt"
                    ]
                  }
                }
              }
            },
            {
              "$comment": "⑤ 有 delivered ⇒ 有 firstTokenAt。",
              "if": {
                "required": [
                  "delivered"
                ]
              },
              "then": {
                "properties": {
                  "timing": {
                    "required": [
                      "firstTokenAt"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "$comment": "malformed（跨成员，无专名）：initiator 在 interrupted 上必有、在别处必无（S-12）。",
          "if": {
            "properties": {
              "outcome": {
                "const": "interrupted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "initiator"
            ]
          },
          "else": {
            "not": {
              "required": [
                "initiator"
              ]
            }
          }
        },
        {
          "$comment": "malformed（跨成员，无专名）：失去连续性补写的那一条没有回复——没有人还拿着它（S-13）。",
          "if": {
            "properties": {
              "initiator": {
                "const": "runtime_lost"
              }
            },
            "required": [
              "initiator"
            ]
          },
          "then": {
            "not": {
              "required": [
                "reply"
              ]
            }
          }
        },
        {
          "$comment": "malformed（跨成员，无专名）：attemptId 与 call.runId 同在同缺（S-7、S-8）。",
          "if": {
            "properties": {
              "call": {
                "required": [
                  "runId"
                ]
              }
            },
            "required": [
              "call"
            ]
          },
          "then": {
            "required": [
              "attemptId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "attemptId"
              ]
            }
          }
        },
        {
          "$comment": "malformed（跨成员，无专名）：凭据记在出厂格时，有效模型必须是官方档案——出厂格那一把只供官方档案（S-9；capability.model-request-runtime v2 S-19）。",
          "if": {
            "properties": {
              "route": {
                "properties": {
                  "credentialScope": {
                    "properties": {
                      "layer": {
                        "const": "factory"
                      }
                    },
                    "required": [
                      "layer"
                    ]
                  }
                },
                "required": [
                  "credentialScope"
                ]
              }
            },
            "required": [
              "route"
            ]
          },
          "then": {
            "properties": {
              "route": {
                "properties": {
                  "profile": {
                    "properties": {
                      "origin": {
                        "const": "official"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "malformed（跨成员，无专名）：成因是 unrecognized 时必带认不出来的那样东西（S-15）。",
          "if": {
            "properties": {
              "failure": {
                "properties": {
                  "cause": {
                    "const": "unrecognized"
                  }
                },
                "required": [
                  "cause"
                ]
              }
            },
            "required": [
              "failure"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "raw"
                ]
              },
              {
                "properties": {
                  "failure": {
                    "anyOf": [
                      {
                        "required": [
                          "statusCode"
                        ]
                      },
                      {
                        "required": [
                          "upstreamError"
                        ]
                      },
                      {
                        "required": [
                          "localError"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "$comment": "S-17：只有 interrupted 持久分支允许 null；无专名跨成员拒绝 malformed，顺序沿 S-27。",
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "complete",
                  "truncated",
                  "failed"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "timing": {
                "properties": {
                  "sentAt": {
                    "$ref": "../../offer-expiry/v1/offer-expiry.schema.json#/$defs/Instant"
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "S-42 from_usage requires three known disjoint input components, from upstream.",
          "if": {
            "properties": {
              "inputCalibration": {
                "properties": {
                  "observedInput": {
                    "properties": {
                      "kind": {
                        "const": "from_usage"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "usage": {
                "properties": {
                  "source": {
                    "const": "upstream"
                  },
                  "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_read_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_write_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "S-42 upstream_total is the sole input authority only when at least one CA2 input component is unknown.",
          "if": {
            "properties": {
              "inputCalibration": {
                "properties": {
                  "observedInput": {
                    "properties": {
                      "kind": {
                        "const": "upstream_total"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "usage": {
                "anyOf": [
                  {
                    "properties": {
                      "input_tokens": {
                        "const": "unknown"
                      }
                    }
                  },
                  {
                    "properties": {
                      "cache_read_tokens": {
                        "const": "unknown"
                      }
                    }
                  },
                  {
                    "properties": {
                      "cache_write_tokens": {
                        "const": "unknown"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
