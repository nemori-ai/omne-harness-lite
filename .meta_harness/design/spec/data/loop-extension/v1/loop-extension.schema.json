{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/loop-extension/v1/loop-extension.schema.json",
  "title": "data.loop-extension v1",
  "description": "拓展点协议的数据半边：十一个位置与两个维度、干预力三档、报错处置策略、拓展件的声明、运行时交给拓展件的输入、拓展件交回的结论（封闭八种）与结论落日志的记录形状。本文件只登记共享定义，由消费者以 $ref 引用；根模式不约束任何文档。条款编号 S-n 指同目录的 contract.md，仅在 data.loop-extension/v1 内有效。",
  "$comment": "状态 candidate，未接受、未冻结。Schema 只管形状与两张合法组合表（档 × 结论、位置 × 结论），表在 Conclusion 的条件约束里；「rewrite 只改可改成员」「inject 的来源名等于本件名」「select_model 在合法目标集合里」「retry 不推翻事实三类」这些要么需要输入与输出两份实例对照，要么是判定，Schema 管不到，归 contract.md 的条款与 runner 能力。引用的 content-blocks、messages、model-profile、call-accounts、tool-definition、asset-model 都是同一棵设计树里的候选，$ref 目标以它们 v1 的 $defs 为准，见 verification.md「变化的影响」；运行与执行尝试的标识 RunId、AttemptId 的家在 data.call-accounts，本文件只引。正反实例在同目录 examples.md。",

  "$defs": {

    "LoopPosition": {
      "title": "Loop 拓展点 · Loop Extension Point",
      "description": "S-1：十一个位置，按位置命名、不按功能命名；闭合枚举。每个 token 是 PF-012 §5.8 位置表里的一行：attempt_started 尝试开始之后；before_persist_message / after_persist_message 消息落盘之前 / 之后；before_compaction / after_compaction 压缩之前 / 之后；before_model_call / after_model_call 调模型之前 / 之后；before_action / after_action 执行动作之前 / 之后；before_terminal / after_terminal 落终态之前 / 之后。「尝试开始之前」不开（归 PF-015），不在枚举里。",
      "$comment": "未知取值即表示层拒绝值 position_unknown（S-37）。维度不是第十二个位置（S-2）。",
      "type": "string",
      "enum": [
        "attempt_started",
        "before_persist_message",
        "after_persist_message",
        "before_compaction",
        "after_compaction",
        "before_model_call",
        "after_model_call",
        "before_action",
        "after_action",
        "before_terminal",
        "after_terminal"
      ]
    },

    "Dimension": {
      "title": "Dimension",
      "description": "S-2：两个位置上的筛选条件，不是又一个位置。after_model_call 的收场维度 ending ∈ complete_reply（完整回复）/ failure（失败）；after_action 的范围维度 scope ∈ each（这一个）/ batch（这一批全齐）。它是规格层的形状名，不是统一语言词条。",
      "$comment": "哪一种维度配哪个位置由使用它的三处（LoopExtensionDefinition、ExtensionInput、Conclusion）各自的条件约束判定：那两个位置缺维度是 dimension_missing，别的位置给了维度、或给了不属于该位置的那一种是 dimension_not_allowed（S-37）。",
      "oneOf": [
        {
          "title": "调模型之后的收场",
          "type": "object",
          "properties": { "ending": { "enum": ["complete_reply", "failure"] } },
          "required": ["ending"],
          "additionalProperties": false
        },
        {
          "title": "执行动作之后的范围",
          "type": "object",
          "properties": { "scope": { "enum": ["each", "batch"] } },
          "required": ["scope"],
          "additionalProperties": false
        }
      ]
    },

    "Power": {
      "title": "干预力 · Intervention Power",
      "description": "S-4：干预力三档（PF-000 §4、PF-012 §5.8）：observe 只观察 / rewrite 可改写 / veto 可否决。没有「放宽」这一档。「落卡片等人」属于 veto，不是第四档。干预力是拓展件的一项权限，不是设置：定义里给的是这项权限的出厂值，各层只能收窄；Conclusion 里记的是这一次经过求得的那个值。",
      "$comment": "统一语言词条 UL-intervention-power（产品正文在 PF-000 §4）。未知取值即 power_unknown（S-37）。",
      "type": "string",
      "enum": ["observe", "rewrite", "veto"]
    },

    "ErrorPolicy": {
      "title": "ErrorPolicy",
      "description": "S-5：拓展件可用却运行时报错时这一次怎么处置。ignore：结论落日志，对 agent 没有任何效果（落下的是 observed）；record：结论落日志，并往日志追加一条以本件名义说「本件这一次没跑成」的系统提醒，下一次组装看得到它（落下的是 inject）；treat_as_veto：fail-closed——在五个「之前」的位置落 veto，在其余「之后」的位置落 stop{ terminal: failed }，即运行不再继续。缺席时按求得的干预力取默认：observe → ignore，rewrite → record，veto → treat_as_veto（PF-012 §5.8 干预力三档表的最后一列）。无论哪一种，处置本身都留在那条 Conclusion 里、可见。",
      "$comment": "三种策略落下什么是主线裁定（D-040 §S7 S7-b、S7-c）。onError 是这一件自己的声明，不是设置也不是权限，推出规则不出项（S-40）。record 只许 rewrite、veto 档声明，treat_as_veto 只许 veto 档声明（LoopExtensionDefinition 的条件约束）。after_terminal 上唯一合法的结论是 observed（S-21），三种策略在那里都落 observed。它们是规格层的策略 token，没有统一语言词条。",
      "type": "string",
      "enum": ["ignore", "record", "treat_as_veto"]
    },

    "UnavailabilityPolicy": {
      "title": "拓展件不可用处置 · Extension Unavailability Policy",
      "description": "S-6、S-31、S-33：一件拓展件此刻不在（依赖用不了、自己起不来）时，它站的那个位置这一次怎么办，恰三种：skip 跳过（视作已卸载，瀑布里没有它）；veto 否决（当它判了否决，拦住它站的那个状态点）；fallback 替换为指定挂件（系统预先声明的另一件挂件替它过这一次，只有系统自带的五件用、不经声明）。在声明里（LoopExtensionDefinition.unavailability）只收 skip 与 veto、缺席即 skip；在结论记录里（Conclusion.unavailability）是这一次实际采用的那一种。它是这一件自己的声明，不是设置也不是权限，各层不配值。",
      "$comment": "PF-012 §5.8（rev 12 起）、PF-002 §4「不可用处置是这一件自己的声明」（rev 20）、UL-extension-unavailability-policy。fallback 这个 token 是本契约对「替换为指定挂件」的取名。未知取值即 malformed（S-39）。",
      "type": "string",
      "enum": ["skip", "veto", "fallback"]
    },

    "LoopExtensionDefinition": {
      "title": "拓展件的声明 · Loop Extension",
      "description": "S-6～S-10：一件拓展件（UL-loop-extension，第八类资产）的声明。name 是它的能力标识（类别 loop_extension + name）里的那个 name，不是第二个身份：作为资产被持有时，身份只在资产记录的 capability 上（data.asset-model v1 S-10），两者逐码点相等，词法按 data.asset-model v1 S-2；position 与 dimension 是绑定类设置的出厂值，power 是干预力这项权限的出厂值（定义给默认值，各层配值、运行时求值）；onError 缺席按求得的干预力取默认；unavailability 是这一件不可用时的处置，只收 skip 与 veto、缺席即 skip，veto 只许声明的 power 为 veto 且 position 是五个「之前」之一（S-6）；onError 与 unavailability 都是这一件自己的声明，不是设置也不是权限；needs 是依赖声明，缺席即不需要任何东西；implementation 说它的实现是装配进来的（builtin）还是一条外部命令（command）。本版没有 order：同一位置的先后按装配清单的顺序。",
      "$comment": "additionalProperties: false 挡住 order、matcher 这类本版没有的成员（malformed）。策略不高于干预力：observe 只能声明 ignore，rewrite 不得声明 treat_as_veto——否则一件不能注入的件会在报错时注入、一件拦不住任何东西的件会在报错时拦下东西（malformed，S-5）。needs 用 minItems 1：「不需要任何东西」只有缺席这一种写法，不给空数组第二种写法。",
      "type": "object",
      "properties": {
        "name": { "$ref": "../../asset-model/v1/asset-model.schema.json#/$defs/CapabilityName" },
        "position": { "$ref": "#/$defs/LoopPosition" },
        "dimension": { "$ref": "#/$defs/Dimension" },
        "power": { "$ref": "#/$defs/Power" },
        "onError": { "$ref": "#/$defs/ErrorPolicy" },
        "unavailability": { "allOf": [{ "$ref": "#/$defs/UnavailabilityPolicy" }, { "enum": ["skip", "veto"] }] },
        "needs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../../tool-definition/v1/tool-definition.schema.json#/$defs/DependencyName" }
        },
        "implementation": { "$ref": "#/$defs/ExtensionImplementation" }
      },
      "required": ["name", "position", "power", "implementation"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "position": { "const": "after_model_call" } }, "required": ["position"] },
          "then": { "required": ["dimension"], "properties": { "dimension": { "required": ["ending"] } } }
        },
        {
          "if": { "properties": { "position": { "const": "after_action" } }, "required": ["position"] },
          "then": { "required": ["dimension"], "properties": { "dimension": { "required": ["scope"] } } }
        },
        {
          "if": { "properties": { "position": { "not": { "enum": ["after_model_call", "after_action"] } } }, "required": ["position"] },
          "then": { "not": { "required": ["dimension"] } }
        },
        {
          "if": { "properties": { "power": { "const": "observe" } }, "required": ["power"] },
          "then": { "properties": { "onError": { "enum": ["ignore"] } } }
        },
        {
          "if": { "properties": { "power": { "const": "rewrite" } }, "required": ["power"] },
          "then": { "properties": { "onError": { "enum": ["ignore", "record"] } } }
        },
        {
          "$comment": "S-6：声明 unavailability: veto 只许声明的 power 为 veto、position 是五个「之前」之一——「之后」的位置本来就没有可拦的，不收这个声明；拦不住东西的件不在时不得比在时权力更大（malformed）。",
          "if": { "properties": { "unavailability": { "const": "veto" } }, "required": ["unavailability"] },
          "then": { "properties": { "power": { "const": "veto" }, "position": { "enum": ["before_persist_message", "before_compaction", "before_model_call", "before_action", "before_terminal"] } } }
        }
      ]
    },

    "ExtensionImplementation": {
      "title": "ExtensionImplementation",
      "description": "S-8：实现恰两种。builtin——实现随部署装配进来、在进程内执行，builtinName 是装配清单里那件系统自带实现的名字（不透明，逐码点相等；它不是能力标识——拓展件的身份是资产记录上的 AssetDefinition.capability；名字怎么取、怎么解析不归本契约，归装配清单与 capability.loop-extension-runner S-6）；command——实现是一条外部命令（兼容件：Claude Code / Codex 的 command hook）：host 是那一家来源产品（不是 runner 语境里的宿主），dialect 是钉住的方言版本，event 是来源产品那一侧的事件名，command 是来源产品 handler 条目里的命令原样，matcher 原样、按那一家的方言求值（缺席即全匹配），timeout 缺席即那一家那一事件的默认。运行时只认本契约的统一输入与结论，command 件在两边翻译；事件映射表、定档依据、matcher 的求值与导入报告不在本契约（capability.hooks-import）。",
      "$comment": "主线裁定（D-040 §S15 S15-b：兼容件载荷的家）。event 不在 S15-b 列出的成员里，是本契约保留的：导入一侧靠它从映射表取这一事件的情形筛选与原生输入的造法，缺了它一件 command 件译不出来源产品的输入。旧的 native、compat 两个取值作废；host 与 kind 闭合，未知取值即 malformed。",
      "oneOf": [
        {
          "title": "装配进来的实现",
          "type": "object",
          "properties": {
            "kind": { "const": "builtin" },
            "builtinName": { "type": "string", "minLength": 1, "pattern": "^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])" }
          },
          "required": ["kind", "builtinName"],
          "additionalProperties": false
        },
        {
          "title": "外部命令",
          "type": "object",
          "properties": {
            "kind": { "const": "command" },
            "host": { "enum": ["claude_code", "codex"] },
            "dialect": { "type": "string", "minLength": 1, "pattern": "^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])" },
            "event": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "matcher": { "type": "string" },
            "timeout": { "$ref": "../../tool-definition/v1/tool-definition.schema.json#/$defs/Duration" }
          },
          "required": ["kind", "host", "dialect", "event", "command"],
          "additionalProperties": false
        }
      ]
    },

    "LogHandle": {
      "title": "LogHandle",
      "description": "S-12：会话日志的只读句柄，不透明。表示照 data.identity-values/v1#S-31 的规则：非空字符串，首尾不得是那张表里的空白码点，相等是逐码点精确相等，不解析。拿着它只能读，读面由 capability.loop-extension-runner v1 S-9 给；改日志的唯一办法是交回结论。它不是一份日志快照。",
      "$comment": "按 S-31 的散文在本契约内定义，不 $ref data.identity-values 的 OpaqueIdentifier（主线裁定，D-040 §S1 S1-a）。pattern 与 S-31 的空白码点表逐个一致，尾部用 (?![\\s\\S]) 判绝对结尾。运行与执行尝试的标识不在这里：它们取 data.call-accounts/v1 的 RunId、AttemptId（S-12）。",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])",
      "examples": ["log_77a0"]
    },

    "EnvironmentHandle": {
      "title": "EnvironmentHandle",
      "description": "S-41：这一次经过所在会话的执行环境句柄，不透明，按会话作用域。经它恰取得两样：调用方租户身份（这个会话持有的 TenantId）与这一会话的会话级执行环境（PF-005 §6.3）；经它取不到会话标识、别的会话或租户的东西、有没有运行在跑。表示照 data.identity-values/v1#S-31 的规则：非空字符串，首尾不得是那张表里的空白码点，相等是逐码点精确相等，不解析——拓展件不得从串里读出会话或租户。解析得到什么、何时有效、解析不出时怎样，由 capability.loop-extension-runner v1 S-50 定。",
      "$comment": "与 LogHandle 同一种写法：按 S-31 的散文在本契约内定义，不 $ref data.identity-values 的 OpaqueIdentifier（D-040 §S1 S1-a 的口径）。成员与句柄本身是主线裁定，见 D-040 §八 M38；不交出会话标识沿用 D-040 §六 L9。",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])",
      "examples": ["env_31d2"]
    },

    "FailureCause": {
      "title": "FailureCause",
      "description": "S-17：一次模型调用故障的成因，恰八个，顺序照 PF-013 §5.7：withdrawn 已下架 · scope_disallowed 这个范围不再允许 · modality_mismatch 和会话里的模态对不上 · credential_unavailable 凭据不可用 · request_rejected 这次请求本身上游不接受 · upstream_unavailable 上游这会儿给不出回复 · interrupted_mid_reply 说到一半断了 · unrecognized 没认出来（兜底）。取值只按「谁能让它不再发生」分。被用户中断不是故障，不在这里。名字由本契约定，data.model-response、data.arrival-events 以 $ref 取它。",
      "$comment": "上游状态码另外原样带着（AfterModelCallFailureSubject.statusCode），不翻译进成因。「upstream_unavailable 且试尽」是它作为上交成因时的附加条件；在 after_model_call{failure} 的输入里它只说这次失败是上游那边的事，是否试尽由那个位置上的拓展件判（S-17）。",
      "type": "string",
      "enum": [
        "withdrawn",
        "scope_disallowed",
        "modality_mismatch",
        "credential_unavailable",
        "request_rejected",
        "upstream_unavailable",
        "interrupted_mid_reply",
        "unrecognized"
      ]
    },

    "TerminalFact": {
      "title": "TerminalFact",
      "description": "S-18：一次运行的终态事实。state 是运行终态（UL-run-terminal-state）恰三种：completed 完成 / failed 失败 / cancelled 被取消。reason 是原因（超时、被打断、配额耗尽是原因不是终态）；initiator 是取消请求的发起方，只在 cancelled 时有、且必有。",
      "$comment": "reason 的取值词表与 initiator 的表示都不在本契约（缺口 G-4）；这里只约束到非空字符串。initiator 只随 cancelled 出现：被取消之前必有一条取消请求（PF-012 I-16），发起方是那条请求的事实。",
      "type": "object",
      "properties": {
        "state": { "enum": ["completed", "failed", "cancelled"] },
        "reason": { "type": "string", "minLength": 1 },
        "initiator": { "type": "string", "minLength": 1 }
      },
      "required": ["state"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "cancelled" } }, "required": ["state"] },
          "then": { "required": ["initiator"] },
          "else": { "not": { "required": ["initiator"] } }
        }
      ]
    },

    "CompactionPlan": {
      "title": "CompactionPlan",
      "description": "S-16：压缩之前那个位置看得到的东西——要交进压缩闭包的那份日志与模型档案。本契约只给不透明形状（一个对象），内容的家在 PF-010 压缩那一侧的能力（缺口 G-1）。",
      "type": "object"
    },

    "ModelRequest": {
      "title": "ModelRequest",
      "description": "S-15：调模型之前那个位置看得到的、已经攒好还没发出去的请求，恰四个成员：target 这一次要用的模型——一个路由名（RouteName，PF-013 rev 12；落到哪一行即有效模型，由模型请求运行时按层覆盖解析）、parameters 这一次要发出的请求参数（档案参数与此前改写合成的那一份）、messages 组装出来的消息、tools 这一次带给模型的工具条目（每项是那个条目的模型面名字 ModelToolName，data.tool-definition v1 S-6；作者写的工具与 MCP 来源的动作都指认得到）。可改的只有 parameters 与 messages（经 rewrite）；target 只经 select_model 改；tools 不可改（S-23、S-24）。成员名与模型请求运行时收的调用请求逐字相同。",
      "type": "object",
      "properties": {
        "target": { "$ref": "../../model-profile/v1/model-profile.schema.json#/$defs/RouteName" },
        "parameters": { "$ref": "../../model-profile/v1/model-profile.schema.json#/$defs/ModelRequestParameters" },
        "messages": {
          "type": "array",
          "items": { "$ref": "../../messages/v1/messages.schema.json#/$defs/Message" }
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "../../tool-definition/v1/tool-definition.schema.json#/$defs/ModelToolName" }
        }
      },
      "required": ["target", "parameters", "messages", "tools"],
      "additionalProperties": false
    },

    "ToolDefinitionRef": {
      "title": "ToolDefinitionRef",
      "description": "S-14：执行动作之前那个位置上，运行时为这次调用找到的那份工具定义的模型面名字（data.tool-definition v1 的 ModelToolName），与调用块里的工具名同一套。只是引用，不是定义本身。",
      "type": "object",
      "properties": {
        "name": { "$ref": "../../tool-definition/v1/tool-definition.schema.json#/$defs/ModelToolName" }
      },
      "required": ["name"],
      "additionalProperties": false
    },

    "AttemptStartedSubject": {
      "title": "尝试开始之后",
      "type": "object",
      "properties": { "attempt": { "$ref": "../../call-accounts/v1/call-accounts.schema.json#/$defs/AttemptId" } },
      "required": ["attempt"],
      "additionalProperties": false
    },

    "BeforePersistMessageSubject": {
      "title": "消息落盘之前",
      "description": "message 还没落盘；producer 是这条消息由谁产生：user 人经交付面说的 / model 模型调用产出的回复 / tool 工具执行交回的 / system 其余（系统或外部来源捎来的）。",
      "type": "object",
      "properties": {
        "message": { "$ref": "../../messages/v1/messages.schema.json#/$defs/Message" },
        "producer": { "enum": ["user", "model", "tool", "system"] }
      },
      "required": ["message", "producer"],
      "additionalProperties": false
    },

    "AfterPersistMessageSubject": {
      "title": "消息落盘之后",
      "type": "object",
      "properties": { "message": { "$ref": "../../messages/v1/messages.schema.json#/$defs/Message" } },
      "required": ["message"],
      "additionalProperties": false
    },

    "BeforeCompactionSubject": {
      "title": "压缩之前",
      "type": "object",
      "properties": { "plan": { "$ref": "#/$defs/CompactionPlan" } },
      "required": ["plan"],
      "additionalProperties": false
    },

    "AfterCompactionSubject": {
      "title": "压缩之后",
      "type": "object",
      "properties": { "compaction": { "$ref": "../../messages/v1/messages.schema.json#/$defs/CompactionMessage" } },
      "required": ["compaction"],
      "additionalProperties": false
    },

    "BeforeModelCallSubject": {
      "title": "调模型之前",
      "type": "object",
      "properties": { "request": { "$ref": "#/$defs/ModelRequest" } },
      "required": ["request"],
      "additionalProperties": false
    },

    "AfterModelCallCompleteReplySubject": {
      "title": "调模型之后 · 完整回复",
      "description": "reply 是已经落盘的那条回复。回复在落盘之前被否决的那次调用、被用户中断的那次调用，都不触发 after_model_call（S-2）。",
      "type": "object",
      "properties": {
        "reply": { "$ref": "../../messages/v1/messages.schema.json#/$defs/AssistantMessage" },
        "usage": { "$ref": "../../call-accounts/v1/call-accounts.schema.json#/$defs/Usage" },
        "cost": { "$ref": "../../call-accounts/v1/call-accounts.schema.json#/$defs/Cost" }
      },
      "required": ["reply", "usage", "cost"],
      "additionalProperties": false
    },

    "AfterModelCallFailureSubject": {
      "title": "调模型之后 · 失败",
      "description": "failure 是这次故障的成因；statusCode 是上游返回的状态码，有才带、原样带，不翻译；profile 是这次调用绑定的档案快照（data.model-profile v1 的 ModelProfileSnapshot）；dispatches 是这次调用到此为止每一次发出的「已出门」记录（data.messages v1 的 ModelCallDispatchedRecord），按发出序号，含失败的这一次。重试件只凭这几样下结论，不现读目录。",
      "type": "object",
      "properties": {
        "failure": { "$ref": "#/$defs/FailureCause" },
        "statusCode": { "type": "integer" },
        "profile": { "$ref": "../../model-profile/v1/model-profile.schema.json#/$defs/ModelProfileSnapshot" },
        "dispatches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../../messages/v1/messages.schema.json#/$defs/ModelCallDispatchedRecord" }
        }
      },
      "required": ["failure", "profile", "dispatches"],
      "additionalProperties": false
    },

    "BeforeActionSubject": {
      "title": "执行动作之前",
      "description": "call 是这一个动作（完整的工具调用块）；definition 是运行时为它找到的那份定义；batch 是这一批动作的全部 CallId，含本次这一个，无重复，顺序在本契约里无含义。",
      "type": "object",
      "properties": {
        "call": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/ToolCallBlock" },
        "definition": { "$ref": "#/$defs/ToolDefinitionRef" },
        "batch": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/CallId" }
        }
      },
      "required": ["call", "definition", "batch"],
      "additionalProperties": false
    },

    "AfterActionEachSubject": {
      "title": "执行动作之后 · 这一个",
      "description": "callId 与 outcome 说这一次执行怎么收场；result 是这一次经过里待落盘的那个结果块，有才带。带的时候它的 callId 与 outcome 必须与外面两个相同（S-14，Schema 管不到）。",
      "type": "object",
      "properties": {
        "callId": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/CallId" },
        "outcome": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/ExecutionOutcome" },
        "result": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/ToolResultBlock" }
      },
      "required": ["callId", "outcome"],
      "additionalProperties": false
    },

    "AfterActionBatchSubject": {
      "title": "执行动作之后 · 这一批全齐",
      "type": "object",
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "callId": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/CallId" },
              "outcome": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/ExecutionOutcome" }
            },
            "required": ["callId", "outcome"],
            "additionalProperties": false
          }
        }
      },
      "required": ["outcomes"],
      "additionalProperties": false
    },

    "BeforeTerminalSubject": {
      "title": "落终态之前",
      "type": "object",
      "properties": { "proposed": { "$ref": "#/$defs/TerminalFact" } },
      "required": ["proposed"],
      "additionalProperties": false
    },

    "AfterTerminalSubject": {
      "title": "落终态之后",
      "type": "object",
      "properties": { "terminal": { "$ref": "#/$defs/TerminalFact" } },
      "required": ["terminal"],
      "additionalProperties": false
    },

    "Subject": {
      "title": "Subject",
      "description": "S-14：按位置判别的输入主体，恰十三种（十一个位置，其中两个各按维度再分两种）。各变体成员互斥，单独拿到一个 Subject 也分得出是哪一种；它属于哪个位置由外面那份 ExtensionInput 或 Conclusion 的 position（与 dimension）判定，对不上即拒。",
      "oneOf": [
        { "$ref": "#/$defs/AttemptStartedSubject" },
        { "$ref": "#/$defs/BeforePersistMessageSubject" },
        { "$ref": "#/$defs/AfterPersistMessageSubject" },
        { "$ref": "#/$defs/BeforeCompactionSubject" },
        { "$ref": "#/$defs/AfterCompactionSubject" },
        { "$ref": "#/$defs/BeforeModelCallSubject" },
        { "$ref": "#/$defs/AfterModelCallCompleteReplySubject" },
        { "$ref": "#/$defs/AfterModelCallFailureSubject" },
        { "$ref": "#/$defs/BeforeActionSubject" },
        { "$ref": "#/$defs/AfterActionEachSubject" },
        { "$ref": "#/$defs/AfterActionBatchSubject" },
        { "$ref": "#/$defs/BeforeTerminalSubject" },
        { "$ref": "#/$defs/AfterTerminalSubject" }
      ]
    },

    "ExtensionInput": {
      "title": "ExtensionInput",
      "description": "S-11～S-13：运行时交给一件拓展件的那一份。position / dimension 是这一次挂的位置（求得的值）；run / attempt 指这一次经过所在的运行与尝试——消息落盘之前那个位置看不到有没有运行在跑，所以那里两者都不带；subject 是瀑布里排在前面的件改写之后的那一份；earlier 是同一次经过里排在前面的件已经落下的结论；log 是只读句柄；environment 是这一次经过所在会话的执行环境句柄（S-41），十一个位置都带。",
      "$comment": "位置与 subject 变体的对应、位置与维度的配对、run/attempt 的有无，都在下面的条件约束里；对不上即 malformed / dimension_*（S-37）。earlier 里每条的 position、dimension 必须与本输入相同，Schema 管不到。",
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/LoopPosition" },
        "dimension": { "$ref": "#/$defs/Dimension" },
        "run": { "$ref": "../../call-accounts/v1/call-accounts.schema.json#/$defs/RunId" },
        "attempt": { "$ref": "../../call-accounts/v1/call-accounts.schema.json#/$defs/AttemptId" },
        "subject": { "$ref": "#/$defs/Subject" },
        "earlier": { "type": "array", "items": { "$ref": "#/$defs/Conclusion" } },
        "log": { "$ref": "#/$defs/LogHandle" },
        "environment": { "$ref": "#/$defs/EnvironmentHandle" }
      },
      "required": ["position", "subject", "earlier", "log", "environment"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "position": { "const": "after_model_call" } }, "required": ["position"] },
          "then": { "required": ["dimension"], "properties": { "dimension": { "required": ["ending"] } } }
        },
        {
          "if": { "properties": { "position": { "const": "after_action" } }, "required": ["position"] },
          "then": { "required": ["dimension"], "properties": { "dimension": { "required": ["scope"] } } }
        },
        {
          "if": { "properties": { "position": { "not": { "enum": ["after_model_call", "after_action"] } } }, "required": ["position"] },
          "then": { "not": { "required": ["dimension"] } }
        },
        {
          "if": { "properties": { "position": { "const": "before_persist_message" } }, "required": ["position"] },
          "then": { "not": { "anyOf": [{ "required": ["run"] }, { "required": ["attempt"] }] } },
          "else": { "required": ["run", "attempt"] }
        },
        { "if": { "properties": { "position": { "const": "attempt_started" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/AttemptStartedSubject" } } } },
        { "if": { "properties": { "position": { "const": "before_persist_message" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/BeforePersistMessageSubject" } } } },
        { "if": { "properties": { "position": { "const": "after_persist_message" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/AfterPersistMessageSubject" } } } },
        { "if": { "properties": { "position": { "const": "before_compaction" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/BeforeCompactionSubject" } } } },
        { "if": { "properties": { "position": { "const": "after_compaction" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/AfterCompactionSubject" } } } },
        { "if": { "properties": { "position": { "const": "before_model_call" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/BeforeModelCallSubject" } } } },
        {
          "if": { "properties": { "position": { "const": "after_model_call" }, "dimension": { "properties": { "ending": { "const": "complete_reply" } }, "required": ["ending"] } }, "required": ["position", "dimension"] },
          "then": { "properties": { "subject": { "$ref": "#/$defs/AfterModelCallCompleteReplySubject" } } }
        },
        {
          "if": { "properties": { "position": { "const": "after_model_call" }, "dimension": { "properties": { "ending": { "const": "failure" } }, "required": ["ending"] } }, "required": ["position", "dimension"] },
          "then": { "properties": { "subject": { "$ref": "#/$defs/AfterModelCallFailureSubject" } } }
        },
        { "if": { "properties": { "position": { "const": "before_action" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/BeforeActionSubject" } } } },
        {
          "if": { "properties": { "position": { "const": "after_action" }, "dimension": { "properties": { "scope": { "const": "each" } }, "required": ["scope"] } }, "required": ["position", "dimension"] },
          "then": { "properties": { "subject": { "$ref": "#/$defs/AfterActionEachSubject" } } }
        },
        {
          "if": { "properties": { "position": { "const": "after_action" }, "dimension": { "properties": { "scope": { "const": "batch" } }, "required": ["scope"] } }, "required": ["position", "dimension"] },
          "then": { "properties": { "subject": { "$ref": "#/$defs/AfterActionBatchSubject" } } }
        },
        { "if": { "properties": { "position": { "const": "before_terminal" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/BeforeTerminalSubject" } } } },
        { "if": { "properties": { "position": { "const": "after_terminal" } }, "required": ["position"] }, "then": { "properties": { "subject": { "$ref": "#/$defs/AfterTerminalSubject" } } } }
      ]
    },

    "ObservedOutput": {
      "title": "observed",
      "description": "S-19：无意见，不改走向。三档都能交回。",
      "type": "object",
      "properties": { "kind": { "const": "observed" } },
      "required": ["kind"],
      "additionalProperties": false
    },

    "InjectOutput": {
      "title": "inject",
      "description": "S-22：往日志里追加一条系统提醒。message 的 source.kind 必为 extension，且 source.extension 等于本件的 name（后一半 Schema 管不到）。给模型看还是只给人看由块上的标注定。after_terminal 上不许（S-21）。",
      "type": "object",
      "properties": {
        "kind": { "const": "inject" },
        "message": {
          "allOf": [
            { "$ref": "../../messages/v1/messages.schema.json#/$defs/SystemReminderMessage" },
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "object",
                  "properties": { "kind": { "const": "extension" } },
                  "required": ["kind"]
                }
              },
              "required": ["source"]
            }
          ]
        }
      },
      "required": ["kind", "message"],
      "additionalProperties": false
    },

    "RewriteOutput": {
      "title": "rewrite",
      "description": "S-23：决定下一条还没落盘的东西长什么样。subject 是本位置那一种 Subject 的完整一份，只许改那张「可改成员」表里的成员；不许改 earlier 与 log。",
      "type": "object",
      "properties": {
        "kind": { "const": "rewrite" },
        "subject": { "$ref": "#/$defs/Subject" }
      },
      "required": ["kind", "subject"],
      "additionalProperties": false
    },

    "SelectModelOutput": {
      "title": "select_model",
      "description": "S-24：只在 before_model_call：把这一次请求的 target 换成 profile——一个路由名（PF-013 rev 12）；有效模型是这个名字按层覆盖落到的那一行。取值必须在这一次的合法目标集合里（判定归能力）；只改这一次，不改选中模型；留痕在响应体的 route.selectedBy。",
      "type": "object",
      "properties": {
        "kind": { "const": "select_model" },
        "profile": { "$ref": "../../model-profile/v1/model-profile.schema.json#/$defs/RouteName" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "profile"],
      "additionalProperties": false
    },

    "VetoOutput": {
      "title": "veto",
      "description": "S-25：只在五个「之前」的位置：拦住它站的那个状态点。含义按位置：不落盘 / 这一趟不压 / 这次请求不发 / 这个动作不做 / 这次不收束（接着转）。reason 必带。",
      "type": "object",
      "properties": {
        "kind": { "const": "veto" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "reason"],
      "additionalProperties": false
    },

    "StopOutput": {
      "title": "stop",
      "description": "S-26：让这次运行不再继续，落哪一种终态由 terminal 定：cancelled（缺席即此）先落一条取消请求（发起方是本件），再落终态「被取消」；failed 直接落终态「失败」，原因指向本件，不落取消请求。reason 必带。",
      "$comment": "terminal 与缺席即 cancelled 是主线裁定（D-040 §S7 S7-a）；循环守卫 L3 用 failed。取值闭合，completed 不在其中——拓展件不能替运行宣布完成。",
      "type": "object",
      "properties": {
        "kind": { "const": "stop" },
        "terminal": { "enum": ["cancelled", "failed"], "default": "cancelled" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "reason"],
      "additionalProperties": false
    },

    "RetryPlan": {
      "title": "RetryPlan",
      "description": "S-27：再发一次：发给哪一家供应商（每一次发出只走一家），可选退避多久之后再发。",
      "type": "object",
      "properties": {
        "provider": { "$ref": "../../model-profile/v1/model-profile.schema.json#/$defs/ProviderName" },
        "after": { "$ref": "../../tool-definition/v1/tool-definition.schema.json#/$defs/Duration" }
      },
      "required": ["provider"],
      "additionalProperties": false
    },

    "RetryOutput": {
      "title": "retry",
      "description": "S-27：只在 after_model_call{failure}：这次调用不算了结，照 plan 再发一次。推翻不了事实三类（发不出去 / 重试没用 / 已经开口说话了）。",
      "type": "object",
      "properties": {
        "kind": { "const": "retry" },
        "plan": { "$ref": "#/$defs/RetryPlan" }
      },
      "required": ["kind", "plan"],
      "additionalProperties": false
    },

    "CardOption": {
      "title": "CardOption",
      "description": "S-28：卡片上的一个选项，本契约只给不透明形状：id 在这张卡片内唯一，label 给人看，effect 是出卡那一件自己解释的附带数据。放行判断的定死选项由 capability.tool-admission v1 S-15 定；effect 的含义、CardId 与答复形状归卡片契约（缺口 G-6）。",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "effect": {}
      },
      "required": ["id", "label"],
      "additionalProperties": false
    },

    "DecisionCardDraft": {
      "title": "DecisionCardDraft",
      "description": "S-28：一件拓展件要落的那张决策卡片（UL-decision-card）的草稿：自己写的说明、自己写的选项（至少一个）、这张卡片为哪个位置（与哪个动作）出的；在 before_action 可另带 proposedRewrite——出卡那一件对这个动作参数的改写提议，它不是结论、出卡时不生效，人答完之后那一件交回的最终结论若是 rewrite 才照 S-23 生效（兼容件从这一格重建，capability.hooks-import）。落盘之后它才有 CardId，卡片本身的契约归 PF-008（未起草）。",
      "$comment": "about.callId 在 before_action 必带；在 after_action 由维度定（each 必带、batch 不带），about 里没有维度，由 Conclusion 那一层对照（S-28）；其余位置不带。proposedRewrite 只在 about.position 为 before_action 时可带（malformed）。",
      "type": "object",
      "properties": {
        "explanation": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/CardOption" } },
        "proposedRewrite": {
          "type": "object",
          "properties": {
            "arguments": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/ToolCallBlock/properties/arguments" }
          },
          "required": ["arguments"],
          "additionalProperties": false
        },
        "about": {
          "type": "object",
          "properties": {
            "position": { "$ref": "#/$defs/LoopPosition" },
            "callId": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/CallId" }
          },
          "required": ["position"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "position": { "const": "before_action" } }, "required": ["position"] },
              "then": { "required": ["callId"] }
            },
            {
              "if": { "properties": { "position": { "not": { "enum": ["before_action", "after_action"] } } }, "required": ["position"] },
              "then": { "not": { "required": ["callId"] } }
            }
          ]
        }
      },
      "required": ["explanation", "options", "about"],
      "additionalProperties": false,
      "if": { "required": ["proposedRewrite"] },
      "then": { "properties": { "about": { "properties": { "position": { "const": "before_action" } } } } }
    },

    "AskOutput": {
      "title": "ask",
      "description": "S-28：落一张卡片、让运行停下来等人。它是唯一一种不终结这一次经过的结论：人答完之后，这一件经回放拿到答复，再交回它这一次经过的最终结论。",
      "type": "object",
      "properties": {
        "kind": { "const": "ask" },
        "card": { "$ref": "#/$defs/DecisionCardDraft" }
      },
      "required": ["kind", "card"],
      "additionalProperties": false
    },

    "ExtensionOutput": {
      "title": "ExtensionOutput",
      "description": "S-19：拓展件交回的结论，封闭八种，按 kind 判别。拓展件改变走向的办法只有这几种，每一种都留痕；没有「跳到哪一步」，没有「替人作答」，没有「放宽」。",
      "oneOf": [
        { "$ref": "#/$defs/ObservedOutput" },
        { "$ref": "#/$defs/InjectOutput" },
        { "$ref": "#/$defs/RewriteOutput" },
        { "$ref": "#/$defs/SelectModelOutput" },
        { "$ref": "#/$defs/VetoOutput" },
        { "$ref": "#/$defs/StopOutput" },
        { "$ref": "#/$defs/RetryOutput" },
        { "$ref": "#/$defs/AskOutput" }
      ]
    },

    "Conclusion": {
      "title": "Conclusion",
      "description": "S-30～S-32：一件拓展件在一次经过里的结论落进日志的那一条。每件必留：跑出了结论的记 output；不可用的记 skipped: unavailable 与这一次实际采用的 unavailability（skip / veto / fallback）、不带 output（不替一件没跑的东西编结论，但写明「此刻不在、按 X 处置」）；可用却报错的记 skipped: errored、error 与 output（output 是处置策略实际落下的那个结论）。power、position、dimension 是这一次经过求得的值；callId 指这次结论是为哪一个动作下的（只在 before_action 与 after_action{each}）。",
      "$comment": "两张合法组合表在这里：下面 allOf 里「档 × 结论」三条、「位置 × 结论」十三条、报错处置只落四种一条、不可用按否决处置的前提一条、rewrite 的 subject 与位置配对四条。output 缺席时（skipped: unavailable）这些约束空成立。error 在结论被表示层拒绝时恰为那个拒绝值 token（S-31），Schema 只约束到非空字符串。",
      "type": "object",
      "properties": {
        "extension": { "$ref": "../../asset-model/v1/asset-model.schema.json#/$defs/CapabilityName" },
        "position": { "$ref": "#/$defs/LoopPosition" },
        "dimension": { "$ref": "#/$defs/Dimension" },
        "power": { "$ref": "#/$defs/Power" },
        "callId": { "$ref": "../../content-blocks/v1/content-blocks.schema.json#/$defs/CallId" },
        "output": { "$ref": "#/$defs/ExtensionOutput" },
        "at": { "$ref": "../../offer-expiry/v1/offer-expiry.schema.json#/$defs/Instant" },
        "skipped": { "enum": ["unavailable", "errored"] },
        "unavailability": { "$ref": "#/$defs/UnavailabilityPolicy" },
        "error": { "type": "string", "minLength": 1 }
      },
      "required": ["extension", "position", "power", "at"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "position": { "const": "after_model_call" } }, "required": ["position"] },
          "then": { "required": ["dimension"], "properties": { "dimension": { "required": ["ending"] } } }
        },
        {
          "if": { "properties": { "position": { "const": "after_action" } }, "required": ["position"] },
          "then": { "required": ["dimension"], "properties": { "dimension": { "required": ["scope"] } } }
        },
        {
          "if": { "properties": { "position": { "not": { "enum": ["after_model_call", "after_action"] } } }, "required": ["position"] },
          "then": { "not": { "required": ["dimension"] } }
        },
        {
          "if": {
            "anyOf": [
              { "properties": { "position": { "const": "before_action" } }, "required": ["position"] },
              { "properties": { "position": { "const": "after_action" }, "dimension": { "properties": { "scope": { "const": "each" } }, "required": ["scope"] } }, "required": ["position", "dimension"] }
            ]
          },
          "then": { "required": ["callId"] },
          "else": { "not": { "required": ["callId"] } }
        },
        {
          "oneOf": [
            {
              "title": "跑出了结论",
              "required": ["output"],
              "not": { "anyOf": [{ "required": ["skipped"] }, { "required": ["error"] }, { "required": ["unavailability"] }] }
            },
            {
              "title": "不可用，按不可用处置",
              "properties": { "skipped": { "const": "unavailable" } },
              "required": ["skipped", "unavailability"],
              "not": { "anyOf": [{ "required": ["output"] }, { "required": ["error"] }] }
            },
            {
              "title": "报错，按策略处置",
              "properties": { "skipped": { "const": "errored" } },
              "required": ["skipped", "output", "error"],
              "not": { "required": ["unavailability"] }
            }
          ]
        },

        {
          "$comment": "不可用按否决处置（S-31）：只随求得的干预力 veto、且位置是五个「之前」之一；否则这一次照 skip 办，记 skip。",
          "if": { "properties": { "unavailability": { "const": "veto" } }, "required": ["unavailability"] },
          "then": { "properties": { "power": { "const": "veto" }, "position": { "enum": ["before_persist_message", "before_compaction", "before_model_call", "before_action", "before_terminal"] } } }
        },

        {
          "$comment": "档 × 结论：observe 只能 observed。",
          "if": { "properties": { "power": { "const": "observe" } }, "required": ["power"] },
          "then": { "properties": { "output": { "properties": { "kind": { "const": "observed" } } } } }
        },
        {
          "$comment": "档 × 结论：rewrite 不能 veto / stop / ask。",
          "if": { "properties": { "power": { "const": "rewrite" } }, "required": ["power"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "rewrite", "select_model", "retry"] } } } } }
        },
        {
          "$comment": "档 × 结论：veto 八种全部（仍受位置 × 结论约束）。",
          "if": { "properties": { "power": { "const": "veto" } }, "required": ["power"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "rewrite", "select_model", "veto", "stop", "retry", "ask"] } } } } }
        },

        {
          "$comment": "位置 × 结论：attempt_started。",
          "if": { "properties": { "position": { "const": "attempt_started" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：before_persist_message（不许 ask、不许 stop）。",
          "if": { "properties": { "position": { "const": "before_persist_message" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "rewrite", "veto"] } } } } }
        },
        {
          "$comment": "位置 × 结论：after_persist_message。",
          "if": { "properties": { "position": { "const": "after_persist_message" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：before_compaction（本版没有 rewrite，见 G-15）。",
          "if": { "properties": { "position": { "const": "before_compaction" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "veto", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：after_compaction。",
          "if": { "properties": { "position": { "const": "after_compaction" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：before_model_call（select_model 只在这里）。",
          "if": { "properties": { "position": { "const": "before_model_call" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "rewrite", "select_model", "veto", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：after_model_call{complete_reply}。",
          "if": { "properties": { "position": { "const": "after_model_call" }, "dimension": { "properties": { "ending": { "const": "complete_reply" } }, "required": ["ending"] } }, "required": ["position", "dimension"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：after_model_call{failure}（retry 只在这里）。",
          "if": { "properties": { "position": { "const": "after_model_call" }, "dimension": { "properties": { "ending": { "const": "failure" } }, "required": ["ending"] } }, "required": ["position", "dimension"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "stop", "retry", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：before_action。",
          "if": { "properties": { "position": { "const": "before_action" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "rewrite", "veto", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：after_action{each}（结果还没落盘，可改写）。",
          "if": { "properties": { "position": { "const": "after_action" }, "dimension": { "properties": { "scope": { "const": "each" } }, "required": ["scope"] } }, "required": ["position", "dimension"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "rewrite", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：after_action{batch}。",
          "if": { "properties": { "position": { "const": "after_action" }, "dimension": { "properties": { "scope": { "const": "batch" } }, "required": ["scope"] } }, "required": ["position", "dimension"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：before_terminal（veto = 接着转）。",
          "if": { "properties": { "position": { "const": "before_terminal" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed", "inject", "veto", "stop", "ask"] } } } } }
        },
        {
          "$comment": "位置 × 结论：after_terminal（只有 observed：不许 ask、不许 stop、不许 inject——注入的提醒会让队列非空、起下一次运行）。",
          "if": { "properties": { "position": { "const": "after_terminal" } }, "required": ["position"] },
          "then": { "properties": { "output": { "properties": { "kind": { "enum": ["observed"] } } } } }
        },

        {
          "$comment": "报错按策略处置只落四种（S-5）：ignore → observed，record → inject，treat_as_veto → 「之前」的位置 veto、「之后」的位置 stop{ terminal: failed }。",
          "if": { "properties": { "skipped": { "const": "errored" } }, "required": ["skipped"] },
          "then": {
            "properties": {
              "output": {
                "anyOf": [
                  { "properties": { "kind": { "enum": ["observed", "inject", "veto"] } } },
                  { "properties": { "kind": { "const": "stop" }, "terminal": { "const": "failed" } }, "required": ["terminal"] }
                ]
              }
            }
          }
        },

        {
          "$comment": "rewrite 的 subject 必须是本位置那一种：before_persist_message。",
          "if": { "properties": { "position": { "const": "before_persist_message" }, "output": { "properties": { "kind": { "const": "rewrite" } }, "required": ["kind"] } }, "required": ["position", "output"] },
          "then": { "properties": { "output": { "properties": { "subject": { "$ref": "#/$defs/BeforePersistMessageSubject" } } } } }
        },
        {
          "$comment": "rewrite 的 subject 必须是本位置那一种：before_model_call。",
          "if": { "properties": { "position": { "const": "before_model_call" }, "output": { "properties": { "kind": { "const": "rewrite" } }, "required": ["kind"] } }, "required": ["position", "output"] },
          "then": { "properties": { "output": { "properties": { "subject": { "$ref": "#/$defs/BeforeModelCallSubject" } } } } }
        },
        {
          "$comment": "rewrite 的 subject 必须是本位置那一种：before_action。",
          "if": { "properties": { "position": { "const": "before_action" }, "output": { "properties": { "kind": { "const": "rewrite" } }, "required": ["kind"] } }, "required": ["position", "output"] },
          "then": { "properties": { "output": { "properties": { "subject": { "$ref": "#/$defs/BeforeActionSubject" } } } } }
        },
        {
          "$comment": "rewrite 的 subject 必须是本位置那一种：after_action{each}。",
          "if": { "properties": { "position": { "const": "after_action" }, "output": { "properties": { "kind": { "const": "rewrite" } }, "required": ["kind"] } }, "required": ["position", "output"] },
          "then": { "properties": { "output": { "properties": { "subject": { "$ref": "#/$defs/AfterActionEachSubject" } } } } }
        },

        {
          "$comment": "ask 在 after_action{each} 出卡：卡片必须说是为哪个动作。",
          "if": { "properties": { "position": { "const": "after_action" }, "dimension": { "properties": { "scope": { "const": "each" } }, "required": ["scope"] }, "output": { "properties": { "kind": { "const": "ask" } }, "required": ["kind"] } }, "required": ["position", "dimension", "output"] },
          "then": { "properties": { "output": { "properties": { "card": { "properties": { "about": { "required": ["callId"] } } } } } } }
        },
        {
          "$comment": "ask 在 after_action{batch} 出卡：这一批不属于某一个动作，卡片不带 callId。",
          "if": { "properties": { "position": { "const": "after_action" }, "dimension": { "properties": { "scope": { "const": "batch" } }, "required": ["scope"] }, "output": { "properties": { "kind": { "const": "ask" } }, "required": ["kind"] } }, "required": ["position", "dimension", "output"] },
          "then": { "properties": { "output": { "properties": { "card": { "properties": { "about": { "not": { "required": ["callId"] } } } } } } } }
        }
      ]
    }
  }
}
