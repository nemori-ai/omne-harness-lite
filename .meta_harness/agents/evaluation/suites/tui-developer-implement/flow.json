        "to": "apps/cli/tests/fixtures/evaluation-inputs/tui-forms.schema.json",
        "consumers": []
      }
    ]
  },
  "brief_frame": "briefs/_implement.md",
  "oracle": {
    "member": "apps/cli",
    "tests_dir": "tests",
    "test": [
      "pnpm",
      "exec",
      "vitest",
      "run",
      "--reporter=json",
      "--outputFile={OUT}"
    ],
    "typecheck": [
      "pnpm",
      "run",
      "typecheck"
    ],
    "format": [
      "pnpm",
      "exec",
      "prettier",
      "--check"
    ],
    "target_tests": "target-tests.json",
    "timeout_s": {
      "test": 600,
      "typecheck": 900,
      "format": 900
    }
  },
  "metrics": [
