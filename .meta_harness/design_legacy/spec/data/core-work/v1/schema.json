{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/core-work/v1/schema.json",
  "title": "Core work identity, immutable action and content v1",
  "oneOf": [
    {
