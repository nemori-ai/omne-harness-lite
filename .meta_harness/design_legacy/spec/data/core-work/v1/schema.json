              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {}
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "validation"
                ],
                "properties": {
                  "validation": {
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "accepted"
                      }
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "call",
                  "action"
                ],
                "not": {
                  "required": [
                    "raw"
                  ]
                }
              },
              "else": {
                "required": [
                  "raw"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "call"
                      ]
                    },
                    {
                      "required": [
                        "action"
                      ]
                    }
                  ]
                }
              }
