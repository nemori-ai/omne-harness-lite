    }
  ],
  "$defs": {
    "UserRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId"
      ],
      "properties": {
        "userId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "MembershipRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "userId"
      ],
      "properties": {
        "tenantId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "userId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "DefinitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerTenantId",
        "definitionId"
      ],
      "properties": {
        "ownerTenantId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "definitionId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "DefinitionVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "version"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/DefinitionRef"
