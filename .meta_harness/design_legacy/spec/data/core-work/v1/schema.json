            "call",
            "reason",
            "notice"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "deferred_receipt"
            },
            "call": {
              "$ref": "#/$defs/CallRef"
            },
            "reason": {
              "enum": [
                "detached_background",
                "background_from_start",
                "waiting_approval",
                "waiting_human",
                "staged_provisional",
                "foreground_pending"
              ]
            },
            "notice": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockId",
            "kind",
            "reminderKind"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "system_reminder"
            },
            "reminderKind": {
              "enum": [
                "late_result",
                "human_answer",
                "hook_context",
                "system_notice"
              ]
            },
            "ref": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "call"
                  ],
                  "properties": {
                    "call": {
                      "$ref": "#/$defs/CallRef"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "handler",
                    "site"
                  ],
                  "properties": {
                    "handler": {
                      "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
                    },
                    "site": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "outcome": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CallOutcome"
                },
                {
                  "enum": [
                    "answer",
                    "approve",
                    "reject"
                  ]
                }
              ]
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlainContentBlock"
              },
              "minItems": 0
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "reminderKind"
                ],
                "properties": {
                  "reminderKind": {
                    "enum": [
                      "late_result",
                      "human_answer"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "ref",
                  "outcome"
                ],
                "not": {
                  "required": [
                    "body"
                  ]
                }
              },
              "else": {
                "required": [
                  "body"
                ],
                "not": {
                  "required": [
                    "outcome"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "reminderKind"
                ],
                "properties": {
                  "reminderKind": {
                    "const": "hook_context"
                  }
                }
              },
              "then": {
                "required": [
                  "ref"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "reminderKind"
                ],
                "properties": {
                  "reminderKind": {
                    "const": "system_notice"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "ref"
                  ]
                }
              }
            }
          ]
        }
      ]
