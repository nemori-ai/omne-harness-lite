        "version": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "SessionRef": {
      "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/SessionRef"
    },
    "RunRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "runId"
      ],
      "properties": {
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "runId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "StepRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "stepId"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/RunRef"
        },
        "stepId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "WorkRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "workId"
      ],
      "properties": {
        "tenantId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "workId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "WorkOwner": {
      "oneOf": [
        {
          "$ref": "#/$defs/StepRef"
        },
        {
          "$ref": "#/$defs/WorkRef"
        }
      ]
    },
    "MediaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "mediaId"
      ],
      "properties": {
        "tenantId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "mediaId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "MediaMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media",
        "sha256",
        "byteLength",
        "mimeType"
      ],
      "properties": {
        "media": {
          "$ref": "#/$defs/MediaRef"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "kind",
        "resourceId",
        "version"
      ],
      "properties": {
        "tenantId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "version": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "SecretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tenantId",
        "secretId",
        "version"
      ],
      "properties": {
        "kind": {
          "const": "secret_version"
        },
        "tenantId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "secretId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "version": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationId",
        "generation",
        "configurationRevision",
        "environment",
        "parserVersion"
      ],
      "properties": {
        "implementationId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "generation": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "configurationRevision": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "environment": {
          "$ref": "#/$defs/ResourceRef"
        },
        "parserVersion": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "callId",
        "attemptId",
        "owner",
        "definition",
        "toolKey",
        "commandKey",
        "declarationVersion",
        "binding",
        "params",
        "resources",
        "permissions",
        "confirmation",
        "grantorKinds",
        "impact"
      ],
      "properties": {
        "tenantId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "callId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "attemptId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "owner": {
          "$ref": "#/$defs/WorkOwner"
        },
        "definition": {
          "$ref": "#/$defs/DefinitionVersion"
        },
        "toolKey": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "commandKey": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "declarationVersion": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "params": {
          "type": "object"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "minItems": 0
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "confirmation": {
          "enum": [
            "none",
            "before_effect",
            "provisional"
          ]
        },
        "grantorKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "provisionalContract": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmation": {
                "const": "provisional"
              }
            }
          },
          "then": {
            "required": [
              "provisionalContract"
            ]
          }
        }
      ]
    },
    "CallRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "callId",
        "attemptId"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/WorkOwner"
        },
        "callId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "attemptId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "RequestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "requestId"
      ],
      "properties": {
        "tenantId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "requestId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integer",
        "scale",
        "currency"
      ],
      "properties": {
        "integer": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "OperationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "principalId",
        "operationId"
      ],
      "properties": {
        "namespace": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "principalId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "operationId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "contentVersion",
        "outcomeVersion",
        "actor",
        "outcome"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/RequestRef"
        },
        "contentVersion": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "outcomeVersion": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "actor": {
          "$ref": "#/$defs/UserRef"
        },
        "outcome": {
          "enum": [
            "answer",
            "approve",
            "reject"
          ]
        },
        "answer": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "answer"
              }
            }
          },
          "then": {
            "required": [
              "answer"
            ]
          },
          "else": {
            "not": {
              "required": [
                "answer"
              ]
            }
          }
        }
      ]
    },
    "Input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "inputId",
        "revision",
        "content",
        "busyBehavior",
        "literal"
      ],
      "properties": {
        "session": {
          "$ref": "#/$defs/SessionRef"
        },
        "inputId": {
          "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputBlock"
          },
          "minItems": 0
        },
        "busyBehavior": {
          "enum": [
            "queue",
            "interrupt_then_run"
          ]
        },
        "literal": {
          "type": "boolean"
        }
      }
    },
    "ContentBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockId",
            "kind",
            "text"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockId",
            "kind",
            "media",
            "delivery"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "image"
            },
            "media": {
              "$ref": "#/$defs/MediaRef"
            },
            "delivery": {
              "enum": [
                "model_native",
                "agent_attachment"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockId",
            "kind",
            "media",
            "delivery"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "audio"
            },
            "media": {
              "$ref": "#/$defs/MediaRef"
            },
            "delivery": {
              "enum": [
                "model_native",
                "agent_attachment"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockId",
            "kind",
            "media",
            "delivery"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "video"
            },
            "media": {
              "$ref": "#/$defs/MediaRef"
            },
            "delivery": {
              "enum": [
                "model_native",
                "agent_attachment"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockId",
            "kind",
            "media",
            "delivery"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "file"
            },
            "media": {
              "$ref": "#/$defs/MediaRef"
            },
            "delivery": {
              "enum": [
                "model_native",
                "agent_attachment"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockId",
            "kind",
            "form"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "reasoning"
            },
            "form": {
              "enum": [
                "text",
                "summary",
                "encrypted"
              ]
            },
            "text": {
              "type": "string"
            },
            "opaque": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "minLength": 1
            },
            "signature": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "form"
                ],
                "properties": {
                  "form": {
                    "const": "encrypted"
                  }
                }
              },
              "then": {
                "required": [
                  "opaque"
                ],
                "not": {
                  "required": [
                    "text"
                  ]
                }
              },
              "else": {
                "required": [
                  "text"
                ],
                "not": {
                  "required": [
                    "opaque"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockId",
            "kind",
            "validation"
          ],
          "properties": {
            "blockId": {
              "$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"
            },
            "kind": {
              "const": "tool_call"
            },
            "validation": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "accepted"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "reason"
                  ],
                  "properties": {
                    "kind": {
                      "const": "rejected"
                    },
