    },
    {
      "$ref": "#/$defs/Result"
    },
    {
      "$ref": "#/$defs/Input"
    },
    {
      "$ref": "#/$defs/Decision"
    },
    {
      "$ref": "#/$defs/ContentBlock"
    },
    {
      "$ref": "#/$defs/Money"
    },
    {
      "$ref": "#/$defs/MediaMetadata"
    },
    {
