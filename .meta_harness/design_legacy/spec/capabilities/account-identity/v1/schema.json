{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/capabilities/account-identity/v1/schema.json",
  "title": "Account Identity v1 personal creation source fact",
  "$ref": "#/$defs/PersonalCreationSourceFact",
  "$defs": {
    "PersonalCreationSourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "version", "entryKind", "userRef", "targetTenantId"],
      "properties": {
        "sourceRef": {
          "allOf": [
            {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
            {"pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"}
          ]
        },
        "version": {"const": "1"},
        "entryKind": {"enum": ["deployment_init", "account_registration"]},
        "userRef": {
          "allOf": [
            {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/core-work/v1/schema.json#/$defs/UserRef"},
            {"properties": {"userId": {"pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"}}}
          ]
        },
        "targetTenantId": {
          "allOf": [
            {"$ref": "https://omne-harness-lite.invalid/meta-harness/omne-harness-lite-design-2026-09-15/spec/data/agent-runtime-identity/v1/schema.json#/$defs/OpaqueId"},
            {"pattern": "^personal:user:[A-Za-z0-9_-]+(?![\\s\\S])"}
          ]
        }
      }
    }
  }
}
