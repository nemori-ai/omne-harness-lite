play_text_range": [0, 149], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 3, "reposts": 3, "likes": 49, "bookmarks": 4, "quotes": 1, "embed_card": "tweet", "created_at": "Sat Feb 21 15:50:36 +0000 2026", "created_timestamp": 1771689036, "views": 7235, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2025236511570997674", "id": "2025236511570997674", "text": "I'm beginning to think that the three laws of TDD are necessary to keep Claude from going off the rails.  It's slower, to be sure, but that may be a cost worth accepting.", "raw_text": {"text": "I'm beginning to think that the three laws of TDD are necessary to keep Claude from going off the rails.  It's slower, to be sure, but that may be a cost worth accepting.", "display_text_range": [0, 170], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 39, "reposts": 11, "likes": 378, "bookmarks": 129, "quotes": 2, "embed_card": "tweet", "created_at": "Sat Feb 21 15:49:46 +0000 2026", "created_timestamp": 1771688986, "views": 38166, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2025236078072930577", "id": "2025236078072930577", "text": "It's really useful to watch Claude chatter.  Often you see it going down ratholes that you can redirect it from taking.", "raw_text": {"text": "It's really useful to watch Claude chatter.  Often you see it going down ratholes that you can redirect it from taking.", "display_text_range": [0, 119], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 8, "reposts": 0, "likes": 60, "bookmarks": 2, "quotes": 0, "embed_card": "tweet", "created_at": "Sat Feb 21 15:48:02 +0000 2026", "created_timestamp": 1771688882, "views": 7167, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2025212153121128646", "id": "2025212153121128646", "text": "Here's a philosophical question for you.  \n\nWe programmers have been dedicated to _certainty_.  Either the program works or it doesn't.  \n\nAIs do not deliver certainty.  Perhaps certainty will remain forever outside their domain.\n\nCan we live with that?  \n\nOf course we do, in virtually every other aspect of our lives.  And even we are never entirely certain that our programs work.  \n\nIs our AI future, therefore, one that constrains the uncertain behavior of our machines to remain within acceptable limits?  Is that any different from before AI?", "raw_text": {"text": "Here's a philosophical question for you.  \n\nWe programmers have been dedicated to _certainty_.  Either the program works or it doesn't.  \n\nAIs do not deliver certainty.  Perhaps certainty will remain forever outside their domain.\n\nCan we live with that?  \n\nOf course we do, in virtually every other aspect of our lives.  And even we are never entirely certain that our programs work.  \n\nIs our AI future, therefore, one that constrains the uncertain behavior of our machines to remain within acceptable limits?  Is that any different from before AI?", "display_text_range": [0, 549], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 80, "reposts": 8, "likes": 192, "bookmarks": 32, "quotes": 5, "embed_card": "tweet", "created_at": "Sat Feb 21 14:12:58 +0000 2026", "created_timestamp": 1771683178, "views": 18287, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2025201334589264125", "id": "2025201334589264125", "text": "There is a definite Heroin aspect to all of this.  I don't WANT to dig into the code.  I WANT to trust claude -- at least at some level.  I WANT to believe that there is a way to wield the lying SOB to generate good clean applications.  So give me another hit and let me feel the euphoria again, while the world collapses around me.", "raw_text": {"text": "There is a definite Heroin aspect to all of this.  I don't WANT to dig into the code.  I WANT to trust claude -- at least at some level.  I WANT to believe that there is a way to wield the lying SOB to generate good clean applications.  So give me another hit and let me feel the euphoria again, while the world collapses around me.", "display_text_range": [0, 332], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 75, "reposts": 29, "likes": 555, "bookmarks": 67, "quotes": 8, "embed_card": "tweet", "created_at": "Sat Feb 21 13:29:59 +0000 2026", "created_timestamp": 1771680599, "views": 32608, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2025199669337350217", "id": "2025199669337350217", "text": "You can't ask a liar to design a process that prevents it from lying.", "raw_text": {"text": "You can't ask a liar to design a process that prevents it from lying.", "display_text_range": [0, 69], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 8, "reposts": 12, "likes": 178, "bookmarks": 10, "quotes": 3, "embed_card": "tweet", "created_at": "Sat Feb 21 13:23:22 +0000 2026", "created_timestamp": 1771680202, "views": 8710, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2025199471311585716", "id": "2025199471311585716", "text": "The more I press on Gerkin style specifications for AI, the less I trust them.  The AI will happily claim to be passing all the Gerkin tests, while in reality implementing them to silently pass while testing nothing.  \n\nNothing can be trusted other than direct human inspection at the code level.  And that inspection must be deeply suspicious of the lies the AI will tell and the ways that it will hide it's misbehavior.", "raw_text": {"text": "The more I press on Gerkin style specifications for AI, the less I trust them.  The AI will happily claim to be passing all the Gerkin tests, while in reality implementing them to silently pass while testing nothing.  \n\nNothing can be trusted other than direct human inspection at the code level.  And that inspection must be deeply suspicious of the lies the AI will tell and the ways that it will hide it's misbehavior.", "display_text_range": [0, 421], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 43, "reposts": 17, "likes": 278, "bookmarks": 36, "quotes": 3, "embed_card": "tweet", "created_at": "Sat Feb 21 13:22:35 +0000 2026", "created_timestamp": 1771680155, "views": 15721, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2024958454553600405", "id": "2024958454553600405", "text": "It took me three or more months to write Pharaoh in C for the Mac in the late '80s. \n\nClaude and I re-engineered it in Clojure in two days.  It took a LOT of testing and cross checking.  \n\nNow let's build it in Javascript.", "raw_text": {"text": "It took me three or more months to write Pharaoh in C for the Mac in the late '80s. \n\nClaude and I re-engineered it in Clojure in two days.  It took a LOT of testing and cross checking.  \n\nNow let's build it in Javascript.", "display_text_range": [0, 222], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 16, "reposts": 2, "likes": 265, "bookmarks": 24, "quotes": 0, "embed_card": "tweet", "created_at": "Fri Feb 20 21:24:52 +0000 2026", "created_timestamp": 1771622692, "views": 22780, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2024953113908539691", "id": "2024953113908539691", "text": "The human/claude dyad is remarkably productive -- when the human knows what they are doing.  Otherwise the number of ratholes you can spin down into are limitless.", "raw_text": {"text": "The human/claude dyad is remarkably productive -- when the human knows what they are doing.  Otherwise the number of ratholes you can spin down into are limitless.", "display_text_range": [0, 163], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 16, "reposts": 15, "likes": 212, "bookmarks": 13, "quotes": 3, "embed_card": "tweet", "created_at": "Fri Feb 20 21:03:38 +0000 2026", "created_timestamp": 1771621418, "views": 10268, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2024920746502267081", "id": "2024920746502267081", "text": "An except from claude's attempt to develop a winning strategy:\n\n\u23fa Progress is much faster now (47.9 height in 19 years) but then all slaves die!\nsl-eff of 0.20-0.40 means chronic overwork \u2192 health decline \u2192 population\ncollapse. The pyramid quota is way too high relative to actual capacity. Let\nme fix the quota to keep sl-eff healthy.", "raw_text": {"text": "An except from claude's attempt to develop a winning strategy:\n\n\u23fa Progress is much faster now (47.9 height in 19 years) but then all slaves die!\nsl-eff of 0.20-0.40 means chronic overwork \u2192 health decline \u2192 population\ncollapse. The pyramid quota is way too high relative to actual capacity. Let\nme fix the quota to keep sl-eff healthy.", "display_text_range": [0, 335], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 4, "reposts": 1, "likes": 16, "bookmarks": 2, "quotes": 0, "embed_card": "tweet", "created_at": "Fri Feb 20 18:55:01 +0000 2026", "created_timestamp": 1771613701, "views": 7328, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2024919109733896556", "id": "2024919109733896556", "text": "The game is single player, and complicated.  I'm watching as Claude works out the strategy by trial and error.  This is really fascin