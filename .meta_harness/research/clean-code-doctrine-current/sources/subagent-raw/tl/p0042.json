007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 85, "reposts": 85, "likes": 1616, "bookmarks": 333, "quotes": 36, "embed_card": "tweet", "created_at": "Wed Jan 28 16:10:56 +0000 2026", "created_timestamp": 1769616656, "views": 279549, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2016523982560727349", "id": "2016523982560727349", "text": "Starting with three claudes.  One implementer.  One planner.  One reviewer.  Using git worktrees instead of cloned repos.", "raw_text": {"text": "Starting with three claudes.  One implementer.  One planner.  One reviewer.  Using git worktrees instead of cloned repos.", "display_text_range": [0, 121], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 79, "reposts": 40, "likes": 1030, "bookmarks": 486, "quotes": 13, "embed_card": "tweet", "created_at": "Wed Jan 28 14:49:17 +0000 2026", "created_timestamp": 1769611757, "views": 80239, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2016199252116922662", "id": "2016199252116922662", "text": "I just asked Claude to review the code and recommend changes that would make it easier for it to read and manage the context window.  It came back with a lot of surprises like splitting files and splitting modules and creating macros that allow it to minimize file reading and file searching, and create abstractions that allow it to ignore details.  \n\nFascinating!", "raw_text": {"text": "I just asked Claude to review the code and recommend changes that would make it easier for it to read and manage the context window.  It came back with a lot of surprises like splitting files and splitting modules and creating macros that allow it to minimize file reading and file searching, and create abstractions that allow it to ignore details.  \n\nFascinating!", "display_text_range": [0, 365], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 63, "reposts": 28, "likes": 549, "bookmarks": 183, "quotes": 12, "embed_card": "tweet", "created_at": "Tue Jan 27 17:18:55 +0000 2026", "created_timestamp": 1769534335, "views": 59968, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2016166910698696916", "id": "2016166910698696916", "text": "I'm keeping two Claude windows open.  One making changes to the source code.  The other helping me to plan future changes.  This uses my time better since I spend a lot less time waiting for Claude to finish.\n\nThe two Claudes are in two different directories, both have git repos of the project.  The planning directory has rules that prevent source code changes.  Only planning is allowed.  I manually pull and push changes between the two.", "raw_text": {"text": "I'm keeping two Claude windows open.  One making changes to the source code.  The other helping me to plan future changes.  This uses my time better since I spend a lot less time waiting for Claude to finish.\n\nThe two Claudes are in two different directories, both have git repos of the project.  The planning directory has rules that prevent source code changes.  Only planning is allowed.  I manually pull and push changes between the two.", "display_text_range": [0, 441], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, 