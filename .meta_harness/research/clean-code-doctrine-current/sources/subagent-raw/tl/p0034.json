_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 11, "reposts": 0, "likes": 103, "bookmarks": 4, "quotes": 0, "embed_card": "tweet", "created_at": "Thu Feb 26 16:35:09 +0000 2026", "created_timestamp": 1772123709, "views": 10423, "is_note_tweet": false, "community_note": null, "lang": "ca", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2027041340144435459", "id": "2027041340144435459", "text": "Mutate the code then crap on it!", "raw_text": {"text": "Mutate the code then crap on it!", "display_text_range": [0, 32], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 10, "reposts": 3, "likes": 51, "bookmarks": 7, "quotes": 0, "embed_card": "tweet", "created_at": "Thu Feb 26 15:21:30 +0000 2026", "created_timestamp": 1772119290, "views": 7051, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2027040872802488464", "id": "2027040872802488464", "text": "I cheated.  I looked at some sample code and, although it was pretty good, I thought it could be better.  So I told Claude to improve it.", "raw_text": {"text": "I cheated.  I looked at some sample code and, although it was pretty good, I thought it could be better.  So I told Claude to improve it.", "display_text_range": [0, 137], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 6, "reposts": 1, "likes": 86, "bookmarks": 2, "quotes": 0, "embed_card": "tweet", "created_at": "Thu Feb 26 15:19:39 +0000 2026", "created_timestamp": 1772119179, "views": 12243, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2027021325412274326", "id": "2027021325412274326", "text": "...and what's weird about all that refactoring I'm doing is that I don't look at the code at all.  And yet I know what's going on with a high level of confidence and detail.", "raw_text": {"text": "...and what's weird about all that refactoring I'm doing is that I don't look at the code at all.  And yet I know what's going on with a high level of confidence and detail.", "display_text_range": [0, 173], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 11, "reposts": 1, "likes": 126, "bookmarks": 15, "quotes": 1, "embed_card": "tweet", "created_at": "Thu Feb 26 14:01:58 +0000 2026", "created_timestamp": 1772114518, "views": 8573, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2027020820724199808", "id": "2027020820724199808", "text": "27 years ago @KentBeck said \"Refactor Mercilessly\".  Now, using Claude, \"merciless\" takes on an entire new meaning.  I can rip this system seven ways to Sunday and it still behaves perfectly.  The massive testing and acceptance testing keeps the behavior very stable.  I have yet to see a single behavioral instability despite ripping the guts out of the code and rearranging it at my whim.", "raw_text": {"text": "27 years ago @KentBeck said \"Refactor Mercilessly\".  Now, using Claude, \"merciless\" takes on an entire new meaning.  I can rip this system seven ways to Sunday and it still behaves perfectly.  The massive testing and acceptance testing keeps the behavior very stable.  I have yet to see a single behavioral instability despite ripping the guts out of the code and rearranging it at my whim.", "display_text_range": [0, 390], "facets": [{"type": "mention", "indices": [13, 22], "original": "KentBeck", "id": "16891384"}]}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 32, "reposts": 29, "likes": 388, "bookmarks": 86, "quotes": 4, "embed_card": "tweet", "created_at": "Thu Feb 26 13:59:58 +0000 2026", "created_timestamp": 1772114398, "views": 25043, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2026778302879236510", "id": "2026778302879236510", "text": "I have, several times, given Claude a problem that was too hard for it to deal with.  It would cook for a long time and then complain that there was too much output for its context.  The only solution was the /clear and then cut the job into pieces -- which usually meant refactoring the code it was dealing with.  It could handle that refactoring -- but it could not handle the debugging, or the test coverage, or whatever else I was asking it to do.", "raw_text": {"text": "I have, several times, given Claude a problem that was too hard for it to deal with.  It would cook for a long time and then complain that there was too much output for its context.  The only solution was the /clear and then cut the job into pieces -- which usually meant refactoring the code it was dealing with.  It could handle that refactoring -- but it could not handle the debugging, or the test coverage, or whatever else I was asking it to do.", "display_text_range": [0, 451], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 21, "reposts": 5, "likes": 177, "bookmarks": 38, "quotes": 1, "embed_card": "tweet", "created_at": "Wed Feb 25 21:56:17 +0000 2026", "created_timestamp": 1772056577, "views": 24907, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2026746465742180595", "id": "2026746465742180595", "text": "There are two new videos on http://cleancoders.com.  Agentic Discipline.  They describe the use of AI starting simple, and then moving to the next level.  There will be more videos added to this series.", "raw_text": {"text": "There are two new videos on https://t.co/Ppz1SXxy1C.  Agentic Discipline.  They describe the use of AI starting simple, and then moving to the next level.  There will be more videos added to this series.", "display_text_range": [0, 203], "facets": [{"type": "url", "indices": [28, 51], "original": "https://t.co/Ppz1SXxy1C", "replacement": "http://cleancoders.com", "display": "cleancoders.com"}]}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 11, "reposts": 27, "likes": 252, "bookmarks": 314, "quotes": 0, "embed_card": "tweet", "created_at": "Wed Feb 25 19:49:47 +0000 2026", "created_timestamp": 1772048987, "possibly_sensitive": false, "views": 19800, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "card": {"url": "http://cleancoders.com", "title": "Clean Coders : Level up your code.", "description": "Improve your skills with our training videos, or hire our experts to build your product.", "domain": "cleancoders.com", "image": {"width": 152, "height": 152, "url": "https://pbs.twimg.com/card_img/2103965202119294976/-Hjh1COP?format=png&name=280x280_2"}}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2026744429462131178", "id": "2026744429462131178", "text": "When the AIs start producing pure binary from our prompts, we will lose the ability to engage with the code.  So it would be a good idea to get used to that now.", "raw_text": {"text": "When the AIs start producing pure binary from our prompts, we will lose the ability to engage with the code.  So it would be a good idea to get used to that now.", "display_text_range": [0, 161], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 122, "reposts": 29, "likes": 479, "bookmarks": 104, "quotes": 16, "embed_card": "tweet", "created_at": "Wed Feb 25 19:41:41 +0000 2026", "created_timestamp": 1772048501, "views": 51365, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2026744255084114229", "id": "2026744255084114229", "text": "You have to keep a good high level vision of the structure of the system.  The AI doesn't have that, and it will go spinning off in circles trying to debug things that you will find obvious.  You cannot be ignorant of the structure of the system.  But that doesn't mean you have to be deeply engaged with the code.", "raw_text": {"text": "You have to keep a good high level vision of the structure of the system.  The AI doesn't have that, and it will go spinning off in circles trying to debug things that you will find obvious.  You cannot be ignorant of the structure of the system.  But that doesn't mean you have to be deeply engaged with the code.", "display_text_range": [0, 314], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 16, "reposts": 12, "likes": 163, "bookmarks": 37, "quotes": 1, "embed_card": "tweet", "created_at": "Wed Feb 25 19:41:00 +0000 2026", "created_timestamp": 1772048460, "views": 9361, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2026737520784916493", "id": "2026737520784916493", "text": "Prompt: crap on and mutate the module.", "raw_text": {"text": "Prompt: crap on and mutate the module.", "display_text_range": [0, 38], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebo