_sutP2smZ4pBZ.mp4?tag=27", "bitrate": 2176000, "container": "mp4", "codec": "h264"}, {"url": "https://video.twimg.com/amplify_video/2059608971183341572/vid/avc1/1080x1920/SerJkOi80ghIFGXu.mp4?tag=27", "bitrate": 10368000, "container": "mp4", "codec": "h264"}], "publisher": null}], "videos": [{"id": "2059608971183341572", "url": "https://video.twimg.com/amplify_video/2059608971183341572/vid/avc1/1080x1920/SerJkOi80ghIFGXu.mp4?tag=27", "thumbnail_url": "https://pbs.twimg.com/amplify_video_thumb/2059608971183341572/img/LZ7PFPC10pJJ1DoM.jpg", "duration": 89.005, "width": 1080, "height": 1920, "format": "video/mp4", "type": "video", "formats": [{"url": "https://video.twimg.com/amplify_video/2059608971183341572/pl/ONcF4aPCwrlM14yf.m3u8?tag=27&v=2be", "container": "m3u8"}, {"url": "https://video.twimg.com/amplify_video/2059608971183341572/vid/avc1/320x568/Tym0B6f8ypydRU_l.mp4?tag=27", "bitrate": 632000, "container": "mp4", "codec": "h264"}, {"url": "https://video.twimg.com/amplify_video/2059608971183341572/vid/avc1/480x852/oudQNmnKv-FpUJbq.mp4?tag=27", "bitrate": 950000, "container": "mp4", "codec": "h264"}, {"url": "https://video.twimg.com/amplify_video/2059608971183341572/vid/avc1/720x1280/JVr_sutP2smZ4pBZ.mp4?tag=27", "bitrate": 2176000, "container": "mp4", "codec": "h264"}, {"url": "https://video.twimg.com/amplify_video/2059608971183341572/vid/avc1/1080x1920/SerJkOi80ghIFGXu.mp4?tag=27", "bitrate": 10368000, "container": "mp4", "codec": "h264"}], "publisher": null}]}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2059604009376260226", "id": "2059604009376260226", "text": "I\u2019m running an experiment. I need to collect some data from you. Here\u2019s what I\u2019d like you to do. Start a timer, go read the 1970s specification of the Hunt the Wumpus game. Then write the program. Make sure it works to your satisfaction. Then stop the timer. Finally report the time to me at unclebob at cleancoder dot com with the subject line Hunt the Wumpus.\n\nUse any language you like, any testing discipline you like, any disciplines you like, or no disciplines at all. It\u2019s entirely up to you. The only constraint that I make is that from the moment you start the timer until you stop the timer you use no AI.", "raw_text": {"text": "I\u2019m running an experiment. I need to collect some data from you. Here\u2019s what I\u2019d like you to do. Start a timer, go read the 1970s specification of the Hunt the Wumpus game. Then write the program. Make sure it works to your satisfaction. Then stop the timer. Finally report the time to me at unclebob at cleancoder dot com with the subject line Hunt the Wumpus.\n\nUse any language you like, any testing discipline you like, any disciplines you like, or no disciplines at all. It\u2019s entirely up to you. The only constraint that I make is that from the moment you start the timer until you stop the timer you use no AI.", "display_text_range": [0, 615], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282563, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 53, "reposts": 10, "likes": 275, "bookmarks": 162, "quotes": 4, "embed_card": "tweet", "created_at": "Wed May 27 11:53:56 +0000 2026", "created_timestamp": 1779882836, "views": 62977, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2058882794785268137", "id": "2058882794785268137", "text": "It seems to me that if you look back in time and say: \u201cthose were the good old days\u201c then you are doing things wrong.", "raw_text": {"text": "It seems to me that if you look back in time and say: \u201cthose were the good old days\u201c then you are doing things wrong.", "display_text_range": [0, 117], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282563, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 17, "reposts": 11, "likes": 196, "bookmarks": 12, "quotes": 4, "embed_card": "tweet", "created_at": "Mon May 25 12:08:05 +0000 2026", "created_timestamp": 1779710885, "views": 13224, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2058510874348789920", "id": "2058510874348789920", "text": "Morning bathrobe rent: Training bias", "raw_text": {"text": "Morning bathrobe rent: Training bias https://t.co/l8ydQ9m6vP", "display_text_range": [0, 36], "facets": [{"type": "media", "indices": [