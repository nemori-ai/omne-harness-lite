github.com/unclebob/AIR-J", "title": "GitHub - unclebob/AIR-J: A simple language for AIs to use and humans to ignore. This version is JVM...", "description": "A simple language for AIs to use and humans to ignore. This version is JVM based. - unclebob/AIR-J", "domain": "github.com", "image": {"width": 800, "height": 419, "url": "https://pbs.twimg.com/card_img/2103919723293409280/RsTnGE7V?format=jpg&name=800x419"}}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2033627077597929943", "id": "2033627077597929943", "text": "There's a fully functioning wiki (not pretty, but functioning) written entirely in AIR-J in the examples of http://github.com/unclebob/AIR-J.", "raw_text": {"text": "There's a fully functioning wiki (not pretty, but functioning) written entirely in AIR-J in the examples of https://t.co/0Qc8S0lqWi.", "display_text_range": [0, 132], "facets": [{"type": "url", "indices": [108, 131], "original": "https://t.co/0Qc8S0lqWi", "replacement": "http://github.com/unclebob/AIR-J", "display": "github.com/unclebob/AIR-J"}]}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 3, "reposts": 4, "likes": 17, "bookmarks": 9, "quotes": 0, "embed_card": "tweet", "created_at": "Mon Mar 16 19:30:52 +0000 2026", "created_timestamp": 1773689452, "possibly_sensitive": false, "views": 5005, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "source": "Twitter Web App", "card": {"url": "http://github.com/unclebob/AIR-J", "title": "GitHub - unclebob/AIR-J: A simple language for AIs to use and humans to ignore. This version is JVM...", "description": "A simple language for AIs to use and humans to ignore. This version is JVM based. - unclebob/AIR-J", "domain": "github.com", "image": {"width": 800, "height": 419, "url": "https://pbs.twimg.com/card_img/2103919723293409280/RsTnGE7V?format=jpg&name=800x419"}}, "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2033541803559862325", "id": "2033541803559862325", "text": "Getting a 60% bomb to go supercritial is tricky.  But you don't really need that.  Even a nuclear fizzle would be a pretty big boom.  Not kilotons, but X100 tons.  And it would scatter radioactive debris hither and yon making a large area pretty toxic.  A very effective dirty bomb.", "raw_text": {"text": "Getting a 60% bomb to go supercritial is tricky.  But you don't really need that.  Even a nuclear fizzle would be a pretty big boom.  Not kilotons, but X100 tons.  And it would scatter radioactive debris hither and yon making a large area pretty toxic.  A very effective dirty bomb.", "display_text_range": [0, 282], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 3, "reposts": 0, "likes": 18, "bookmarks": 0, "quotes": 0, "embed_card": "tweet", "created_at": "Mon Mar 16 13:52:02 +0000 2026", "created_timestamp": 1773669122, "views": 7648, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "source": "Twitter Web App", "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2033537580541591713", "id": "2033537580541591713", "text": "The 60% Myth.\n\nWe keep hearing that Iran has 400+ kg of 60% enriched Uranium.  We keep hearing that 60% puts them one enrichment step away from a bomb.  \n\nThat's BS.  You can build a Hiroshima yield bomb with 60%.  It'd be heavy, bulky, awkward, and dirty -- but you could put it on a truck or a boat.  With enough shielding, it would be virtually undetectable until it was detonated. Iran has enough material for ~10 such bombs.", "raw_text": {"text": "The 60% Myth.\n\nWe keep hearing that Iran has 400+ kg of 60% enriched Uranium.  We keep hearing that 60% puts them one enrichment step away from a bomb.  \n\nThat's BS.  You can build a Hiroshima yield bomb with 60%.  It'd be heavy, bulky, awkward, and dirty -- but you could put it on a truck or a boat.  With enough shielding, it would be virtually undetectable until it was detonated. Iran has enough material for ~10 such bombs.", "display_text_range": [0, 429], "facets": []}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 23, "reposts": 2, "likes": 170, "bookmarks": 11, "quotes": 3, "embed_card": "tweet", "created_at": "Mon Mar 16 13:35:15 +0000 2026", "created_timestamp": 1773668115, "views": 30538, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "source": "Twitter Web App", "provider": "twitter", "reposted_by": null}, {"type": "status", "url": "https://x.com/unclebobmartin/status/2033529582985400786", "id": "2033529582985400786", "text": "So I had codex write a scrap tool  -- a tool like crap4clj but for speclj specs.  Codex and I iterated on a solution that identifies specs that could be improved.  You can check the readme for details.  (http://github.com/unclebob/scrap)\n\nI got the tool working, and then pushed it.  Then I had codex do a hard run of crap and mutation on it and went to bed.  Under the constraint to reduce crap to below 8 and split any file with more than 50 mutation sites, it has split the original monolith source file into 8 smaller nicely named files, and has increase the test count from 11 tests with 48 assertions to 28 tests with 109 assertions.", "raw_text": {"text": "So I had codex write a scrap tool  -- a tool like crap4clj but for speclj specs.  Codex and I iterated on a solution that identifies specs that could be improved.  You can check the readme for details.  (https://t.co/poopbRxZ41)\n\nI got the tool working, and then pushed it.  Then I had codex do a hard run of crap and mutation on it and went to bed.  Under the constraint to reduce crap to below 8 and split any file with more than 50 mutation sites, it has split the original monolith source file into 8 smaller nicely named files, and has increase the test count from 11 tests with 48 assertions to 28 tests with 109 assertions.", "display_text_range": [0, 630], "facets": [{"type": "url", "indices": [204, 227], "original": "https://t.co/poopbRxZ41", "replacement": "http://github.com/unclebob/scrap", "display": "github.com/unclebob/scrap"}]}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 3, "reposts": 2, "likes": 55, "bookmarks": 34, "quotes": 0, "embed_card": "tweet", "created_at": "Mon Mar 16 13:03:28 +0000 2026", "created_timestamp": 1773666208, "possibly_sensitive": false, "views": 7832, "is_note_tweet": true, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "source": "Twitter Web App", "card": {"url": "https://t.co/b0HUhlg11W", "title": "GitHub - unclebob/scrap: Tool for assessing whether, where, and how speclj specs should be refact...", "description": "Tool for assessing whether, where, and how speclj specs should be refactored. - unclebob/scrap", "domain": "github.com", "image": {"width": 800, "height": 419, "url": "https://pbs.twimg.com/card_img/2103057074112323584/0DQzqukU?format=jpg&name=800x419"}}, "provi