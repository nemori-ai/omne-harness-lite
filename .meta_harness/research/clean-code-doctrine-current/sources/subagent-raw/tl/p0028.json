{"code": 200, "results": [{"type": "status", "url": "https://x.com/unclebobmartin/status/2033700553755148372", "id": "2033700553755148372", "text": "Agentic Discipline 3 is live on http://cleancoders.com.  Multi agent madness!", "raw_text": {"text": "Agentic Discipline 3 is live on https://t.co/Ppz1SXxy1C.  Multi agent madness!", "display_text_range": [0, 78], "facets": [{"type": "url", "indices": [32, 55], "original": "https://t.co/Ppz1SXxy1C", "replacement": "http://cleancoders.com", "display": "cleancoders.com"}]}, "author": {"screen_name": "unclebobmartin", "url": "https://x.com/unclebobmartin", "id": "9505092", "followers": 282564, "following": 366, "likes": 7447, "media_count": 2721, "statuses": 46580, "name": "Uncle Bob Martin", "description": "Software Craftsman", "raw_description": {"text": "Software Craftsman", "facets": []}, "location": "iPhone: 56.802658,9.868149", "banner_url": "https://pbs.twimg.com/profile_banners/9505092/1774556131", "avatar_url": "https://pbs.twimg.com/profile_images/2037262183751704577/54AiU968_200x200.jpg", "joined": "Wed Oct 17 19:03:34 +0000 2007", "protected": false, "website": {"url": "http://cleancoder.com", "display_url": "cleancoder.com"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "type": "profile"}, "replies": 5, "reposts": 3, "likes": 70, "bookmarks": 81, "quotes": 0, "embed_card": "tweet", "created_at": "Tue Mar 17 00:22:51 +0000 2026", "created_timestamp": 1773706971, "possibly_sensitive": false, "views": 10445, "is_note_tweet": false, "community_note": null, "lang": "en", "replying_to": null, "media": {}, "source": "Twitter Web App", "card": {"url": "http://cleancoders.com", "title": "Clean Coders : Level up your code.", "description": "Improve your skills with our training videos, or hire our experts to build your product.", "domain": "cleancoders.com", "image": {"width": 152, "height": 152, "url": "https://pbs.twimg.com/card_img/2103965202119294976/-Hjh1COP?format=png&name=280x280