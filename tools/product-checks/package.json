{
  "name": "@omne-harness/product-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "本仓库的产品规则：契约与节点 verification 点名的结构检查、仓库路径规则与验收覆盖",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "omne-product-checks": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false",
    "scan": "node --conditions=source --experimental-strip-types src/cli.ts ../../packages ../../apps",
    "retire": "node --conditions=source --experimental-strip-types src/retire/cli.ts"
  },
  "devDependencies": {
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/repo-toolchain": "catalog:",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
