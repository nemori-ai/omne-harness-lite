{
  "name": "@omne-harness-lite/ts-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "产品源码的结构检查：契约与节点 verification 点名的静态检查规则，每条规则带「故意违反就失败」自测",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "omne-ts-checks": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "scan": "node --experimental-strip-types src/cli.ts ../../packages ../../apps"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
