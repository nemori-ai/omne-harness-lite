{
  "format": 1,
  "id": "package-domain",
  "version": "1.0.0",
  "common": [
    {
      "source": "common/README.md.tpl",
      "target": "README.md"
    },
    {
      "source": "common/documentation.json.tpl",
      "target": "documentation.json"
    }
  ],
  "requiredFiles": [
    "README.md",
    "documentation.json"
  ],
  "layout": {
    "files": [
      "README.md",
      "README_ZH.md",
      "AGENTS.md",
      "CLAUDE.md",
      "documentation.json",
      "docs/**/*.md",
      "docs/**/*.svg",
      "docs/**/*.png",
      "docs/**/*.webp"
    ],
    "requiredDirectories": [],
    "ignoredDirectories": [],
    "companions": [],
    "requiredFileGroups": []
  }
}
