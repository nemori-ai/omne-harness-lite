  "memberBudget": {
    "excludeGroups": ["examples"],
    "baseline": true,
    "overAlert": {
      "warn": 8,
      "act": 14,
      "release": 6
    },
    "risk": {
      "warn": 20,
      "act": 23,
      "release": 18
    },
    "duplication": {
      "warn": 5,
      "act": 10,
      "release": 4
    },
    "testsWithoutAssertions": {
      "warn": 3,
      "act": 8,
      "release": 2
    }
  },
  "sensors": {
    "stability": {
      "enabled": true,
      "margin": 0.2
    },
    "cochange": {
      "enabled": true,
      "window": 300,
      "maxMembersPerCommit": 8,
      "minTogether": 4,
      "minRatio": 0.6
    },
    "duplication": {
      "enabled": true,
      "minTokens": 50,
      "minLines": 5
    },
    "assertions": {
      "enabled": true,
      "assertionPattern": "^(expect|assert|expectTypeOf|assertType)",
      "helperPattern": "",
      "typeTestPattern": "\\.(test|spec)-d\\.[cm]?[jt]sx?$"
    },
    "newEdges": {
      "enabled": true
    },
    "topicChurn": {
      "enabled": true,
      "productRoot": ".meta_harness/design/product",
      "windowDays": 14
    },
    "worktrees": {
      "enabled": true
    },
    "acceptance": {
      "enabled": true
    },
    "catalogue": {
      "path": "docs/clean-loop.md",
      "doctrinePath": "tools/ts-checks/resources/clean-loop-entries.md"
    },
    "architecture": {
      "enabled": true
    }
  },
  "health": {
    "commits": 50,
    "runs": 10
  },
  "hook": {
    "enabled": true,
    "maxItems": 12,
    "maxChars": 4000,
    "timeoutSeconds": 40,
    "stateLimit": 200
  }
}
