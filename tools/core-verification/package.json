{
  "name": "@omne-harness/core-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "核心包的跨边界开发验证与一致性套件有效性自测",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "verify:packed": "node dist/w6-packed-consumer.js"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "kysely": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
