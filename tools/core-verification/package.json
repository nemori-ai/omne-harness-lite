    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/kernel-basis": "workspace:*",
    "@omne-harness-lite/loop-extension": "workspace:*",
    "@omne-harness-lite/mcp-endpoint": "workspace:*",
    "@omne-harness-lite/messages": "workspace:*",
    "@omne-harness-lite/model-profile": "workspace:*",
    "@omne-harness-lite/model-response": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "@omne-harness-lite/skill-package": "workspace:*",
    "@omne-harness-lite/slash-command": "workspace:*",
