{
  "name": "@omne-harness/repo-toolchain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "产品源码的结构检查：契约与节点 verification 点名的静态检查规则，每条规则带「故意违反就失败」自测",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "omne-ts-checks": "./dist/cli.js",
    "omne-architecture": "./dist/arch/cli.js",
    "omne-package-template": "./dist/package-template/cli.js",
    "omne-delivery": "./dist/delivery/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./architecture": {
      "types": "./dist/arch/actual.d.ts",
      "import": "./dist/arch/actual.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "scan": "node --experimental-strip-types src/cli.ts ../../packages ../../apps",
    "metrics": "node --experimental-strip-types src/metrics/cli.ts",
    "architecture": "node --experimental-strip-types src/arch/cli.ts",
    "package:template": "node --experimental-strip-types src/package-template/cli.ts",
    "delivery": "node --experimental-strip-types src/delivery/cli.ts"
  },
  "devDependencies": {
    "@jscpd/core": "catalog:",
    "@jscpd/tokenizer": "catalog:",
    "@omne-harness/legal-identity": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@xyflow/react": "catalog:",
    "antd": "catalog:",
    "dependency-cruiser": "catalog:",
    "elkjs": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
