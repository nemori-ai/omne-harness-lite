{
  "name": "@omne-harness/repo-config",
  "version": "0.0.0",
  "private": true,
  "description": "仓库共享的 tsconfig、oxlint 与 dependency-cruiser 配置预设；根配置只用 extends 引用它",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./oxlint.json": "./oxlint.json",
    "./dependency-cruiser.cjs": "./dependency-cruiser.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "tsconfig.base.json",
    "oxlint.json",
    "dependency-cruiser.cjs"
  ]
}
