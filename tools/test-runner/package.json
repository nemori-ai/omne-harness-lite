{
  "name": "@omne-harness/test-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "测试运行器：影响面计划、逐成员测试、耗时账本与变异测试；turbo 接替后删除",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@omne-harness/repo-toolchain": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
