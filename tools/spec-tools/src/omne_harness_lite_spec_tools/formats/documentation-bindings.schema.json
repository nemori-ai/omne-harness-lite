{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation bindings v2: inventory scope",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "documentation-bindings"
    },
    "owner": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "project",
            "domain",
            "member"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "source"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "entry",
              "requirement",
              "standard",
              "architecture",
              "contract",
              "rationale",
              "guide",
              "reference",
              "agent-instruction",
              "method",
              "verification",
              "research",
              "projection"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "visibility": {
            "enum": [
              "public",
              "internal",
              "private"
            ]
          },
          "basis": {
            "enum": [
              "adopted",
              "candidate",
              "unknown"
            ]
          },
          "applicability": {
            "enum": [
              "applicable",
              "unknown",
              "not-applicable"
            ]
          },
          "expectationSource": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "inspectionProfile": {
            "type": "string",
            "minLength": 1
          },
          "requiredSections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "anchor": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "anchor"
              ],
              "additionalProperties": false
            }
          },
          "gapAllowanceSource": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "required",
          "visibility",
          "basis",
          "applicability",
          "expectationSource",
          "inspectionProfile",
          "requiredSections"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "owner",
    "documents"
  ],
  "additionalProperties": false
}
