{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/tools/requirement.schema.json",
  "$defs": {
    "dimension": {"enum": ["environment", "user", "agent"]}
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ids"],
      "properties": {
        "kind": {"const": "system-requirement"},
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SYS-[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "primary_dimension", "secondary_dimensions"],
      "properties": {
        "kind": {"const": "product-feature"},
        "id": {"type": "string", "pattern": "^PF-[0-9]{3,}$"},
        "primary_dimension": {"$ref": "#/$defs/dimension"},
        "secondary_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dimension"}
        }
      }
    }
  ]
}
