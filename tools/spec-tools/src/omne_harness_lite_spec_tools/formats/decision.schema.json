{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/tools/decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "status",
    "scope",
    "date",
    "sources",
    "acceptance",
    "supersedes"
  ],
  "properties": {
    "kind": {
      "const": "decision"
    },
    "id": {
      "type": "string",
      "pattern": "^D-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "accepted",
        "superseded",
        "withdrawn"
      ]
    },
    "scope": {
      "type": "string",
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "acceptance": {
      "type": "string",
      "pattern": "\\S"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[0-9]{3,}$"
          },
          "scope": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "change_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation",
        "causal_explanation",
        "reproduction",
        "verification"
      ],
      "properties": {
        "observation": {
          "type": "string",
          "pattern": "\\S"
        },
        "causal_explanation": {
          "type": "string",
          "pattern": "\\S"
        },
        "reproduction": {
          "type": "string",
          "pattern": "\\S"
        },
        "verification": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "supersedes": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "change_basis"
        ]
      }
    }
  ]
}
