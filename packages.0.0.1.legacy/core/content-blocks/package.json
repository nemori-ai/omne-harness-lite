{
  "name": "@omne-harness-lite/content-blocks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.content-blocks v3 的纯模块：内容块、表示校验与严格无损 JSON",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/content-blocks.schema.json",
    "./schema-runtime": {
      "types": "./dist/schema-runtime.d.ts",
      "import": "./dist/schema-runtime.js"
    },
    "./schema/v2": "./schema/content-blocks.v2.schema.json",
    "./code-runtime": {
      "types": "./dist/code-runtime.d.ts",
      "import": "./dist/code-runtime.js",
      "require": "./dist/code-runtime.js"
    },
    "./schema-codegen": {
      "types": "./dist/schema-codegen.d.ts",
      "import": "./dist/schema-codegen.js",
      "require": "./dist/schema-codegen.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "generated",
    "SPEC.md",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/identity-values": "workspace:*",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "module"
    }
  }
}
