{
  "name": "@omne-harness-lite/messages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "data.messages v9 \u7684\u5f53\u524d\u6d88\u606f\u3001ACK \u8bb0\u5f55\u4e0e\u65e0\u635f\u8bed\u4e49\u6458\u8981\u5224\u5b9a",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/messages.schema.json",
    "./schema/v2": "./schema/messages.v2.schema.json",
    "./schema/v3": "./schema/v3/messages.schema.json",
    "./schema/v6": "./schema/v6/messages.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "README_ZH.md",
    "SPEC.md",
    "generated",
    "models"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omne-harness-lite/content-blocks": "workspace:*",
    "@omne-harness-lite/call-accounts": "workspace:*",
    "@omne-harness-lite/model-profile": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "@omne-harness-lite/tool-definition": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "omneHarness": {
    "packageTemplate": {
      "id": "typescript-package",
      "version": "1.0.0",
      "variant": "module"
    }
  }
}
