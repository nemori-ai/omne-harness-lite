      "name": "lookup_code",
      "description": "Look up the codeword for one query.",
      "parameters": {
        "type": "object",
        "properties": { "query": { "type": "string", "description": "The exact query." } },
        "required": ["query"],
        "additionalProperties": false
      }
    }
  },
