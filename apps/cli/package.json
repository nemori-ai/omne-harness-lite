{
  "name": "@omne-harness-lite/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "D049 governance CLI file-input increment",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "omne": "./dist/main.js"
  },
  "files": [
    "dist",
    "commands",
    "forms"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "catalog:",
    "@omne-harness-lite/client-local-state": "workspace:*",
    "@omne-harness-lite/governance-client-operations": "workspace:*",
    "@omne-harness-lite/governance-center-client": "workspace:*",
    "@omne-harness-lite/identity-values": "workspace:*",
    "@omne-harness-lite/offer-expiry": "workspace:*",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@omne-harness-lite/artifact-builder": "workspace:*"
  }
}
