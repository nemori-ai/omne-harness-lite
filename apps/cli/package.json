{
  "name": "@omne-harness/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal omne process entry: help, version, and state directory resolution",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "omne": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/write-identity.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/assets-protocol": "workspace:*",
    "@omne-harness/calendar-protocol": "workspace:*",
    "@omne-harness/human-intervention-protocol": "workspace:*",
    "@omne-harness/identity-protocol": "workspace:*",
    "@omne-harness/public-contract": "workspace:*",
    "@omne-harness/sdk": "workspace:*",
    "@omne-harness/session-diagnostics-protocol": "workspace:*",
    "@omne-harness/session-protocol": "workspace:*",
    "@omne-harness/tool-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
