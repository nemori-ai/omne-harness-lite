{
  "name": "@omne-harness/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal omne process entry: help, version, and state directory resolution",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "omne": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/write-identity.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
