{
  "name": "@omne-harness/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The desktop app: the page (shell, login, client tree) and its local host process that holds the login",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "omne-desktop-host": "./dist/standalone/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist/forwarding dist/port-fetch dist/shared dist/standalone && tsc -p tsconfig.build.json && node scripts/build.ts",
    "build:test": "node scripts/build.ts test",
    "dev": "node scripts/dev.ts",
    "start": "node scripts/start.ts",
    "start:test": "node scripts/start-test.ts",
    "package": "electron-builder --dir --config electron-builder.release.mjs --publish never",
    "package:test": "electron-builder --dir --config electron-builder.test.mjs --publish never",
    "dist": "electron-builder --config electron-builder.release.mjs --publish never",
    "verify:build": "node scripts/verify-build.ts",
    "verify:release": "node scripts/verify-release.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/assets-protocol": "workspace:*",
    "@omne-harness/assets-ui": "workspace:*",
    "@omne-harness/calendar-protocol": "workspace:*",
    "@omne-harness/calendar-ui": "workspace:*",
    "@omne-harness/canvas-protocol": "workspace:*",
    "@omne-harness/canvas-ui": "workspace:*",
    "@omne-harness/client-assembly": "workspace:*",
    "@omne-harness/dynamis": "workspace:*",
    "@omne-harness/dynamis-cordis": "workspace:*",
    "@omne-harness/human-intervention-protocol": "workspace:*",
    "@omne-harness/human-intervention-ui": "workspace:*",
    "@omne-harness/identity-protocol": "workspace:*",
    "@omne-harness/identity-ui": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/mcp-protocol": "workspace:*",
    "@omne-harness/mcp-ui": "workspace:*",
    "@omne-harness/media-protocol": "workspace:*",
    "@omne-harness/media-ui": "workspace:*",
    "@omne-harness/model-protocol": "workspace:*",
    "@omne-harness/model-ui": "workspace:*",
    "@omne-harness/notification-protocol": "workspace:*",
    "@omne-harness/notification-ui": "workspace:*",
    "@omne-harness/plugin-protocol": "workspace:*",
    "@omne-harness/plugin-ui": "workspace:*",
    "@omne-harness/public-contract": "workspace:*",
    "@omne-harness/retry": "workspace:*",
    "@omne-harness/schedule-protocol": "workspace:*",
    "@omne-harness/schedule-ui": "workspace:*",
    "@omne-harness/screen": "workspace:*",
    "@omne-harness/sdk": "workspace:*",
    "@omne-harness/session-diagnostics-protocol": "workspace:*",
    "@omne-harness/session-protocol": "workspace:*",
    "@omne-harness/session-ui": "workspace:*",
    "@omne-harness/shell-contract": "workspace:*",
    "@omne-harness/tool-protocol": "workspace:*",
    "@omne-harness/tool-ui": "workspace:*",
    "@omne-harness/ui-kit": "workspace:*",
    "@omne-harness/usage-protocol": "workspace:*",
    "@omne-harness/usage-ui": "workspace:*",
    "@omne-harness/workspace-protocol": "workspace:*",
    "@omne-harness/workspace-ui": "workspace:*",
    "eventsource-parser": "catalog:",
    "hono": "catalog:",
    "node-screenshots": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@electron/fuses": "catalog:",
    "@omne-harness/utc-instant": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
