{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/shared/**/*.ts",
    "src/forwarding/**/*.ts",
    "src/standalone/**/*.ts",
    "src/port-fetch/**/*.ts"
  ]
}
