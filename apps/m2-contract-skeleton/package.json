{
  "name": "@omne-harness/m2-contract-skeleton",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private M1 G1 verification app: connects the M2 first tenant path over public contract exports and their testing doubles, and reports each hop as verified or a named gap",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false"
  },
  "dependencies": {
    "@omne-harness/agent": "workspace:*",
    "@omne-harness/agent-contract": "workspace:*",
    "@omne-harness/content-block": "workspace:*",
    "@omne-harness/identity": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/message": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/public-contract": "workspace:*",
    "@omne-harness/request-context-contract": "workspace:*",
    "@omne-harness/session-contract": "workspace:*",
    "@omne-harness/utc-instant": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
