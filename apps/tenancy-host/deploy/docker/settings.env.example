# Copy to a private 0600 file owned by the host operator. Replace every required value.
# This file is read in Docker Compose raw env_file format; do not source it as shell code.
OMNE_TENANCY_UNACTIVATED_RETENTION=<required-duration>
OMNE_TENANCY_INVITATION_TTL_DEFAULT=<required-duration>
OMNE_TENANCY_AFFILIATION_REQUEST_TTL_DEFAULT=<required-duration>
OMNE_TENANCY_COPY_NOTICE_TTL_DEFAULT=<required-duration>
OMNE_TENANCY_SHARING_INVITATION_TTL_DEFAULT=<required-duration>
OMNE_TENANCY_TEAM_CREATION_KEY_RETENTION=<required-duration>
OMNE_TENANCY_CLOCK_READY_TIMEOUT=<required-positive-milliseconds>
# OMNE_TENANCY_CREDENTIAL_POLICY=<optional-policy-json>
