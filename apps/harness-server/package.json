    "@omne-harness/settings": "workspace:*",
    "@omne-harness/settings-local": "workspace:*"
  },
  "devDependencies": {
    "@omne-harness/cli": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
