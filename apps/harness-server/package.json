{
  "name": "@omne-harness/harness-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Harness server application assembly: S0 skeleton, the real serve mode and the local single-user setup",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "harness-server": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis": {
      "source": "./src/cordis.ts",
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    }
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:fast": "vitest run --mode fast",
    "test:slow": "vitest run --mode slow --typecheck.enabled=false",
    "check:aa-rows": "node scripts/aa-rows.mjs check --aa ../../docs/architecture/runtime/application-assembly.md --rows src/s0/aa-rows.json",
    "check:tool-release": "node scripts/tool-release.mjs check"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@omne-harness/agent": "workspace:*",
    "@omne-harness/agent-context": "workspace:*",
    "@omne-harness/agent-contract": "workspace:*",
    "@omne-harness/agent-cordis-contract": "workspace:*",
    "@omne-harness/agent-host-local": "workspace:*",
    "@omne-harness/assets": "workspace:*",
    "@omne-harness/authorization": "workspace:*",
    "@omne-harness/exchange-refs": "workspace:*",
    "@omne-harness/execution-environment": "workspace:*",
    "@omne-harness/execution-environment-contract": "workspace:*",
    "@omne-harness/execution-environment-cordis-contract": "workspace:*",
    "@omne-harness/execution-environment-host-local": "workspace:*",
    "@omne-harness/identity": "workspace:*",
    "@omne-harness/identity-sql": "workspace:*",
    "@omne-harness/json-text": "workspace:*",
    "@omne-harness/kernel-basis": "workspace:*",
    "@omne-harness/legal-identity": "workspace:*",
    "@omne-harness/model": "workspace:*",
    "@omne-harness/model-contract": "workspace:*",
    "@omne-harness/model-cordis-contract": "workspace:*",
    "@omne-harness/model-host-local": "workspace:*",
    "@omne-harness/model-storage-sql": "workspace:*",
    "@omne-harness/operation-result": "workspace:*",
    "@omne-harness/pi-ai-openai": "workspace:*",
    "@omne-harness/pi-ai-transport": "workspace:*",
    "@omne-harness/public-contract": "workspace:*",
    "@omne-harness/request-context": "workspace:*",
    "@omne-harness/request-context-contract": "workspace:*",
    "@omne-harness/request-context-cordis": "workspace:*",
    "@omne-harness/request-context-cordis-contract": "workspace:*",
    "@omne-harness/runtime-context": "workspace:*",
    "@omne-harness/runtime-context-contract": "workspace:*",
    "@omne-harness/runtime-context-cordis": "workspace:*",
    "@omne-harness/runtime-context-cordis-contract": "workspace:*",
    "@omne-harness/schema-provider": "workspace:*",
    "@omne-harness/server-entry": "workspace:*",
    "@omne-harness/session": "workspace:*",
    "@omne-harness/session-adapters": "workspace:*",
    "@omne-harness/session-contract": "workspace:*",
    "@omne-harness/session-cordis": "workspace:*",
    "@omne-harness/session-cordis-contract": "workspace:*",
