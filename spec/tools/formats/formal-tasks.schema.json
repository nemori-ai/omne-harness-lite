{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omne-harness-lite.invalid/tools/formal-tasks.schema.json",
  "type": "object", "additionalProperties": false, "required": ["format", "tasks"],
  "properties": {"format": {"const": 1}, "tasks": {"type": "array", "items": {"type": "object", "additionalProperties": false,
    "required": ["id", "kind", "artifacts", "command"], "properties": {
      "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["tla", "alloy"]},
      "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }}}}
}
