{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omne:example:model-invocation-minimal-demo:tool-driver:1",
  "$defs": {
    "Origin": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {},
        "assistantMessage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run",
        "attempt",
        "assistantMessage"
      ],
      "additionalProperties": false
    },
    "AdoptedTool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "definition": {}
      },
      "required": [
        "name",
        "capability",
        "asset",
        "version",
        "definition"
      ],
      "additionalProperties": false
    },
    "ContextValue": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "observedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "revision",
        "value",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "Gate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "available"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "missing"
            },
            "reason": {
              "enum": [
                "chain",
                "contribution"
              ]
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Decision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "allow"
            },
            "conclusion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "conclusion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "denied"
            },
            "reason": {},
            "conclusion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "reason",
            "conclusion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "notExecutable"
            },
            "reason": {
              "enum": [
                "unparseable",
                "no_such_entry"
              ]
            },
            "conclusion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FinalAction": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "minLength": 1
        },
        "effectiveCall": {},
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "conclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        }
      },
      "required": [
        "callId",
        "effectiveCall",
        "conclusions",
        "decision"
      ],
      "additionalProperties": false
    },
    "Completion": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "$ref": "#/$defs/Gate"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/FinalAction"
          }
        }
      },
      "required": [
        "key",
        "gate",
        "items"
      ],
      "additionalProperties": false
    },
    "Piece": {
      "type": "object",
      "properties": {
        "definition": {},
        "power": {
          "enum": [
            "observe",
            "rewrite",
            "veto"
          ]
        },
        "onError": {
          "enum": [
            "ignore",
            "record",
            "treat_as_veto"
          ]
        },
        "fallback": {
          "enum": [
            "modality",
            "retry",
            "admission",
            "loop",
            "offload"
          ]
        }
      },
      "required": [
        "definition",
        "power"
      ],
      "additionalProperties": false
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "run_started"
            },
            "run": {
              "type": "string",
              "minLength": 1
            },
            "inboundKey": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "run",
            "inboundKey",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "attempt_adopted"
            },
            "run": {
              "type": "string",
              "minLength": 1
            },
            "attempt": {},
            "adoption": {
              "type": "string",
              "minLength": 1
            },
            "report": {},
            "tools": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AdoptedTool"
              }
            },
            "context": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ContextValue"
              }
            },
            "startedMessageKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "run",
            "attempt",
            "adoption",
            "report",
            "tools",
            "context",
            "startedMessageKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "actions_completed"
            },
            "origin": {
              "$ref": "#/$defs/Origin"
            },
            "adoption": {
              "type": "string",
              "minLength": 1
            },
            "chain": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Piece"
              }
            },
            "completion": {
              "$ref": "#/$defs/Completion"
            }
          },
          "required": [
            "kind",
            "origin",
            "adoption",
            "chain",
            "completion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "action_denial_intended"
            },
            "origin": {
              "$ref": "#/$defs/Origin"
            },
            "adoption": {
              "type": "string",
              "minLength": 1
            },
            "call": {},
            "reason": {}
          },
          "required": [
            "kind",
            "origin",
            "adoption",
            "call",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "action_denied"
            },
            "origin": {
              "$ref": "#/$defs/Origin"
            },
            "callId": {
              "type": "string",
              "minLength": 1
            },
            "reason": {},
            "message": {}
          },
          "required": [
            "kind",
            "origin",
            "callId",
            "reason",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "continuation_requested"
            },
            "origin": {
              "$ref": "#/$defs/Origin"
            },
            "requestKey": {
              "type": "string",
              "minLength": 1
            },
            "batch": {
              "type": "object",
              "properties": {
                "pass": {
                  "type": "string",
                  "minLength": 1
                },
                "chain": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Piece"
                  }
                },
                "conclusions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "pass",
                "chain",
                "conclusions"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "origin",
            "requestKey",
            "batch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "run_ended"
            },
            "run": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "enum": [
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "basis": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "run",
            "reason",
            "basis",
            "at"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Payload": {
      "type": "object",
      "properties": {
        "format": {
          "const": "tool-driver/1"
        },
        "category": {
          "const": "driver"
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "format",
        "category",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
