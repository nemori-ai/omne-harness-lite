  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive durable multi-turn streaming model invocation example",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tool-driver-schema": "./schema/tool-driver.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md",
    "schema",
    "generated",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-fixed-schemas.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
